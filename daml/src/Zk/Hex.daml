-- The external call carries text as hex: the request and the response bodies are the hex of the ASCII line,
-- lowercase, with no newline at either end (README.md: "What the sidecar answers"). Both forms of Zk.Sidecar use these.
module Zk.Hex where

import qualified DA.Crypto.Text as C
import qualified DA.Text as T

hexDigits : [Text]
hexDigits = T.explode "0123456789abcdef"

-- Two lowercase hex digits for each byte of the text. The lines are ASCII. This is the builtin: a hand-written version walks the
-- text one character at a time and was most of the time Advance took per kilobyte of block (the test checks the two agree).
toHex : Text -> Text
toHex = C.toHex

-- The line a hex body spells; "" if the body is not whole bytes of hex, which no valid answer is.
fromHex : Text -> Text
fromHex s = case pairs (T.explode s) of
  Some cs -> T.fromCodePoints cs
  None -> ""

pairs : [Text] -> Optional [Int]
pairs [] = Some []
pairs (a :: b :: rest) = do
  hi <- digit a
  lo <- digit b
  tail <- pairs rest
  pure ((hi * 16 + lo) :: tail)
pairs _ = None

digit : Text -> Optional Int
digit d = lookup d (zip hexDigits [0 .. 15])

-- The length of a field in characters, written as 10 decimal digits: the prefix `verify2` reads in front of each of the proof and
-- the header. Decimal digits are hex digits, so a line made of these and hex fields is still a hex string.
lengthField : Text -> Text
lengthField s = mconcat (replicate (10 - T.length n) "0") <> n
  where n = show (T.length s)

-- The line `verify2` takes: the SHA-256 of the rest as 64 lowercase hex digits, then the proof and the header, each behind its
-- length, then the transactions. The hash is of the text as Daml holds it. The runtime lowercases the text it sends, so a capital
-- letter kept in a field here would reach the sidecar as a small one and pass; with the hash it makes the line refused instead.
verify2Line : Text -> Text -> Text -> Text
verify2Line proofHex headerHex txsHex = T.sha256 body <> body
  where body = lengthField proofHex <> proofHex <> lengthField headerHex <> headerHex <> txsHex
