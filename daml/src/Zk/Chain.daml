-- One EVM chain on Canton. A block is one Canton transaction: `ZkChain.Advance` has the sidecar check the block's
-- proof, checks that the block follows the chain's head, checks with the sidecar that the legs attached are exactly the
-- ones the block recorded in the gateway contract's state, settles them, and moves the head on. Daml does no proof checking
-- and no hashing of blocks; it compares the strings the sidecar answers (README.md). The only hashes it takes name things and
-- prove nothing: the payment id of a pair of parties (`paymentId`), the payment id of a venue's trade (`venueTradeId`), the id of the
-- claim that trade makes (`venueClaimId`), the id of a lock (`lockId`) and the id of a vault's release (`releaseId`).
module Zk.Chain where

import DA.Date (date, Month(Jan))
import DA.Foldable (forA_)
import DA.List (dedup, last)
import DA.Optional (fromOptional, isSome)
import DA.Time (RelTime, addRelTime, subTime, time, days, hours, seconds, convertRelTimeToMicroseconds, convertMicrosecondsToRelTime)
import qualified DA.Text as T
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1 (Holding, InstrumentId)
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.TransferInstructionV1
import qualified Twin.Amount as TA
import qualified Twin.Twin as TW
import Zk.Hex
import Zk.Sidecar

isHex : Text -> Bool
isHex s = all (`elem` T.explode "0123456789abcdef") (T.explode s)

hexField : Text -> Bool
hexField s = s /= "" && isHex s

-- Exactly `n` lowercase hex digits: the form of an EVM address (40) and of an id or an amount (64).
hexOfLength : Int -> Text -> Bool
hexOfLength n s = T.length s == n && isHex s

-- What `verify` answered for a block (README.md: "verify").
data Verified = Verified with
    programVK : Text
    rootC : Text
    blockHash : Text
    parentHash : Text
    number : Int
    stateRoot : Text
    timestamp : Int
    gasLimit : Int
    gasUsed : Int
    txCount : Int
  deriving (Eq, Show)

-- `ok` and ten fields, or `no` and a reason. Anything else is refused too.
parseVerify : Text -> Either Text Verified
parseVerify line = case T.splitOn " " line of
  ["ok", programVK, rootC, blockHash, parentHash, n, stateRoot, ts, gl, gu, tc]
    | Some [number, timestamp, gasLimit, gasUsed, txCount] <- mapA T.parseInt [n, ts, gl, gu, tc] ->
        Right Verified with ..
  _ -> Left line

-- A leg is a Daml action that the block's EVM transactions asked for, which the gateway contract recorded in its state.
-- A deposit locks a Canton token with the gateway, a withdrawal releases one from its custody, and a payment settles
-- the allocation named in a set of terms. Daml builds the sidecar's line of a deposit and of a payment from the
-- contracts the leg names. No Canton contract holds a withdrawal's id, burner or amount, so the builder sends those three
-- as text. The proven hash binds them, with all the rest, to what the block recorded.
data Leg
  = DepositLeg with
      request : ContractId DepositRequest
      token : ContractId GatewayToken
  | WithdrawalLeg with
      id : Text
      token : ContractId GatewayToken
      from : Text
      amount : Decimal
      acceptance : ContractId WithdrawalAcceptance
      inputs : [ContractId Holding]
  | PaymentLeg with
      terms : ContractId DvpTerms
  -- From package 0.4.0, at the end so that 0.3.0 contracts upgrade. A payment that settles a venue's trade, and the claim that
  -- the trade's settlement made, which the EVM side redeems as a deposit would be.
  | TradeLeg with
      tradeCid : ContractId VenueTrade
  | ClaimLeg with
      claimCid : ContractId FundedClaim
      tokenCid : ContractId GatewayToken
  -- From package 0.5.0, at the end again. The Canton twin of an ERC-20 (the `ostia-twin` package): a lock is a payment of the ERC-20
  -- into a registered vault, which mints the twin to `lockReceiver`; a release is a payment out of a vault, which burns the twin of a
  -- `RedeemRequest`. Both are payments of a gateway (the first or a registered one), written as `payment` lines.
  -- The lock's id is `lockId lockReceiver lockRef`, so the leg carries the id's parts and the line is made from them; the amount is the
  -- ERC-20 amount in base units, as 64 hex digits (the twin's amount is that, exactly, at 10 decimals). `lockRules` names the twin.
  | LockLeg with
      lockRules : ContractId TW.TwinRules
      lockReceiver : Party
      lockRef : Text
      lockVault : Text
      lockAmount : Text
  -- The release's id is `releaseId releaseVault ref` of the request, the id that the vault makes (gateway/Vault.sol); its token, payee and
  -- amount are the request's.
  | ReleaseLeg with
      releaseRequest : ContractId RedeemRequest
      releaseRules : ContractId TW.TwinRules
      releaseVault : Text
  deriving (Eq, Show)

noExtraArgs : ExtraArgs
noExtraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

template ChainProposal
  with
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
    reader : Party
    chainId : Int
    genesisHash : Text
    genesisStateRoot : Text
    programVK : Text
    rootC : Text
    rulesHash : Text
    gasCap : Int
    gatewayAddress : Text
  where
    signatory operator, gateway
    observer confirmer
    ensure chainId > 0 && gasCap > 0 && all hexField [genesisHash, genesisStateRoot, programVK, rootC, rulesHash]
      && hexOfLength 40 gatewayAddress

    -- The pins are this contract's own fields. The confirmer is expected to compare them with its own sidecar and build before it accepts,
    -- and to check that the genesis it accepts holds the gateway contract's code at `gatewayAddress`.
    -- On the one-machine network, up.sh starts the sidecars with the same values it proposes, and propose.py accepts at once.
    choice Accept : ContractId ZkChain
      controller confirmer
      do
        create ZkChain with
          headNumber = 0; headHash = genesisHash; headStateRoot = genesisStateRoot; changeDelay = None
          pauseMax = None; pausedUntil = None; pauseCooldownUntil = None; pauseStartedAt = None; withdrawalQuota = None; quotaWindow = None; withdrawn = None
          contracts = None; twins = None; ..

-- The chain's one state contract. Every block consumes it, so Canton alone decides which block comes next.
-- The gateway is the party that holds the Canton tokens locked for the EVM tokens that stand for them.
template ZkChain
  with
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
    reader : Party
    chainId : Int
    programVK : Text
    rootC : Text
    rulesHash : Text
    gasCap : Int
    gatewayAddress : Text
    headNumber : Int
    headHash : Text
    headStateRoot : Text
    -- How long a gas-cap or program change waits after it is proposed before the confirmer may accept it. `None` is no wait.
    -- Last in the record, so a chain made under an earlier version of this package still upgrades; see `ChangeDelayProposal`.
    changeDelay : Optional RelTime
    -- The limits on the legs (see `PauseLegs` and `SetLegLimits`). All of them are optional and come after `changeDelay`, so a chain made
    -- under an earlier version of this package still upgrades, and `None` keeps that version's behaviour: no pause is in force, no quota
    -- is set, and a pause may last at most `defaultPauseMax`.
    -- The longest a pause may run from the moment it is made; `None` is `defaultPauseMax`.
    pauseMax : Optional RelTime
    -- The legs are paused while the ledger time is before this time.
    pausedUntil : Optional Time
    -- The confirmer alone may start a pause only from this time on; the operator and the confirmer together are not held to it.
    pauseCooldownUntil : Optional Time
    -- When the pause that is running (or ran last) began. A lifted or ended pause leaves a cooldown as long as the whole pause ran, renewals
    -- included, counted from the moment it ends (at most `pauseMax` for a pause that the confirmer made alone), so a false alarm lifted after
    -- five minutes does not lock the confirmer's brake out for days.
    pauseStartedAt : Optional Time
    -- At most this many units of each Canton instrument (admin and id) may be withdrawn in any `quotaWindow`; `None` is no quota.
    withdrawalQuota : Optional Decimal
    quotaWindow : Optional RelTime
    -- The withdrawals that still count against the quota; see `Tally`.
    withdrawn : Optional [Tally]
    -- The registry of EVM contracts the chain trusts besides the first gateway (see `RegisteredContract`). Last in the record and optional, so a
    -- chain made under 0.4.0 or earlier still upgrades; `None` is an empty registry, which behaves as 0.4.0 did.
    contracts : Optional [RegisteredContract]
    -- The Canton twins the chain trusts, each pinned with its rules and decimals (see `PinnedTwin`). Also last and optional, for the same reason;
    -- `None` is no twin, so no twin leg is accepted.
    twins : Optional [PinnedTwin]
  where
    signatory operator, confirmer, gateway
    observer builder

    -- The cap on a block's gas limit and gas used only goes up, by at most double each time, and never over `maxGasCap`.
    -- It cannot go down: Advance already holds every committed header to the cap, and the head's limit is not kept here.
    -- The operator and the confirmer decide it together; see `GasCapProposal` for how they do it from two users.
    choice SetGasCap : ContractId ZkChain
      with newCap : Int
      controller operator, confirmer
      do
        assertMsg "the new gas cap must be above the current one" (newCap > gasCap)
        assertMsg "the gas cap may at most double in one change" (newCap <= 2 * gasCap)
        assertMsg "the gas cap may not be over maxGasCap" (newCap <= maxGasCap)
        create this with gasCap = newCap

    -- The program, the ZisK release and the rules the chain accepts blocks under are replaced together, by the operator, the
    -- confirmer and the gateway together; see `ProgramProposal`. Advance refuses a block proven under any other pair of keys, and the same choice
    -- sets the old values back, so a change can be undone.
    choice SetProgram : ContractId ZkChain
      with
        newProgramVK : Text
        newRootC : Text
        newRulesHash : Text
      controller operator, confirmer, gateway
      do
        assertMsg "the new program key, ZisK root and rules hash must each be 64 lowercase hex digits" (all (hexOfLength 64) [newProgramVK, newRootC, newRulesHash])
        create this with programVK = newProgramVK; rootC = newRootC; rulesHash = newRulesHash

    -- One contract is added to the registry by the operator, the confirmer and the gateway together; see `ContractProposal`. An address is
    -- registered once, never the first gateway's own, and at most `maxContracts` are kept. There is no removal in this version.
    choice AddContract : ContractId ZkChain
      with entry : RegisteredContract
      controller operator, confirmer, gateway
      do
        assertMsg "the contract's address must be 40 lowercase hex digits and its code hash 64" (registeredOk entry)
        assertMsg "the contract is the chain's first gateway, which is not in the registry" (entry.contractAddress /= gatewayAddress)
        let known = fromOptional [] contracts
        assertMsg "the contract is registered already" (entry.contractAddress `notElem` map (.contractAddress) known)
        assertMsg ("the registry holds at most " <> show maxContracts <> " contracts") (length known < maxContracts)
        create this with contracts = Some (known ++ [entry])

    -- One twin is pinned by the operator, the confirmer and the gateway together; see `TwinProposal`. The rules must be the gateway's own, of
    -- the token and decimals the entry names; a token is pinned once, and at most `maxTwins` are kept. There is no removal in this version.
    choice AddTwin : ContractId ZkChain
      with entry : PinnedTwin
      controller operator, confirmer, gateway
      do
        assertMsg "the twin's token must be 40 lowercase hex digits" (pinnedOk entry)
        r <- fetch entry.twinRules
        checkTwin this r
        assertMsg "the rules are of another token than the entry's" (r.token == entry.twinToken)
        assertMsg "the rules have other decimals than the entry's" (r.decimals == entry.twinDecimals)
        let known = fromOptional [] twins
        assertMsg "the token is pinned already" (entry.twinToken `notElem` map (.twinToken) known)
        assertMsg ("the chain pins at most " <> show maxTwins <> " twins") (length known < maxTwins)
        create this with twins = Some (known ++ [entry])

    -- The wait that gas-cap and program changes sit out is replaced like the program is, and by a proposal that itself waited
    -- out the current wait; see `ChangeDelayProposal`.
    choice SetChangeDelay : ContractId ZkChain
      with newDelay : Optional RelTime
      controller operator, confirmer, gateway
      do
        assertMsg "the change delay must be between zero and maxChangeDelay" (delayInRange newDelay)
        create this with changeDelay = newDelay

    -- The brake. The confirmer alone can pause deposits, withdrawals and payments (every leg) for at most `pauseMax`, when it sees a
    -- forged or doubtful block or a report of a fault. Advance then refuses a block that carries a leg, and legs work again on their
    -- own at the expiry. The confirmer alone may start a pause again only as long after the last one ended (or was lifted) as that pause
    -- ran, so a lone confirmer cannot keep the legs paused for more than half the time; to keep them paused longer, the operator and the
    -- confirmer together renew it (`RenewPause`).
    choice PauseLegs : ContractId ZkChain
      controller confirmer
      do
        now <- getTime
        assertMsg "the legs are paused already" (not (pausedAt this now))
        assertMsg ("the confirmer alone may start a new pause from " <> optional "" show pauseCooldownUntil) (optional True (\t -> now >= t) pauseCooldownUntil)
        let expiry = addRelTime now (pauseLimit this)
        create this with pausedUntil = Some expiry; pauseStartedAt = Some now; pauseCooldownUntil = Some (coolingAfter now expiry)

    -- The confirmer lifts a pause early. The cooldown of `PauseLegs` then runs from now, for as long as the pause ran.
    choice UnpauseLegs : ContractId ZkChain
      controller confirmer
      do
        now <- getTime
        assertMsg "the legs are not paused" (pausedAt this now)
        create this with pausedUntil = None; pauseCooldownUntil = Some (coolingAfter (fromOptional now pauseStartedAt) now)

    -- The operator and the confirmer together pause the legs for `forHowLong` from now, or renew a pause that is running: the new
    -- expiry is `forHowLong` from now, which may be at most `pauseMax`. A pause therefore always ends, unless both keep renewing it.
    -- They decide it from two users; see `RenewPauseProposal`.
    choice RenewPause : ContractId ZkChain
      with forHowLong : RelTime
      controller operator, confirmer
      do
        now <- getTime
        assertMsg "a pause must last longer than zero" (convertRelTimeToMicroseconds forHowLong > 0)
        assertMsg ("a pause may last at most " <> show (convertRelTimeToMicroseconds (pauseLimit this) / 1000000) <> " s from now") (convertRelTimeToMicroseconds forHowLong <= convertRelTimeToMicroseconds (pauseLimit this))
        let expiry = addRelTime now forHowLong
        let began = if pausedAt this now then fromOptional now pauseStartedAt else now
        create this with pausedUntil = Some expiry; pauseStartedAt = Some began; pauseCooldownUntil = Some (coolingAfter began expiry)

    -- The withdrawal quota and the longest pause are replaced together by the operator and the confirmer, through a proposal that
    -- waited out the change delay; see `LegLimitsProposal`.
    choice SetLegLimits : ContractId ZkChain
      with
        newQuota : Optional Decimal
        newWindow : Optional RelTime
        newPauseMax : Optional RelTime
      controller operator, confirmer
      do
        assertMsg "the quota and its window are set together, or neither is" (isSome newQuota == isSome newWindow)
        assertMsg "the quota must be above zero" (optional True (> 0.0) newQuota)
        assertMsg "the quota window must be between one second and maxQuotaWindow" (optional True rangeOk newWindow)
        assertMsg "the longest pause must be between one second and maxPauseMax" (optional True (rangeOkTo maxPauseMax) newPauseMax)
        create this with withdrawalQuota = newQuota; quotaWindow = newWindow; pauseMax = newPauseMax

    -- The proposals are made here, not by creating them directly: the proposal records the ledger time it was made at, and
    -- the confirmer's and (for the program and the delay) the gateway's signature on it is given by this contract, so a proposer
    -- cannot create one with an earlier time. Nonconsuming, so a block can still be advanced meanwhile.
    nonconsuming choice ProposeGasCap : ContractId GasCapProposal
      with newCap : Int
      controller operator
      do
        now <- getTime
        create GasCapProposal with operator; confirmer; reader; chainId; newCap; proposedAt = now

    nonconsuming choice ProposeProgram : ContractId ProgramProposal
      with
        newProgramVK : Text
        newRootC : Text
        newRulesHash : Text
      controller operator, gateway
      do
        now <- getTime
        create ProgramProposal with operator; confirmer; gateway; reader; chainId; newProgramVK; newRootC; newRulesHash; proposedAt = now

    nonconsuming choice ProposeContract : ContractId ContractProposal
      with entry : RegisteredContract
      controller operator, gateway
      do
        now <- getTime
        create ContractProposal with operator; confirmer; gateway; reader; chainId; entry; proposedAt = now

    nonconsuming choice ProposeTwin : ContractId TwinProposal
      with entry : PinnedTwin
      controller operator, gateway
      do
        now <- getTime
        create TwinProposal with operator; confirmer; gateway; reader; chainId; entry; proposedAt = now

    nonconsuming choice ProposeChangeDelay : ContractId ChangeDelayProposal
      with newDelay : Optional RelTime
      controller operator, gateway
      do
        now <- getTime
        create ChangeDelayProposal with operator; confirmer; gateway; reader; chainId; newDelay; proposedAt = now

    nonconsuming choice ProposeLegLimits : ContractId LegLimitsProposal
      with
        newQuota : Optional Decimal
        newWindow : Optional RelTime
        newPauseMax : Optional RelTime
      controller operator
      do
        now <- getTime
        create LegLimitsProposal with operator; confirmer; reader; chainId; newQuota; newWindow; newPauseMax; proposedAt = now

    nonconsuming choice ProposeRenewPause : ContractId RenewPauseProposal
      with forHowLong : RelTime
      controller operator
      do
        now <- getTime
        create RenewPauseProposal with operator; confirmer; reader; chainId; forHowLong; proposedAt = now

    choice Advance : (ContractId ZkChain, ContractId BlockRecord)
      with
        headerHex : Text
        txsHex : Text
        proofHex : Text
        gatewayAccountNodes : [Text]
        gatewayStorageNodes : [Text]
        legs : [Leg]
        -- One entry per gateway in the registry (`contracts`), in any order, and none for the first gateway, whose proofs and legs are the
        -- arguments above. `None` is a chain whose registry holds no gateway.
        extraGateways : Optional [GatewayBlock]
      controller builder
      do
        now <- getTime
        -- While the legs are paused a block may still carry no leg, so the chain goes on; one that carries a leg waits for the expiry or
        -- the early unpause (the gateway contract on the EVM side has no pause of its own).
        let extras = fromOptional [] extraGateways
        let allLegs = legs ++ concatMap (.legs) extras
        assertMsg ("the legs are paused until " <> optional "" show pausedUntil <> ": a block that carries a leg is refused") (null allLegs || not (pausedAt this now))
        answer <- verifyBlockCall proofHex headerHex txsHex
        b <- either (\why -> abort ("the sidecar refused the block: " <> why)) pure (parseVerify answer)
        assertMsg "the block was proven by another program" (b.programVK == programVK)
        assertMsg "the block was proven by another ZisK release" (b.rootC == rootC)
        assertMsg "the block's parent is not the chain's head" (b.parentHash == headHash)
        assertMsg "the block's number is not the head's plus one" (b.number == headNumber + 1)
        assertMsg "the block is over the gas cap" (b.gasLimit <= gasCap && b.gasUsed <= gasCap)
        -- The legs the block needs are the ones the gateway recorded in the block's state, and no others. Daml writes the line
        -- of each attached leg from its own contracts, the sidecar hashes the lines as the gateway contract does and compares the
        -- result with the proven value. One call is made also for a block with no legs: it proves that the block needs none.
        legLines <- mapA (legLine this) legs
        checkTwinIdsDistinct legs
        legsAnswer <- legsCall (T.intercalate "," [b.stateRoot, show b.number, gatewayAddress,
          T.intercalate ";" gatewayAccountNodes, T.intercalate ";" gatewayStorageNodes, T.intercalate "|" legLines])
        assertMsg ("the legs are not the ones the block recorded: " <> legsAnswer)
          (legsAnswer == T.intercalate " " ["ok", b.stateRoot, show b.number, gatewayAddress, show (length legs)])
        -- The same for every gateway in the registry: the block must carry exactly one entry for each, and its account proof must be of the
        -- contract the registry names.
        checkRegisteredGateways this extras
        forA_ extras $ \g -> do
          gLines <- mapA (legLine this) g.legs
          checkTwinIdsDistinct g.legs
          gAnswer <- legsCall (T.intercalate "," [b.stateRoot, show b.number, g.address,
            T.intercalate ";" g.accountNodes, T.intercalate ";" g.storageNodes, T.intercalate "|" gLines])
          assertMsg ("the legs of the gateway " <> g.address <> " are not the ones the block recorded: " <> gAnswer)
            (gAnswer == T.intercalate " " ["ok", b.stateRoot, show b.number, g.address, show (length g.legs)])
        -- The withdrawals of the block, with those still counted from earlier blocks, may not be over the quota.
        tallies <- takeAgainstQuota this now allLegs
        forA_ allLegs settle
        record <- create BlockRecord with
          number = b.number; blockHash = b.blockHash; parentHash = b.parentHash; ..
        next <- create this with headNumber = b.number; headHash = b.blockHash; headStateRoot = b.stateRoot; withdrawn = tallies
        pure (next, record)

-- One twin pinned in the chain record (`ZkChain.twins`): the ERC-20 (40 lowercase hex digits), its decimals and the `TwinRules` contract that
-- converts it. A lock or a release of that token must name exactly these rules, and the decimals are the entry's. The rules' contract id
-- stays the same for as long as the gateway keeps the contract (`Mint` and `Burn` do not consume it). A token is pinned once and this version
-- cannot remove or correct a pin: a wrong pin stays in force until the gateway archives its rules, and the token is then out of use until a
-- package upgrade adds pin removal.
data PinnedTwin = PinnedTwin with
    twinToken : Text
    twinDecimals : Int
    twinRules : ContractId TW.TwinRules
  deriving (Eq, Show)

pinnedOk : PinnedTwin -> Bool
pinnedOk e = hexOfLength 40 e.twinToken && e.twinDecimals >= 0 && e.twinDecimals <= 36

-- The most twins a chain may pin, so `Advance`'s work stays bounded.
maxTwins : Int
maxTwins = 16

-- What a registered contract is for. A `Gateway` is a contract whose legs `Advance` reads, as it reads the first gateway's; a `Vault` is only an
-- address that Daml trusts as the payee of a lock and the payer of a release (`LockLeg`, `ReleaseLeg`).
data ContractKind = Gateway | Vault
  deriving (Eq, Show)

-- One entry of the chain's registry of EVM contracts (`ZkChain.contracts`). The code hash is the keccak-256 of the contract's runtime code
-- (64 lowercase hex digits), the one the confirmer checked against a reviewed build before it accepted the entry.
data RegisteredContract = RegisteredContract with
    contractAddress : Text
    contractCodeHash : Text
    contractKind : ContractKind
  deriving (Eq, Show)

registeredOk : RegisteredContract -> Bool
registeredOk c = hexOfLength 40 c.contractAddress && hexOfLength 64 c.contractCodeHash

-- The most contracts a registry may hold, so a block's argument and `Advance`'s work stay bounded.
maxContracts : Int
maxContracts = 16

-- What the builder gives `Advance` for one registered gateway: what it gives for the first one (`gatewayAccountNodes`,
-- `gatewayStorageNodes` and `legs`), and the gateway's address.
data GatewayBlock = GatewayBlock with
    address : Text
    accountNodes : [Text]
    storageNodes : [Text]
    legs : [Leg]
  deriving (Eq, Show)

-- Every gateway in the registry has an entry in the block, each once, and no other; the last node of an entry's account proof is the leaf of
-- the account, which ends with the account's code hash, and the sidecar checks that path against the proven state root (so the
-- code hash is the one in the proven state).
checkRegisteredGateways : ZkChain -> [GatewayBlock] -> Update ()
checkRegisteredGateways chain extras = do
  let registered = [c | c <- fromOptional [] chain.contracts, c.contractKind == Gateway]
  forA_ extras $ \g ->
    assertMsg ("the gateway " <> g.address <> " is not in the chain's registry") (g.address `elem` map (.contractAddress) registered)
  assertMsg "a gateway has more than one entry in the block" (length (dedup (map (.address) extras)) == length extras)
  forA_ registered $ \c -> case filter (\g -> g.address == c.contractAddress) extras of
    [g] -> assertMsg ("the account proof of the gateway " <> c.contractAddress <> " does not end in an account of the registered code hash")
             (not (null g.accountNodes) && c.contractCodeHash `T.isSuffixOf` T.asciiToLower (last g.accountNodes))
    _ -> abort ("the block carries no entry for the registered gateway " <> c.contractAddress)

-- The operator proposes new leg limits; the confirmer accepts them on the chain's current contract once the chain's change delay has
-- passed, like a gas-cap change (`GasCapProposal`). A change may loosen a limit or tighten it.
template LegLimitsProposal
  with
    operator : Party
    confirmer : Party
    reader : Party
    chainId : Int
    newQuota : Optional Decimal
    newWindow : Optional RelTime
    newPauseMax : Optional RelTime
    proposedAt : Time
  where
    -- Made by `ZkChain.ProposeLegLimits` only (the confirmer signs as well), which stamps it with the ledger time.
    signatory operator, confirmer
    ensure chainId > 0 && isSome newQuota == isSome newWindow && optional True (> 0.0) newQuota && optional True rangeOk newWindow
      && optional True (rangeOkTo maxPauseMax) newPauseMax
    observer reader

    choice WithdrawLegLimits : ()
      controller operator
      do pure ()

    choice RejectLegLimits : ()
      controller confirmer
      do pure ()

    choice AcceptLegLimits : ContractId ZkChain
      with chain : ContractId ZkChain
      controller confirmer
      do
        c <- fetch chain
        assertMsg "the proposal is for another chain" (c.chainId == chainId && c.operator == operator && c.confirmer == confirmer)
        waitedOut "the leg limits" proposedAt c.changeDelay
        exercise chain SetLegLimits with newQuota; newWindow; newPauseMax

-- The operator proposes to pause the legs, or to renew a pause, for `forHowLong`; the confirmer accepts it on the chain's current
-- contract, and the pause then runs from the moment of acceptance. No delay: a pause is protective and ends on its own.
template RenewPauseProposal
  with
    operator : Party
    confirmer : Party
    reader : Party
    chainId : Int
    forHowLong : RelTime
    proposedAt : Time
  where
    -- Made by `ZkChain.ProposeRenewPause` only (the confirmer signs as well), which stamps it with the ledger time.
    signatory operator, confirmer
    ensure chainId > 0 && convertRelTimeToMicroseconds forHowLong > 0
    observer reader

    choice WithdrawRenewPause : ()
      controller operator
      do pure ()

    choice RejectRenewPause : ()
      controller confirmer
      do pure ()

    choice AcceptRenewPause : ContractId ZkChain
      with chain : ContractId ZkChain
      controller confirmer
      do
        c <- fetch chain
        assertMsg "the proposal is for another chain" (c.chainId == chainId && c.operator == operator && c.confirmer == confirmer)
        now <- getTime
        assertMsg "the proposal is too old: a pause is proposed afresh for the incident at hand" (now <= addRelTime proposedAt renewProposalLife)
        exercise chain RenewPause with forHowLong

-- The confirmer alone may start a pause again from the moment the last one ended plus as long as it ran: it may hold the legs for at most
-- half the time, and a pause lifted early costs it little.
coolingAfter : Time -> Time -> Time
coolingAfter began ended = addRelTime ended (subTime ended began)

-- How long a proposal to pause or renew a pause may wait for the confirmer.
renewProposalLife : RelTime
renewProposalLife = hours 1

-- The longest pause that a chain without a `pauseMax` allows, the longest `pauseMax` it may be given, and the longest quota window.
defaultPauseMax, maxPauseMax, maxQuotaWindow : RelTime
defaultPauseMax = days 3
maxPauseMax = days 14
maxQuotaWindow = days 30

-- Between one second and `hi`.
rangeOkTo : RelTime -> RelTime -> Bool
rangeOkTo hi w = let us = convertRelTimeToMicroseconds w in us >= 1000000 && us <= convertRelTimeToMicroseconds hi

rangeOk : RelTime -> Bool
rangeOk = rangeOkTo maxQuotaWindow

pauseLimit : ZkChain -> RelTime
pauseLimit c = fromOptional defaultPauseMax c.pauseMax

-- Whether the legs are paused at this ledger time.
pausedAt : ZkChain -> Time -> Bool
pausedAt c now = case c.pausedUntil of
  Some u -> now < u
  None -> False

-- Withdrawals of one Canton instrument (admin and id) that still count against the quota, up to `countedUntil`. The quota is a rolling window, kept in
-- buckets so the contract stays small: a withdrawal counts from its block until the end of its bucket (a 24th of the window, at least a
-- second) plus a whole window. So at no moment do more than the quota's units leave in any window, and a withdrawal may count a
-- little longer than the window. An entry keeps the expiry it was made with, so a change of the window never frees or holds earlier ones.
data Tally = Tally with
    tallyToken : Text
    countedUntil : Time
    tallyAmount : Decimal
  deriving (Eq, Show)

tallyExpiry : Time -> RelTime -> Time
tallyExpiry now w =
  let epoch = time (date 1970 Jan 1) 0 0 0
      nowUs = convertRelTimeToMicroseconds (subTime now epoch)
      windowUs = convertRelTimeToMicroseconds w
      bucketUs = max 1000000 (windowUs / 24)
      endUs = (nowUs / bucketUs + 1) * bucketUs
  in addRelTime epoch (convertMicrosecondsToRelTime (endUs + windowUs))

addTally : Tally -> [Tally] -> [Tally]
addTally t [] = [t]
addTally t (x :: xs)
  | x.tallyToken == t.tallyToken && x.countedUntil == t.countedUntil = (x with tallyAmount = x.tallyAmount + t.tallyAmount) :: xs
  | otherwise = x :: addTally t xs

-- The withdrawals a block's legs make, as (the Canton instrument that leaves custody, the amount). Counting by instrument and not by
-- EVM token address means that several wrapped tokens of one instrument share one quota.
withdrawalsOf : [Leg] -> Update [(Text, Decimal)]
withdrawalsOf legs = fmap concat (mapA one legs)
  where
    one (WithdrawalLeg _ tokenCid _ amount _ _) = do
      t <- fetch tokenCid
      pure [(partyToText t.instrumentId.admin <> "/" <> t.instrumentId.id, amount)]
    -- A release counts against the quota like a withdrawal, under the twin's instrument.
    one (ReleaseLeg requestCid rulesCid _) = do
      q <- fetch requestCid
      r <- fetch rulesCid
      let i = TW.instrumentOf r.admin r.token
      pure [(partyToText i.admin <> "/" <> i.id, q.amount)]
    one _ = pure []

-- Refuse a block whose withdrawals would take a Canton instrument over the quota, and give the tallies that the chain keeps after it. Without a quota
-- nothing is counted and the tallies stay as they are.
takeAgainstQuota : ZkChain -> Time -> [Leg] -> Update (Optional [Tally])
takeAgainstQuota chain now legs = case (chain.withdrawalQuota, chain.quotaWindow) of
  (Some q, Some w) -> do
    taken <- withdrawalsOf legs
    let live = filter (\t -> t.countedUntil > now) (fromOptional [] chain.withdrawn)
    forA_ (dedup (map fst taken)) $ \tok -> do
      let already = sum [t.tallyAmount | t <- live, t.tallyToken == tok]
      let adding = sum [a | (k, a) <- taken, k == tok]
      assertMsg ("the block's withdrawals of the instrument " <> tok <> " are over the withdrawal quota: " <> show adding <> " more would make "
        <> show (already + adding) <> " in the last " <> show (convertRelTimeToMicroseconds w / 1000000) <> " s, and the quota is " <> show q)
        (already + adding <= q)
    let expiry = tallyExpiry now w
    pure (Some (foldl (\acc (tok, a) -> addTally (Tally with tallyToken = tok; countedUntil = expiry; tallyAmount = a) acc) live taken))
  _ -> pure chain.withdrawn

-- The highest gas cap a chain may be given.
maxGasCap : Int
maxGasCap = 300000000

-- The operator proposes a new gas cap; the confirmer accepts it on the chain's current contract. Two parties sign `SetGasCap`, and
-- the users that act for them are split by role (the confirmer's user acts for the confirmer alone), so the choice is exercised
-- from inside the confirmer's acceptance, where the operator's authority is the proposal's signatory.
template GasCapProposal
  with
    operator : Party
    confirmer : Party
    reader : Party
    chainId : Int
    newCap : Int
    proposedAt : Time
  where
    -- The confirmer signs as well, so the proposal can only be made by `ZkChain.ProposeGasCap`, which stamps it with the ledger time.
    signatory operator, confirmer
    ensure chainId > 0 && newCap > 0
    observer reader

    -- The operator takes its proposal back (Withdraw...), or the confirmer turns it down (Reject...); either one alone, so a pending proposal never gets stuck
    -- (the built-in Archive needs every signatory). The reader sees a pending change and when it was proposed (proposedAt); the wait is the chain's changeDelay, which only the chain's signatories and the builder see.
    choice WithdrawGasCap : ()
      controller operator
      do pure ()

    choice RejectGasCap : ()
      controller confirmer
      do pure ()

    choice AcceptGasCap : ContractId ZkChain
      with chain : ContractId ZkChain
      controller confirmer
      do
        c <- fetch chain
        assertMsg "the proposal is for another chain" (c.chainId == chainId && c.operator == operator && c.confirmer == confirmer)
        waitedOut "the gas cap" proposedAt c.changeDelay
        exercise chain SetGasCap with newCap

-- The operator proposes a new program key, ZisK root and rules hash, and the gateway consents to it, as it does to the chain itself;
-- the confirmer accepts them on the chain's current contract, the same way as `GasCapProposal`. The operator's
-- Ledger API user acts for the operator and the gateway party, so the proposal needs no further step. The confirmer is expected to
-- compare the three values with its own sidecar and build first.
template ProgramProposal
  with
    operator : Party
    confirmer : Party
    gateway : Party
    reader : Party
    chainId : Int
    newProgramVK : Text
    newRootC : Text
    newRulesHash : Text
    proposedAt : Time
  where
    -- Made by `ZkChain.ProposeProgram` only (the confirmer signs as well), which stamps it with the ledger time.
    signatory operator, gateway, confirmer
    ensure chainId > 0 && all (hexOfLength 64) [newProgramVK, newRootC, newRulesHash]
    observer reader

    -- The operator takes its proposal back (Withdraw...), or the confirmer turns it down (Reject...); either one alone, so a pending proposal never gets stuck
    -- (the built-in Archive needs every signatory). The reader sees a pending change and when it was proposed (proposedAt); the wait is the chain's changeDelay, which only the chain's signatories and the builder see.
    choice WithdrawProgram : ()
      controller operator
      do pure ()

    choice RejectProgram : ()
      controller confirmer
      do pure ()

    choice AcceptProgram : ContractId ZkChain
      with chain : ContractId ZkChain
      controller confirmer
      do
        c <- fetch chain
        assertMsg "the proposal is for another chain" (c.chainId == chainId && c.operator == operator && c.confirmer == confirmer && c.gateway == gateway)
        waitedOut "the program" proposedAt c.changeDelay
        exercise chain SetProgram with newProgramVK; newRootC; newRulesHash

-- The operator proposes a contract for the registry, and the gateway consents to it, as to a new program; the confirmer accepts it on the
-- chain's current contract once the chain's change delay has passed, like `ProgramProposal`. The confirmer is expected to accept only when
-- the code at the address, in the proven state, is a reviewed build whose code hash is the entry's.
template ContractProposal
  with
    operator : Party
    confirmer : Party
    gateway : Party
    reader : Party
    chainId : Int
    entry : RegisteredContract
    proposedAt : Time
  where
    -- Made by `ZkChain.ProposeContract` only (the confirmer signs as well), which stamps it with the ledger time.
    signatory operator, gateway, confirmer
    ensure chainId > 0 && registeredOk entry
    observer reader

    -- Either one alone takes it away, as for `ProgramProposal`.
    choice WithdrawContract : ()
      controller operator
      do pure ()

    choice RejectContract : ()
      controller confirmer
      do pure ()

    choice AcceptContract : ContractId ZkChain
      with chain : ContractId ZkChain
      controller confirmer
      do
        c <- fetch chain
        assertMsg "the proposal is for another chain" (c.chainId == chainId && c.operator == operator && c.confirmer == confirmer && c.gateway == gateway)
        waitedOut "the contract" proposedAt c.changeDelay
        exercise chain AddContract with entry

-- The operator proposes to pin a twin, and the gateway consents to it; the confirmer accepts it on the chain's current contract once the chain's
-- change delay has passed, like `ContractProposal`. The confirmer is expected to accept only after it has checked the rules' token and decimals
-- against the ERC-20 itself.
template TwinProposal
  with
    operator : Party
    confirmer : Party
    gateway : Party
    reader : Party
    chainId : Int
    entry : PinnedTwin
    proposedAt : Time
  where
    -- Made by `ZkChain.ProposeTwin` only (the confirmer signs as well), which stamps it with the ledger time.
    signatory operator, gateway, confirmer
    ensure chainId > 0 && pinnedOk entry
    observer reader

    -- Either one alone takes it away, as for `ContractProposal`.
    choice WithdrawTwin : ()
      controller operator
      do pure ()

    choice RejectTwin : ()
      controller confirmer
      do pure ()

    choice AcceptTwin : ContractId ZkChain
      with chain : ContractId ZkChain
      controller confirmer
      do
        c <- fetch chain
        assertMsg "the proposal is for another chain" (c.chainId == chainId && c.operator == operator && c.confirmer == confirmer && c.gateway == gateway)
        waitedOut "the twin" proposedAt c.changeDelay
        exercise chain AddTwin with entry

-- The operator proposes a new change delay, and the gateway consents to it; the confirmer accepts it on the chain's current contract.
-- The proposal waits out the delay that is in force when it is accepted, like any other change, so a delay cannot be cut short
-- by one step. `None` takes the wait away, and any value is at most `maxChangeDelay`.
template ChangeDelayProposal
  with
    operator : Party
    confirmer : Party
    gateway : Party
    reader : Party
    chainId : Int
    newDelay : Optional RelTime
    proposedAt : Time
  where
    -- Made by `ZkChain.ProposeChangeDelay` only (the confirmer signs as well), which stamps it with the ledger time.
    signatory operator, gateway, confirmer
    ensure chainId > 0 && delayInRange newDelay
    observer reader

    -- The operator takes its proposal back (Withdraw...), or the confirmer turns it down (Reject...); either one alone, so a pending proposal never gets stuck
    -- (the built-in Archive needs every signatory). The reader sees a pending change and when it was proposed (proposedAt); the wait is the chain's changeDelay, which only the chain's signatories and the builder see.
    choice WithdrawChangeDelay : ()
      controller operator
      do pure ()

    choice RejectChangeDelay : ()
      controller confirmer
      do pure ()

    choice AcceptChangeDelay : ContractId ZkChain
      with chain : ContractId ZkChain
      controller confirmer
      do
        c <- fetch chain
        assertMsg "the proposal is for another chain" (c.chainId == chainId && c.operator == operator && c.confirmer == confirmer && c.gateway == gateway)
        waitedOut "the change delay" proposedAt c.changeDelay
        exercise chain SetChangeDelay with newDelay

-- The longest change delay a chain may be given.
maxChangeDelay : RelTime
maxChangeDelay = days 30

delayInRange : Optional RelTime -> Bool
delayInRange d = let us = convertRelTimeToMicroseconds (fromOptional (seconds 0) d) in us >= 0 && us <= convertRelTimeToMicroseconds maxChangeDelay

-- A change may be accepted once the chain's delay has passed since it was proposed. The proposal's time is the ledger time of its
-- creation (see `ZkChain.ProposeGasCap`); it can not be in the future.
waitedOut : Text -> Time -> Optional RelTime -> Update ()
waitedOut what proposedAt delay = do
  now <- getTime
  let readyAt = addRelTime proposedAt (fromOptional (seconds 0) delay)
  assertMsg ("the proposal is dated in the future") (proposedAt <= now)
  assertMsg ("the change of " <> what <> " may be accepted from " <> show readyAt <> " (proposed at " <> show proposedAt <> ", change delay " <> show (convertRelTimeToMicroseconds (fromOptional (seconds 0) delay) / 1000000) <> " s)") (now >= readyAt)

-- A contract of a leg must name this chain's id, operator and confirmer. Authority would not always refuse others: the
-- builder is a controller of `Advance`, so a contract that names the builder in one of those roles would otherwise pass.
checkChain : Text -> ZkChain -> Int -> Party -> Party -> Update ()
checkChain what chain chainId operator confirmer = do
  assertMsg (what <> " is for another chain") (chainId == chain.chainId)
  assertMsg (what <> " names another operator than the chain's") (operator == chain.operator)
  assertMsg (what <> " names another confirmer than the chain's") (confirmer == chain.confirmer)

-- ... and, where it has one, the chain's gateway.
checkGateway : Text -> ZkChain -> Party -> Update ()
checkGateway what chain gateway = assertMsg (what <> " names another gateway than the chain's") (gateway == chain.gateway)

checkToken : ZkChain -> GatewayToken -> Update ()
checkToken chain t = do
  checkChain "the token" chain t.chainId t.operator t.confirmer
  checkGateway "the token" chain t.gateway

-- The sidecar's line of a leg: `kind/id/token/account/amount/party`, in the form README.md describes. A deposit's and a
-- withdrawal's amount is a Canton amount as Daml writes a Decimal; a payment's is the ERC-20 amount, as 64 hex digits.
-- `party` is the hex of the receiver's party id for a withdrawal, and empty otherwise.
legField : Text -> Text -> Text -> Text -> Text -> Text -> Text
legField kind id token account amount party = T.intercalate "/" [kind, id, token, account, amount, party]

-- What a leg makes the sidecar check. This also refuses, before anything is settled, a leg whose contracts are not this chain's.
legLine : ZkChain -> Leg -> Update Text
legLine chain (DepositLeg requestCid tokenCid) = do
  r <- fetch requestCid
  t <- fetch tokenCid
  checkChain "the deposit request" chain r.chainId r.operator r.confirmer
  checkGateway "the deposit request" chain r.gateway
  checkToken chain t
  a <- fetch r.allocation
  let leg = (view a).allocation.transferLeg
  assertMsg "the deposit is of another instrument than the token's" (leg.instrumentId == t.instrumentId)
  assertMsg "the deposit is of no amount" (leg.amount > 0.0)
  pure (legField "deposit" r.depositId t.evmToken r.recipient (show leg.amount) "")
legLine chain (WithdrawalLeg id tokenCid from amount acceptanceCid _) = do
  t <- fetch tokenCid
  w <- fetch acceptanceCid
  checkChain "the acceptance" chain w.chainId w.operator w.confirmer
  checkGateway "the acceptance" chain w.gateway
  checkToken chain t
  assertMsg "the withdrawal's id must be 64 lowercase hex digits and its burner 40" (hexOfLength 64 id && hexOfLength 40 from)
  assertMsg "the withdrawal is of no amount" (amount > 0.0)
  pure (legField "withdrawal" id t.evmToken from (show amount) (toHex (partyToText w.party)))
legLine chain (PaymentLeg termsCid) = do
  t <- fetch termsCid
  checkChain "the DvpTerms contract" chain t.chainId t.operator t.confirmer
  pure (legField "payment" t.dvpId t.token t.payee t.amount "")
legLine chain (TradeLeg tradeCid) = do
  t <- fetch tradeCid
  checkChain "the venue trade" chain t.chainId t.operator t.confirmer
  checkGateway "the venue trade" chain t.gateway
  g <- fetch t.gatewayToken
  checkToken chain g   -- the claim a settled trade leaves can be redeemed only with a token of this chain
  pure (legField "payment" t.payId t.token t.payee t.amount "")
legLine chain (ClaimLeg claimCid tokenCid) = do
  c <- fetch claimCid
  t <- fetch tokenCid
  checkChain "the funded claim" chain c.chainId c.operator c.confirmer
  checkGateway "the funded claim" chain c.gateway
  checkToken chain t
  assertMsg "the funded claim is for another token than the leg's" (c.gatewayToken == tokenCid)
  pure (legField "deposit" c.claimId t.evmToken c.recipient (show c.amount) "")

legLine chain (LockLeg rulesCid receiver ref vault amountHex) = do
  r <- fetch rulesCid
  checkTwin chain r
  checkPinned chain rulesCid r
  checkVault chain vault
  assertMsg "the lock's reference is empty" (ref /= "")
  a <- twinAmount r amountHex
  assertMsg "the lock is of no amount" (a > 0.0)
  pure (legField "payment" (lockId receiver ref) r.token vault amountHex "")
legLine chain (ReleaseLeg requestCid rulesCid vault) = do
  q <- fetch requestCid
  r <- fetch rulesCid
  checkChain "the redeem request" chain q.chainId q.operator q.confirmer
  checkGateway "the redeem request" chain q.gateway
  checkTwin chain r
  checkPinned chain rulesCid r
  assertMsg "the redeem request is for another token than the twin's" (q.token == r.token)
  checkVault chain vault
  units <- case TA.toBaseUnits r.decimals q.amount of
    Some u -> pure u
    None -> abort ("the release's amount " <> show q.amount <> " is not a whole number of base units of the ERC-20 (it has " <> show r.decimals <> " decimals)")
  pure (legField "payment" (releaseId vault q.ref) q.token q.recipient (hex64 units) "")

-- The twin the leg names is one of this chain's gateway, which is the twin's admin and the only party that can mint and burn it.
checkTwin : ZkChain -> TW.TwinRules -> Update ()
checkTwin chain r = assertMsg "the twin is another admin's than the chain's gateway" (r.admin == chain.gateway)

-- The twin the leg names is the one pinned for its token: exactly the pinned rules, with the pinned decimals. A token with no pin is refused.
checkPinned : ZkChain -> ContractId TW.TwinRules -> TW.TwinRules -> Update ()
checkPinned chain rulesCid r = case filter (\p -> p.twinToken == r.token) (fromOptional [] chain.twins) of
  [] -> abort ("the token " <> r.token <> " has no twin pinned in the chain's record")
  (p :: _) -> do
    assertMsg ("the leg names other rules than the ones pinned for the token " <> r.token) (p.twinRules == rulesCid)
    assertMsg ("the rules' decimals are not the pinned " <> show p.twinDecimals) (p.twinDecimals == r.decimals)

-- The payee of a lock and the payer of a release is a vault of the registry.
checkVault : ZkChain -> Text -> Update ()
checkVault chain vault =
  assertMsg ("the address " <> vault <> " is not a vault in the chain's registry")
    (any (\c -> c.contractAddress == vault && c.contractKind == Vault) (fromOptional [] chain.contracts))

-- The twin's amount of an ERC-20 amount (64 hex digits of base units). A twin has 10 decimals: an amount finer than that, or over what a twin
-- holds, is refused and never rounded.
twinAmount : TW.TwinRules -> Text -> Update Decimal
twinAmount r amountHex = case TA.fromBaseUnits r.decimals amountHex of
  Some a -> pure a
  None -> abort ("the amount " <> amountHex <> " of an ERC-20 of " <> show r.decimals
    <> " decimals is not a twin amount: a twin has 10 decimals, an amount finer than that is refused and never rounded")

-- The id of the EVM payment that locks an ERC-20 in a vault: the SHA-256 of the tag "lock", the Canton receiver's party id and a reference,
-- as `venueTradeId` is made. The tag is not a party id, a "venue-trade" tag or "vault-release", so no id of another kind equals it.
lockId : Party -> Text -> Text
lockId receiver ref = T.sha256 (T.intercalate "," ["lock", partyToText receiver, ref])

-- The id of the EVM payment that `Vault.release(ref, ...)` makes: the SHA-256 of `vault-release,<vault address, 40 lowercase hex digits>,<ref>`.
releaseId : Text -> Text -> Text
releaseId vault ref = T.sha256 ("vault-release," <> vault <> "," <> ref)

-- A whole number as 64 lowercase hex digits, the form of an ERC-20 amount in a payment line.
hex64 : Numeric 0 -> Text
hex64 n = T.implode (amountDigits 64 n [])

-- The last `k` hex digits of `x` in front of `acc` (the recursion is a top-level function: Daml-LF has no local recursion).
amountDigits : Int -> Numeric 0 -> [Text] -> [Text]
amountDigits k x acc
  | k == 0 = acc
  | otherwise =
      let sixteen = intToNumeric 16 : Numeric 0
          q0 = x / sixteen          -- rounded, so the remainder is between -8 and 8
          r0 = x - q0 * sixteen
          (q, r) = if r0 < intToNumeric 0 then (q0 - intToNumeric 1, r0 + sixteen) else (q0, r0)
      in amountDigits (k - 1) q (hexDigitOf r :: acc)

hexDigitOf : Numeric 0 -> Text
hexDigitOf r = fromOptional "0" (lookup r (zip (map intToNumeric [0 .. 15]) hexDigits))

-- The gateway uses each payment id once, so no honest block carries one id twice for one gateway; a block that does is refused before it settles
-- anything. The used ids belong to each gateway, so the check runs over one gateway's legs at a time: the same id paid on two gateways is allowed.
twinIds : Leg -> Update [Text]
twinIds (LockLeg _ receiver ref _ _) = pure [lockId receiver ref]
twinIds (ReleaseLeg requestCid _ vault) = do
  q <- fetch requestCid
  pure [releaseId vault q.ref]
twinIds _ = pure []

checkTwinIdsDistinct : [Leg] -> Update ()
checkTwinIdsDistinct legs = do
  ids <- fmap concat (mapA twinIds legs)
  assertMsg "a block carries the same twin payment id twice" (length (dedup ids) == length ids)

-- Settle a leg that the sidecar has confirmed. Each choice adds the authority of its own contract's signatory to the
-- authority of `Advance`: the operator, the confirmer and the gateway, who are the signatories of `ZkChain`.
settle : Leg -> Update ()
settle (DepositLeg requestCid _) = exercise requestCid Lock
settle (WithdrawalLeg _ tokenCid _ amount acceptanceCid inputs) =
  exercise acceptanceCid Receive with token = tokenCid; amount; inputs
settle (PaymentLeg termsCid) = exercise termsCid Settle
settle (TradeLeg tradeCid) = do
  _ <- exercise tradeCid SettleTrade
  pure ()
settle (ClaimLeg claimCid _) = exercise claimCid Redeem
-- The twin is minted to the receiver, 1:1, against the payment the block recorded. `Advance` brings the gateway's authority, the twin's admin.
settle (LockLeg rulesCid receiver ref _ amountHex) = do
  r <- fetch rulesCid
  a <- twinAmount r amountHex
  _ <- exercise rulesCid TW.Mint with owner = receiver; amount = a; reference = lockId receiver ref
  pure ()
settle (ReleaseLeg requestCid rulesCid _) = exercise requestCid BurnForRelease with rules = rulesCid

-- One per block: everything a third party needs to replay the chain and re-check each proof.
template BlockRecord
  with
    operator : Party
    confirmer : Party
    builder : Party
    reader : Party
    chainId : Int
    number : Int
    blockHash : Text
    parentHash : Text
    headerHex : Text
    txsHex : Text
    proofHex : Text
  where
    signatory operator, confirmer
    observer builder, reader

-- "This Canton instrument is what this EVM token stands for, and this is its registry's transfer factory." Registering a
-- token is a decision of the operator, the confirmer and the gateway together, because the gateway runs that registry's
-- Daml code with its own authority. The proposal is signed by the operator and the gateway and accepted by the confirmer,
-- who is expected to check that the EVM address is a token the gateway contract made.
template GatewayTokenProposal
  with
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
    chainId : Int
    evmToken : Text
    instrumentId : InstrumentId
    factory : ContractId TransferFactory
  where
    signatory operator, gateway
    observer confirmer
    ensure chainId > 0 && hexOfLength 40 evmToken && instrumentId.id /= ""

    choice AcceptToken : ContractId GatewayToken
      controller confirmer
      do create GatewayToken with ..

template GatewayToken
  with
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
    chainId : Int
    evmToken : Text
    instrumentId : InstrumentId
    factory : ContractId TransferFactory
  where
    signatory operator, confirmer, gateway
    observer builder

-- "Deposit this allocation: when the block that records the EVM claim for `depositId` commits, lock it with the gateway."
-- The depositor made the allocation to the gateway, with the operator as executor. Until the block commits, the depositor
-- can withdraw it. `recipient` is the EVM address that claims the wrapped token.
template DepositRequest
  with
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
    chainId : Int
    depositor : Party
    depositId : Text
    recipient : Text
    allocation : ContractId Allocation
  where
    signatory depositor
    observer operator, confirmer, gateway, builder
    ensure chainId > 0 && hexOfLength 64 depositId && hexOfLength 40 recipient

    -- The operator, the confirmer and the gateway together are the signatories of `ZkChain`, so their authority is present
    -- inside `Advance` and nowhere else: none of them can lock alone, and the builder cannot lock at all.
    choice Lock : ()
      controller operator, confirmer, gateway
      do
        a <- fetch allocation
        let leg = (view a).allocation
        assertMsg "the allocation's executor is not the operator" (leg.settlement.executor == operator)
        assertMsg "the allocation is not from the depositor to the gateway" (leg.transferLeg.sender == depositor && leg.transferLeg.receiver == gateway)
        _ <- exercise allocation Allocation_ExecuteTransfer with extraArgs = noExtraArgs
        pure ()

-- "I accept withdrawals": a standing acceptance by a party that wants to receive Canton tokens from the gateway. Made once.
template WithdrawalAcceptance
  with
    party : Party
    chainId : Int
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
  where
    signatory party
    observer operator, confirmer, gateway, builder
    ensure chainId > 0

    -- The gateway transfers `amount` of the token's instrument from its custody (`inputs`) to `party` through the
    -- registry's own factory, and `party` accepts in the same transaction. The factory is told the instrument's admin as
    -- the one it must belong to. A registry that completes the transfer at once is fine too; anything else aborts.
    nonconsuming choice Receive : ()
      with
        token : ContractId GatewayToken
        amount : Decimal
        inputs : [ContractId Holding]
      controller operator, confirmer, gateway
      do
        t <- fetch token
        assertMsg "the token is for another chain, operator, confirmer or gateway than this acceptance's" (t.chainId == chainId && t.operator == operator && t.confirmer == confirmer && t.gateway == gateway)
        assertMsg "the amount must be more than zero" (amount > 0.0)
        now <- getTime
        r <- exercise t.factory TransferFactory_Transfer with
          expectedAdmin = t.instrumentId.admin
          transfer = Transfer with
            sender = gateway; receiver = party; amount; instrumentId = t.instrumentId
            requestedAt = now; executeBefore = addRelTime now (days 1); inputHoldingCids = inputs; meta = emptyMetadata
          extraArgs = noExtraArgs
        case r.output of
          TransferInstructionResult_Completed _ -> pure ()
          TransferInstructionResult_Pending offer -> do
            accepted <- exercise offer TransferInstruction_Accept with extraArgs = noExtraArgs
            case accepted.output of
              TransferInstructionResult_Completed _ -> pure ()
              _ -> abort "the transfer to the receiver did not complete"
          TransferInstructionResult_Failed -> abort "the registry failed the transfer"

-- The EVM payment id of terms between u and v: the SHA-256 of their two party ids and a label, so only terms that
-- u and v both signed can carry the id the payer pays against.
paymentId : Party -> Party -> Text -> Text
paymentId u v label = T.sha256 (T.intercalate "," [partyToText u, partyToText v, label])

-- "If the gateway records this payment (`dvpId`: `token`, `amount` to `payee`) in the proven block, execute `allocation`."
-- The allocation is the token standard's own, made by u for v with the operator as executor, so it locks u's holding until
-- then. `dvpId` is the EVM payment id itself: 64 lowercase hex digits, so the line Daml writes carries exactly the id that
-- the gateway recorded. It is made from u, v and `label` (`paymentId`), so terms that u and v did not both sign cannot
-- carry it. The amount is the ERC-20 amount in base units, as 64 hex digits, and is not zero.
template DvpTerms
  with
    u : Party
    v : Party
    operator : Party
    confirmer : Party
    builder : Party
    chainId : Int
    label : Text
    dvpId : Text
    token : Text
    payee : Text
    amount : Text
    allocation : ContractId Allocation
  where
    signatory u, v
    observer operator, confirmer, builder
    ensure dvpId == paymentId u v label && hexOfLength 40 token && hexOfLength 40 payee && hexOfLength 64 amount
      && T.explode amount /= replicate 64 "0"

    -- Its controllers, the operator and the confirmer, sign `ZkChain` with the gateway, so their authority is present
    -- together inside `Advance` and nowhere else: neither can settle alone, and the builder cannot settle at all.
    choice Settle : ()
      controller operator, confirmer
      do
        a <- fetch allocation
        let leg = (view a).allocation
        assertMsg "the allocation's executor is not the operator" (leg.settlement.executor == operator)
        assertMsg "the allocation is not from u to v" (leg.transferLeg.sender == u && leg.transferLeg.receiver == v)
        _ <- exercise allocation Allocation_ExecuteTransfer with extraArgs = noExtraArgs
        pure ()

-- The id of the EVM payment that settles a venue's trade: the SHA-256 of a domain tag, the venue's party id and a label. The tag
-- "venue-trade" is not a party id, so this id can never equal a `paymentId` (whose first part is one): a payment recorded for
-- terms of two parties cannot be taken for a trade's, nor the other way round.
venueTradeId : Party -> Text -> Text
venueTradeId v label = T.sha256 (T.intercalate "," ["venue-trade", partyToText v, label])

-- The id of the claim that a trade's settlement makes, and with which the EVM side redeems it (the id of a `deposit` line).
venueClaimId : Text -> Text
venueClaimId payId = T.sha256 ("claim," <> payId)

-- "If the gateway records this payment (`payId`: `token`, `amount` to `payee`) in the proven block, execute `allocation`", for a
-- trade that a Canton venue made, and make the funded claim of `recipient`. The venue and `sender`, the party whose holding the allocation
-- locks, sign it: the token standard's `Allocation_ExecuteTransfer` needs its executor, sender and receiver together, and the sender's
-- consent is this signature. The trade names the allocation, of which the venue is the executor: the allocation goes to the gateway, which holds what the EVM side's buyer (the `recipient`) will claim. `payId` is
-- the payment id itself (see `venueTradeId`) and `claimId` the id of the claim (see `venueClaimId`); token, payee and recipient are
-- EVM addresses and the amount is the ERC-20 amount as 64 hex digits, not zero. `allocationDisclosed`, if present, is the allocation
-- as a disclosed contract in the JSON Ledger API's form, which the builder adds to its `Advance`: the allocation's holder and its
-- registry are not the builder's parties, and would otherwise not be visible to it.
template VenueTrade
  with
    venue : Party
    sender : Party
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
    chainId : Int
    label : Text
    payId : Text
    token : Text
    payee : Text
    amount : Text
    allocation : ContractId Allocation
    allocationDisclosed : Optional Text
    gatewayToken : ContractId GatewayToken
    claimId : Text
    recipient : Text
  where
    signatory venue, sender
    observer operator, confirmer, gateway, builder
    ensure payId == venueTradeId venue label && claimId == venueClaimId payId
      && hexOfLength 40 token && hexOfLength 40 payee && hexOfLength 40 recipient && hexOfLength 64 amount
      && T.explode amount /= replicate 64 "0" && chainId > 0

    -- Its controllers sign `ZkChain`, so their authority is present together inside `Advance` and nowhere else.
    choice SettleTrade : ContractId FundedClaim
      controller operator, confirmer, gateway
      do
        a <- fetch allocation
        g <- fetch gatewayToken
        let leg = (view a).allocation
        assertMsg "the allocation's executor is not the venue" (leg.settlement.executor == venue)
        assertMsg "the allocation's sender is not the trade's" (leg.transferLeg.sender == sender)
        assertMsg "the allocation's receiver is not the gateway" (leg.transferLeg.receiver == gateway)
        assertMsg "the allocation is of another instrument than the token's" (leg.transferLeg.instrumentId == g.instrumentId)
        assertMsg "the allocation is of no amount" (leg.transferLeg.amount > 0.0)
        _ <- exercise allocation Allocation_ExecuteTransfer with extraArgs = noExtraArgs
        create FundedClaim with
          operator; confirmer; gateway; builder; chainId; claimId; recipient; gatewayToken
          amount = leg.transferLeg.amount

-- What a settled trade leaves: the gateway holds the Canton token, and the EVM side's `recipient` may claim its wrapped form with
-- the deposit line of `claimId`. Redeeming it is what a `ClaimLeg` does; it can be redeemed once.
template FundedClaim
  with
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
    chainId : Int
    claimId : Text
    recipient : Text
    gatewayToken : ContractId GatewayToken
    amount : Decimal
  where
    signatory operator, confirmer, gateway
    observer builder

    choice Redeem : ()
      controller operator, confirmer, gateway
      do pure ()

-- A holder's request to redeem a twin: "burn these holdings for `amount` of `token`, and let the vault pay `amount` to `recipient`, an EVM
-- address, under `ref`". The request is made before the vault pays: the vault's `release` makes the payment id from the vault's address and
-- `ref` (`releaseId`), so `ref` must be unique per request, because the gateway uses each id once; make it from a fresh random value. The
-- holder signs, so no one can redeem another party's twin. `BurnForRelease` runs only inside `Advance`, with the release leg that the block
-- recorded; it burns `amount` out of the holdings and archives the request. The holder keeps the change.
-- The holdings are not locked here: a holder who spends them first makes the burn, and the block that carries the payment, fail. The builder
-- includes a release in a block only while the holdings are there (hardening, README.md).
template RedeemRequest
  with
    holder : Party
    operator : Party
    confirmer : Party
    gateway : Party
    builder : Party
    chainId : Int
    token : Text
    holdings : [ContractId Holding]
    amount : Decimal
    recipient : Text
    ref : Text
  where
    signatory holder
    observer operator, confirmer, gateway, builder
    ensure chainId > 0 && hexOfLength 40 token && hexOfLength 40 recipient && amount > 0.0 && ref /= "" && not (null holdings)

    -- Its controllers sign `ZkChain`, so their authority is present together inside `Advance`; the three together can also burn outside it, as the chain's root of trust.
    choice BurnForRelease : ()
      with rules : ContractId TW.TwinRules
      controller operator, confirmer, gateway
      do
        r <- fetch rules
        assertMsg "the twin is another admin's than the request's gateway" (r.admin == gateway)
        assertMsg "the twin is of another token than the request's" (r.token == token)
        _ <- exercise rules TW.Burn with owner = holder; holdingCids = holdings; amount = amount; reference = ref
        pure ()
