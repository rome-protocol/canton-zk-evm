-- The production form of the sidecar module: each call goes to the "canton-zk-evm" extension service
-- that every confirming participant runs beside it. Canton runs the call at the submitting participant and
-- again at every confirmer, and rejects the transaction if the answers differ.
-- Needs a Daml toolchain that has DA.ExternalCall. daml/README.md says which, and how this is tested.
module Zk.Sidecar where

import DA.ExternalCall (externalCall)
import Zk.Hex

-- The proof, header and transactions in; one line out (README: "verify2"). The input is the line itself: it is hex text already,
-- so unlike the other call it is not hexed again.
verifyBlockCall : Text -> Text -> Text -> Update Text
verifyBlockCall proofHex headerHex txsHex =
  fromHex <$> externalCall "canton-zk-evm" "verify2" "" (verify2Line proofHex headerHex txsHex)

-- The proven block's state root and number, the gateway's address, the gateway's two storage proofs and the attached legs
-- in; one line out (README: "legs").
legsCall : Text -> Update Text
legsCall input = fromHex <$> externalCall "canton-zk-evm" "legs" "" (toHex input)
