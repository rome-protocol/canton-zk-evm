-- The test form of the sidecar module. It answers in the same one-line format as the real sidecar, but from a
-- small table instead of checking anything: Daml Script's test ledger cannot make an external call. The header
-- field of a call picks the scenario, so a test says "block 01" and gets a well-formed answer for it.
-- Every check Daml makes on an answer is the real one; only where the answer comes from is stubbed. The call goes
-- through the same hex helpers as the production form: the request body is hex, so is the answer's.
module Zk.Sidecar where

import DA.Optional (fromOptional)
import qualified DA.Text as T
import Zk.Hex

-- What the test chain is pinned to, and what the table's blocks carry.
stubVK, stubRoot, stubHash0, stubHash1, stubHash2, stubStateRoot0, stubStateRoot, stubStateRoot2, tenTokens, fiveTokens : Text
stubVK = mconcat (replicate 64 "a")
stubRoot = mconcat (replicate 64 "b")
stubHash0 = mconcat (replicate 64 "0")       -- the genesis block's hash: the chain's first head
stubHash1 = mconcat (replicate 64 "1")
stubHash2 = mconcat (replicate 64 "2")
stubStateRoot0 = mconcat (replicate 64 "4")  -- the genesis block's state root: the chain's first head state root
stubStateRoot = mconcat (replicate 64 "5")   -- block 1's
stubStateRoot2 = mconcat (replicate 64 "6")  -- block 2's
tenTokens = mconcat (replicate 48 "0") <> "8ac7230489e80000"   -- 10 * 10^18, as 64 hex digits
fiveTokens = mconcat (replicate 48 "0") <> "4563918244f40000"

-- The stand-in for the extension service: it takes the hex body and answers with a hex body.
stubService : (Text -> Text) -> Text -> Text
stubService answer body = toHex (answer (fromHex body))

-- The line goes to the stand-in as it goes to the real service: lowercased by the runtime (DA.ExternalCall's externalCall does it on
-- the way), and not hexed again. The sidecar's `verify2` then takes the line apart, as `verify2Answer` does.
verifyBlockCall : Text -> Text -> Text -> Update Text
verifyBlockCall proofHex headerHex txsHex =
  pure (fromHex (toHex (verify2Answer (T.asciiToLower (verify2Line proofHex headerHex txsHex)))))

legsCall : Text -> Update Text
legsCall input = pure (fromHex (stubService legsAnswer (toHex input)))

-- The real sidecar takes hex only as whole bytes of lowercase digits (an odd length, a capital letter or any other character is
-- refused) and answers "malformed input"; Advance does not check this itself. The three verify fields may be empty, a node of
-- a gateway proof may not.
wholeBytes : Text -> Bool
wholeBytes s = T.length s % 2 == 0 && all (`elem` T.explode "0123456789abcdef") (T.explode s)

nodesOk : Text -> Bool
nodesOk s = s == "" || all (\n -> n /= "" && wholeBytes n) (T.splitOn ";" s)

-- What the sidecar's `verify2` does with a line: the first 64 characters are the SHA-256 of the rest, which is the proof and the
-- header, each behind 10 decimal digits for its length, and then the transactions. Anything else is "malformed input".
verify2Answer : Text -> Text
verify2Answer line
  | T.length line < 64 || T.sha256 body /= T.take 64 line = malformed
  | otherwise = case lengthPrefixed body of
      Some (proof, rest) -> case lengthPrefixed rest of
        Some (header, txs) -> verifyAnswer proof header txs
        None -> malformed
      None -> malformed
  where
    body = T.drop 64 line
    malformed = "no malformed input"

lengthPrefixed : Text -> Optional (Text, Text)
lengthPrefixed s
  | T.length digits == 10 && all (`elem` T.explode "0123456789") (T.explode digits) && n <= T.length rest = Some (T.take n rest, T.drop n rest)
  | otherwise = None
  where
    digits = T.take 10 s
    rest = T.drop 10 s
    n = fromOptional 0 (T.parseInt digits)

-- Header "01" is a good block 1 on the genesis; "11" a good block 2 on block 1. The rest each get one thing wrong.
-- A block's state root is the one of its number: block 1's, then block 2's.
-- Headers "07" to "0a" are block 1 with a limit or a gas use above 30M: "07" has the limit 60M, "08" 60,000,001, "09" the limit 60M
-- and 60,000,001 used, "0a" the limit 60M and exactly 60M used.
verifyAnswer : Text -> Text -> Text -> Text
verifyAnswer proof header txs
  | not (all wholeBytes [proof, header, txs]) = "no malformed input"
  | proof == "ba" = "no the proof does not verify"
  | header == "01" = ok stubVK stubRoot stubHash1 stubHash0 1 30000000 21000
  | header == "11" = ok stubVK stubRoot stubHash2 stubHash1 2 30000000 21000
  | header == "02" = ok stubVK stubRoot stubHash1 stubHash2 1 30000000 21000   -- the parent is not the head
  | header == "03" = ok stubVK stubRoot stubHash1 stubHash0 2 30000000 21000   -- the number skips one
  | header == "04" = ok stubVK stubRoot stubHash1 stubHash0 1 31000000 21000   -- the gas limit is over the cap
  | header == "05" = ok stubRoot stubRoot stubHash1 stubHash0 1 30000000 21000 -- proven under another program
  | header == "06" = ok stubVK stubVK stubHash1 stubHash0 1 30000000 21000     -- proven under another ZisK release
  | header == "07" = ok stubVK stubRoot stubHash1 stubHash0 1 60000000 21000
  | header == "08" = ok stubVK stubRoot stubHash1 stubHash0 1 60000001 21000
  | header == "09" = ok stubVK stubRoot stubHash1 stubHash0 1 60000000 60000001
  | header == "0a" = ok stubVK stubRoot stubHash1 stubHash0 1 60000000 60000000
  | otherwise = "no unknown block"
  where
    ok vk rc bh ph n gl used = T.intercalate " " ["ok", vk, rc, bh, ph, show n, if n == 2 then stubStateRoot2 else stubStateRoot, "1700000000", show gl, show used, "1"]

-- The stub cannot hash, so it stands in for the gateway's proofs like this. The roots and numbers are the ones of its blocks:
-- block 1 under the first state root, block 2 under the second; under any other pair the account proof does not verify.
-- Account nodes with a node "ba" fail it too. "e1", "e2", "e3" and "e4" answer well-formed but for another root, another number,
-- another gateway and another count (as the first node of the account proof). The storage nodes are the legs the block recorded, as hex (none: no legs); the
-- stub answers `ok` only if the attached legs are exactly those, and storage nodes "ba" fail the storage proof.
legsAnswer : Text -> Text
legsAnswer input = case T.splitOn "," input of
  [root, number, gateway, account, storage, legs]
    | not (nodesOk account && nodesOk storage) -> "no malformed input"
    | (root, number) `notElem` [(stubStateRoot, "1"), (stubStateRoot2, "2")] -> "no the account proof does not verify"
    | "ba" `elem` T.splitOn ";" account -> "no the account proof does not verify"
    | storage == "ba" -> "no the storage proof does not verify"
    | fromHex storage /= legs -> "no the legs are not the ones the block recorded"
    | tag == "e1" -> answer (mconcat (replicate 64 "9")) number gateway count
    | tag == "e2" -> answer root "3" gateway count
    | tag == "e3" -> answer root number (mconcat (replicate 40 "3")) count
    | tag == "e4" -> answer root number gateway (count + 1)
    | otherwise -> answer root number gateway count
    where
      count = if legs == "" then 0 else length (T.splitOn "|" legs)
      tag = head (T.splitOn ";" account)   -- the first account node: a registered gateway's proof has the code hash node after it
  _ -> "no malformed input"
  where
    answer root number gateway count = T.intercalate " " ["ok", root, number, gateway, show count]
