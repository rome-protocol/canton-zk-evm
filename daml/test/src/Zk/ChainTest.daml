-- Daml Script tests for the canton-zk-evm package, run against its stub form (daml/README.md: "How the
-- external call is tested"). The token is the Splice reference token, driven through the standard's own factory.
--
-- The stub cannot hash, so it treats the gateway's storage proof as the text of the legs the block recorded (as hex),
-- and the account proof as a tag that picks a failure (README.md and sidecar/stub.daml). A test writes down the legs
-- its block "recorded" in the exact line format the real sidecar reads, which also pins that format.
module Zk.ChainTest where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List ((!!), sort)
import DA.Optional (isSome)
import DA.Time (RelTime, addRelTime, days, seconds, convertRelTimeToMicroseconds, convertMicrosecondsToRelTime)
import qualified DA.Text as T
import Daml.Script

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.HoldingV1 as H
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1
import Splice.Testing.Tokens.TestTokenV1 (Token(..), TokenAllocation, TokenRules(..))

import qualified DA.Crypto.Text as C
import Zk.Chain
import Zk.Hex
import Zk.Sidecar

-- The registry that issues the test token: its rules (the factory for both transfers and allocations), and the
-- disclosure of those rules, which the builder needs to settle.
data Reg = Reg with
  registry : Party
  rulesCid : ContractId TokenRules
  rules : Disclosure

data F = F with
  operator, confirmer, builder, reader, registry, gateway, u, v, d : Party
  chain : ContractId ZkChain
  reg : Reg
  rulesCid : ContractId TokenRules
  rules : Disclosure
  token : ContractId GatewayToken
  terms : ContractId DvpTerms
  dvp1, dvp2 : Text
  deposit : ContractId DepositRequest
  acceptance : ContractId WithdrawalAcceptance

-- The EVM side: the gateway's address, the EVM token that wraps TKB, the payment token, and some accounts.
gatewayAddr, wTkb, tokenAddr, uAddr, recipientAddr, burnerAddr : Text
gatewayAddr = mconcat (replicate 20 "a7")
wTkb = mconcat (replicate 20 "33")
tokenAddr = mconcat (replicate 20 "11")
uAddr = mconcat (replicate 20 "22")
recipientAddr = mconcat (replicate 20 "44")
burnerAddr = mconcat (replicate 20 "55")

-- A 64-digit id from one repeated byte.
idOf : Text -> Text
idOf b = mconcat (replicate 32 b)

deposit1, withdrawalId : Text
deposit1 = idOf "d1"
withdrawalId = idOf "c1"

-- The labels of the two payments. Their ids are `paymentId u v label`, so they belong to the pair that signed them.
label1, label2 : Text
label1 = "dvp-1"
label2 = "dvp-2"

-- Whom the terms (and the allocation's executor) name as the operator and the confirmer. `Honest` names the chain's own.
-- The others name the builder in one role: the authority present in `Advance` would still let such a leg settle
-- (the builder is the controller, the chain's signatories are there too), so only the chain's own check refuses it.
data Naming = Honest | BuilderAsOperator | BuilderAsConfirmer

-- A chain at its genesis, with a gateway. TKB is registered: its EVM form is the token at `wTkb`.
-- U has allocated 10 TKB to V and the two have signed terms for the payment of `label1`: "if the chain's gateway records
-- this payment of 10 of the payment token to U's address, execute that allocation".
-- D has allocated 10 TKB to the gateway and signed a request to deposit them for `recipientAddr`.
-- U has said it accepts withdrawals.
fixture : Script F
fixture = fixtureWith Honest

fixtureWith : Naming -> Script F
fixtureWith naming = do
  [operator, confirmer, builder, reader, registry, gateway, u, v, d] <-
    mapA allocateParty ["Operator", "Confirmer", "Builder", "Reader", "Registry", "Gateway", "U", "V", "D"]
  proposal <- submit (actAs [operator, gateway]) $ createCmd ChainProposal with
    chainId = 770101; genesisHash = stubHash0; genesisStateRoot = stubStateRoot0; programVK = stubVK; rootC = stubRoot
    rulesHash = stubRoot; gasCap = 30000000; gatewayAddress = gatewayAddr; ..
  chain <- submit confirmer $ exerciseCmd proposal Accept
  rulesCid <- submit registry $ createCmd TokenRules with admin = registry
  Some rules <- queryDisclosure registry rulesCid
  let reg = Reg with ..
  token <- makeToken operator confirmer gateway builder 770101 reg wTkb
  let termsOperator = case naming of BuilderAsOperator -> builder; _ -> operator
  let termsConfirmer = case naming of BuilderAsConfirmer -> builder; _ -> confirmer
  terms <- makeTerms operator confirmer builder reg u v termsOperator termsConfirmer label1
  let dvp1 = paymentId u v label1
  let dvp2 = paymentId u v label2
  deposit <- makeDeposit operator confirmer gateway builder 770101 reg d gateway operator "TKB" deposit1 recipientAddr
  acceptance <- submit u $ createCmd WithdrawalAcceptance with
    party = u; chainId = 770101; operator; confirmer; gateway; builder
  pure F with ..

-- The gateway's registration of a token: this Canton instrument (TKB of the registry) is what the EVM token wraps.
makeToken : Party -> Party -> Party -> Party -> Int -> Reg -> Text -> Script (ContractId GatewayToken)
makeToken operator confirmer gateway builder chainId reg evmToken = makeTokenOf "TKB" operator confirmer gateway builder chainId reg evmToken

-- A wrapped token of the instrument called `inst`.
makeTokenOf : Text -> Party -> Party -> Party -> Party -> Int -> Reg -> Text -> Script (ContractId GatewayToken)
makeTokenOf inst operator confirmer gateway builder chainId reg evmToken = do
  let instrumentId = H.InstrumentId with admin = reg.registry; id = inst
  p <- submit (actAs [operator, gateway]) $ createCmd GatewayTokenProposal with
    factory = toInterfaceContractId reg.rulesCid; ..
  submit confirmer $ exerciseCmd p AcceptToken

-- `sender` allocates `amount` of the instrument to `receiver` (executor `exec`), from a fresh holding of exactly that amount.
allocate : Reg -> Party -> Party -> Party -> Text -> Decimal -> Text -> Script (ContractId Allocation)
allocate reg sender receiver exec inst amount ref = do
  now <- getTime
  let instrument = H.InstrumentId with admin = reg.registry; id = inst
  holding <- submit (actAs [sender, reg.registry]) $ createCmd Token with
    holding = H.HoldingView with owner = sender; instrumentId = instrument; amount; lock = None; meta = emptyMetadata
  let spec = AllocationSpecification with
        settlement = SettlementInfo with
          executor = exec; settlementRef = Reference with id = ref; cid = None
          requestedAt = now; allocateBefore = addRelTime now (days 1); settleBefore = addRelTime now (days 2); meta = emptyMetadata
        transferLegId = "leg"
        transferLeg = TransferLeg with sender; receiver; amount; instrumentId = instrument; meta = emptyMetadata
  r <- submit (actAs sender <> disclose reg.rules) $ exerciseCmd (toInterfaceContractId @AllocationFactory reg.rulesCid) AllocationFactory_Allocate with
    expectedAdmin = reg.registry; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @H.Holding holding]; extraArgs = noExtraArgs
  case r.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "the reference token completes an allocation at once"

-- U allocates 10 TKB to V (executor `exec`), and U and V sign terms for the payment of `label`.
makeTerms : Party -> Party -> Party -> Reg -> Party -> Party -> Party -> Party -> Text -> Script (ContractId DvpTerms)
makeTerms operator confirmer builder reg u v exec conf label = do
  let id = paymentId u v label
  allocation <- allocate reg u v exec "TKB" 10.0 id
  submit (actAs [u, v]) $ createCmd DvpTerms with
    operator = exec; confirmer = conf
    chainId = 770101; dvpId = id; token = tokenAddr; payee = uAddr; amount = tenTokens; ..

-- `depositor` allocates 10 of `inst` to `receiver` (executor `exec`) and signs a request to deposit them for `recipient`.
makeDeposit : Party -> Party -> Party -> Party -> Int -> Reg -> Party -> Party -> Party -> Text -> Text -> Text -> Script (ContractId DepositRequest)
makeDeposit operator confirmer gateway builder chainId reg depositor receiver exec inst id recipient = do
  allocation <- allocate reg depositor receiver exec inst 10.0 id
  submit depositor $ createCmd DepositRequest with depositId = id; ..

-- The builder's submission: it sees the contracts of the legs as the parties' participants hand them over.
asBuilder : F -> SubmitOptions
asBuilder f = actAs f.builder <> readAs [f.operator, f.confirmer, f.gateway, f.u, f.v, f.d, f.registry] <> disclose f.rules

-- What the sidecar's legs call reads: the lines of the legs, in the format of README.md.
line : Text -> Text -> Text -> Text -> Text -> Text -> Text
line kind id token account amount party = T.intercalate "/" [kind, id, token, account, amount, party]

depositLine, paymentLine : Text -> Text
depositLine id = line "deposit" id wTkb recipientAddr "10.0" ""
paymentLine id = line "payment" id tokenAddr uAddr tenTokens ""

withdrawalLine : Text -> Text -> Text -> Party -> Text
withdrawalLine id from amount party = line "withdrawal" id wTkb from amount (toHex (partyToText party))

-- The stub's stand-in for the gateway's storage proof: the recorded lines, as hex. A block that recorded no legs has none.
recordedNodes : [Text] -> [Text]
recordedNodes [] = []
recordedNodes ls = [toHex (T.intercalate "|" ls)]

advanceWith : ContractId ZkChain -> Text -> Text -> [Text] -> [Text] -> [Leg] -> Commands (ContractId ZkChain, ContractId BlockRecord)
advanceWith chain header proof = advanceWithTxs chain header "" proof

advanceWithTxs : ContractId ZkChain -> Text -> Text -> Text -> [Text] -> [Text] -> [Leg] -> Commands (ContractId ZkChain, ContractId BlockRecord)
advanceWithTxs chain header txs proof accountNodes storageNodes legs = exerciseCmd chain Advance with
  headerHex = header; txsHex = txs; proofHex = proof
  gatewayAccountNodes = accountNodes; gatewayStorageNodes = storageNodes; extraGateways = None; ..

-- A good call: the block recorded exactly `recorded`, and the builder attaches `legs`.
advance : ContractId ZkChain -> Text -> [Text] -> [Leg] -> Commands (ContractId ZkChain, ContractId BlockRecord)
advance chain header recorded legs = advanceWith chain header "aa" ["aa"] (recordedNodes recorded) legs

depositLeg : F -> Leg
depositLeg f = DepositLeg with request = f.deposit; token = f.token

paymentLeg : F -> Leg
paymentLeg f = PaymentLeg with terms = f.terms

-- U's withdrawal of 4 TKB, funded from a holding of the gateway's.
withdrawalLeg : F -> ContractId H.Holding -> Leg
withdrawalLeg f holding = WithdrawalLeg with
  id = withdrawalId; token = f.token; from = burnerAddr; amount = 4.0; acceptance = f.acceptance; inputs = [holding]

-- The gateway's custody: a holding of 10 TKB, which only withdrawals draw on.
custody : F -> Script (ContractId H.Holding)
custody f = custodyOf f "TKB"

-- The same for the instrument called `inst`.
custodyOf : F -> Text -> Script (ContractId H.Holding)
custodyOf f inst = do
  c <- submit (actAs [f.gateway, f.registry]) $ createCmd Token with
    holding = H.HoldingView with owner = f.gateway; instrumentId = H.InstrumentId with admin = f.registry; id = inst
                                 amount = 10.0; lock = None; meta = emptyMetadata
  pure (toInterfaceContractId @H.Holding c)

-- A party's holdings of one instrument, as sorted amounts.
holds : Party -> Text -> Script [Decimal]
holds p inst = sort . map (\(_, t) -> t.holding.amount) . filter (\(_, t) -> t.holding.instrumentId.id == inst) <$> query @Token p

-- The chain still stands at its genesis and nothing was written: the contracts of the legs are all still there, and
-- no one holds anything that a leg would have made.
nothingMoved : F -> Script ()
nothingMoved f = do
  [(_, c)] <- query @ZkChain f.operator
  (c.headNumber, c.headHash) === (0, stubHash0)
  query @BlockRecord f.operator >>= \rs -> length rs === 0
  holds f.v "TKB" >>= \xs -> xs === []
  holds f.u "TKB" >>= \xs -> xs === []
  Some _ <- queryContractId f.u f.terms
  Some _ <- queryContractId f.d f.deposit
  pure ()

-- An Advance the chain must refuse, for a reason that contains `why`, and that leaves nothing behind.
refused : Text -> F -> Commands a -> Script ()
refused why f cmds = refusedAs why f (asBuilder f) cmds

refusedAs : Text -> F -> SubmitOptions -> Commands a -> Script ()
refusedAs why f as cmds = do
  r <- trySubmit as cmds
  case r of
    Left e -> assertMsg ("refused, but not for \"" <> why <> "\": " <> show e) (why `T.isInfixOf` show e)
    Right _ -> abort ("the chain committed a block that it should have refused (" <> why <> ")")
  nothingMoved f

-- What the chain says when the legs attached are not the ones the block recorded.
notRecorded : Text
notRecorded = "the legs are not the ones the block recorded"

-- A block of no legs that the chain must refuse.
refusedBlock : Text -> Text -> Text -> Script ()
refusedBlock why header proof = do
  f <- fixture
  refused why f $ advanceWith f.chain header proof ["aa"] [] []

-- A good block carrying terms that name other parties than the chain's.
refusedNaming : Text -> Naming -> Script ()
refusedNaming why naming = do
  f <- fixtureWith naming
  refused why f $ advance f.chain "01" [paymentLine f.dvp1] [paymentLeg f]

-- The call bodies are the hex of the ASCII line: lowercase, no newline.
testHexOfTheAsciiLine : Script ()
testHexOfTheAsciiLine = do
  toHex "ok 5,;" === "6f6b20352c3b"
  fromHex "6f6b20352c3b" === "ok 5,;"
  fromHex (toHex "no the proof does not verify") === "no the proof does not verify"
  toHex "" === ""
  fromHex "" === ""
  fromHex "6f6" === ""      -- an odd number of digits is not a body
  fromHex "6g" === ""       -- nor is a non-hex digit
  fromHex "6F6B" === ""     -- nor is a capital letter: the body is lowercase
  fromHex "6f6B" === ""
  fromHex "6" === ""

-- The hand-written version of toHex that Zk.Hex had in 0.1.0, kept here as the reference the builtin is checked against.
oldToHex : Text -> Text
oldToHex s = T.implode [hexDigits !! (c / 16) <> hexDigits !! (c % 16) | c <- T.toCodePoints s]

-- Zk.Hex.toHex is the builtin now; it must give the bytes of every line the old one did: printable ASCII, a party id, nothing.
testBuiltinToHexEqualsTheOldOne : Script ()
testBuiltinToHexEqualsTheOldOne = do
  let printable = T.fromCodePoints [32 .. 126]
      partyId = "Builder::1220a1b2c3d4e5f60718293a4b5c6d7e8f9a0b1c2d3e4f5061728394a5b6c7d8e9f0"
  alice <- allocateParty "Alice"
  forA_ (printable :: partyId :: partyToText alice :: "" :: T.explode printable) $ \t -> do
    toHex t === oldToHex t
    C.toHex t === oldToHex t
    fromHex (toHex t) === t
  toHex printable === mconcat [oldToHex (T.fromCodePoints [c]) | c <- [32 .. 126]]

-- The sidecar reads a Canton amount as digits, a point and up to ten more digits. This is how Daml writes a Decimal.
testTheFormInWhichDamlWritesADecimal : Script ()
testTheFormInWhichDamlWritesADecimal = do
  show (10.0 : Decimal) === "10.0"
  show (4.0 : Decimal) === "4.0"
  show (0.0000000001 : Decimal) === "0.0000000001"
  show (123456.5 : Decimal) === "123456.5"
  show (0.25 : Decimal) === "0.25"

testAcceptCreatesChain : Script ()
testAcceptCreatesChain = do
  f <- fixture
  [(_, c)] <- query @ZkChain f.operator
  (c.headNumber, c.headHash, c.programVK, c.rootC, c.gasCap) === (0, stubHash0, stubVK, stubRoot, 30000000)
  (c.gateway, c.gatewayAddress) === (f.gateway, gatewayAddr)
  c.builder === f.builder
  -- the confirmer's and the gateway's signatures are what make the pins binding: the operator cannot make or accept for them
  let proposal = ChainProposal with
        operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; reader = f.reader
        chainId = 1; genesisHash = stubHash0; genesisStateRoot = stubStateRoot0; programVK = stubVK; rootC = stubRoot
        rulesHash = stubRoot; gasCap = 1; gatewayAddress = gatewayAddr
  submitMustFail f.operator $ createCmd proposal
  p <- submit (actAs [f.operator, f.gateway]) $ createCmd proposal
  submitMustFail f.operator $ exerciseCmd p Accept
  submitMustFail f.gateway $ exerciseCmd p Accept
  -- the gateway's address is an EVM address
  submitMustFail (actAs [f.operator, f.gateway]) $ createCmd (proposal with gatewayAddress = "a7")

-- The registration of a token is the decision of the operator, the confirmer and the gateway together.
testRegisteringATokenNeedsAllThree : Script ()
testRegisteringATokenNeedsAllThree = do
  f <- fixture
  Some t <- queryContractId f.operator f.token
  (t.evmToken, t.instrumentId.id, t.instrumentId.admin) === (wTkb, "TKB", f.registry)
  let token = GatewayToken with
        operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; chainId = 770101
        evmToken = wTkb; instrumentId = t.instrumentId; factory = t.factory
  forA_ [[f.operator], [f.operator, f.gateway], [f.operator, f.confirmer], [f.confirmer, f.gateway]] $ \ps ->
    submitMustFail (actAs ps) $ createCmd token
  -- an EVM token is 20 bytes of hex
  submitMustFail (actAs [f.operator, f.gateway]) $ createCmd GatewayTokenProposal with
    operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; chainId = 770101
    evmToken = "33"; instrumentId = t.instrumentId; factory = t.factory

-- A block that recorded no legs needs none, and commits with none.
testABlockOfNoLegsCommits : Script ()
testABlockOfNoLegsCommits = do
  f <- fixture
  (_, _) <- submit (asBuilder f) $ advance f.chain "01" [] []
  [(_, c)] <- query @ZkChain f.operator
  (c.headNumber, c.headHash) === (1, stubHash1)
  [(_, r)] <- query @BlockRecord f.reader      -- the reader party sees the record
  (r.number, r.blockHash, r.parentHash, r.proofHex) === (1, stubHash1, stubHash0, "aa")

testBlocksChainOn : Script ()
testBlocksChainOn = do
  f <- fixture
  (c1, _) <- submit (asBuilder f) $ advance f.chain "01" [] []
  (_, _) <- submit (asBuilder f) $ advance c1 "11" [] []
  rs <- query @BlockRecord f.reader
  sort [r.number | (_, r) <- rs] === [1, 2]

-- A deposit: the depositor's allocation is executed, so the gateway holds the 10 TKB; the request is used up.
testADepositSettles : Script ()
testADepositSettles = do
  f <- fixture
  (_, _) <- submit (asBuilder f) $ advance f.chain "01" [depositLine deposit1] [depositLeg f]
  holds f.gateway "TKB" >>= \xs -> xs === [10.0]
  None <- queryContractId f.d f.deposit
  [(_, c)] <- query @ZkChain f.operator
  c.headNumber === 1

-- A withdrawal: the gateway pays 4 TKB from its custody to U, who has said it accepts; the change stays with the gateway.
testAWithdrawalSettles : Script ()
testAWithdrawalSettles = do
  f <- fixture
  holding <- custody f
  (_, _) <- submit (asBuilder f) $ advance f.chain "01" [withdrawalLine withdrawalId burnerAddr "4.0" f.u] [withdrawalLeg f holding]
  holds f.u "TKB" >>= \xs -> xs === [4.0]
  holds f.gateway "TKB" >>= \xs -> xs === [6.0]
  -- the acceptance is standing: it is still there for the next withdrawal
  Some _ <- queryContractId f.u f.acceptance
  pure ()

-- A registry that completes a transfer at once (the reference token does so when the receiver is the sender): the
-- gateway accepting withdrawals for itself reaches the other branch of `Receive`.
testAWithdrawalThatTheRegistryCompletesAtOnceSettles : Script ()
testAWithdrawalThatTheRegistryCompletesAtOnceSettles = do
  f <- fixture
  holding <- custody f
  own <- submit f.gateway $ createCmd WithdrawalAcceptance with
    party = f.gateway; chainId = 770101; operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder
  (_, _) <- submit (asBuilder f) $ advance f.chain "01" [withdrawalLine withdrawalId burnerAddr "4.0" f.gateway] [(withdrawalLeg f holding) with acceptance = own]
  holds f.gateway "TKB" >>= \xs -> xs === [4.0, 6.0]

-- A payment: the allocation named in the terms is executed.
testAPaymentSettles : Script ()
testAPaymentSettles = do
  f <- fixture
  (_, _) <- submit (asBuilder f) $ advance f.chain "01" [paymentLine f.dvp1] [paymentLeg f]
  holds f.v "TKB" >>= \xs -> xs === [10.0]
  None <- queryContractId f.u f.terms           -- the terms are consumed
  pure ()

-- One block, one leg of each kind, in the order the block recorded them.
testThreeLegsInOrderSettle : Script ()
testThreeLegsInOrderSettle = do
  f <- fixture
  holding <- custody f
  let recorded = [depositLine deposit1, paymentLine f.dvp1, withdrawalLine withdrawalId burnerAddr "4.0" f.u]
  (_, _) <- submit (asBuilder f) $ advance f.chain "01" recorded [depositLeg f, paymentLeg f, withdrawalLeg f holding]
  holds f.v "TKB" >>= \xs -> xs === [10.0]
  holds f.u "TKB" >>= \xs -> xs === [4.0]
  holds f.gateway "TKB" >>= \xs -> xs === [6.0, 10.0]

-- The order is part of what the block recorded.
testTwoLegsSwappedAreRefused : Script ()
testTwoLegsSwappedAreRefused = do
  f <- fixture
  refused notRecorded f $ advance f.chain "01" [paymentLine f.dvp1, depositLine deposit1] [depositLeg f, paymentLeg f]

-- A leg the block recorded is missing from the attached ones.
testAMissingLegIsRefused : Script ()
testAMissingLegIsRefused = do
  f <- fixture
  refused notRecorded f $ advance f.chain "01" [paymentLine f.dvp1] []
  refused notRecorded f $ advance f.chain "01" [depositLine deposit1, paymentLine f.dvp1] [paymentLeg f]

-- Terms attached to a block that recorded no payment for them.
testAnExtraLegIsRefused : Script ()
testAnExtraLegIsRefused = do
  f <- fixture
  refused notRecorded f $ advance f.chain "01" [] [paymentLeg f]
  refused notRecorded f $ advance f.chain "01" [depositLine deposit1] [depositLeg f, paymentLeg f]

-- Any field of a recorded leg that differs from the attached contract's: id, token, account, amount.
testALegWithAnotherFieldIsRefused : Script ()
testALegWithAnotherFieldIsRefused = do
  f <- fixture
  refused notRecorded f $ advance f.chain "01" [paymentLine f.dvp2] [paymentLeg f]                              -- another payment id
  refused notRecorded f $ advance f.chain "01" [line "payment" f.dvp1 wTkb uAddr tenTokens ""] [paymentLeg f]   -- another token
  refused notRecorded f $ advance f.chain "01" [line "payment" f.dvp1 tokenAddr burnerAddr tenTokens ""] [paymentLeg f]   -- another payee
  refused notRecorded f $ advance f.chain "01" [line "payment" f.dvp1 tokenAddr uAddr fiveTokens ""] [paymentLeg f]       -- another amount
  refused notRecorded f $ advance f.chain "01" [line "deposit" deposit1 wTkb burnerAddr "10.0" ""] [depositLeg f]      -- another recipient
  refused notRecorded f $ advance f.chain "01" [line "deposit" deposit1 wTkb recipientAddr "9.0" ""] [depositLeg f]    -- another amount
  refused notRecorded f $ advance f.chain "01" [line "deposit" (idOf "d2") wTkb recipientAddr "10.0" ""] [depositLeg f] -- another deposit id
  refused notRecorded f $ advance f.chain "01" [line "payment" f.dvp1 tokenAddr uAddr tenTokens ""] [depositLeg f]        -- another kind

-- The builder sends a withdrawal's id, burner and amount as text. If it lies about any, the hash differs.
testAWithdrawalTheBuilderMisreportsIsRefused : Script ()
testAWithdrawalTheBuilderMisreportsIsRefused = do
  f <- fixture
  holding <- custody f
  let leg = withdrawalLeg f holding
  let recorded = withdrawalLine withdrawalId burnerAddr "4.0" f.u
  refused notRecorded f $ advance f.chain "01" [recorded] [leg with amount = 5.0]
  refused notRecorded f $ advance f.chain "01" [recorded] [leg with from = recipientAddr]
  refused notRecorded f $ advance f.chain "01" [recorded] [leg with id = idOf "c2"]
  holds f.gateway "TKB" >>= \xs -> xs === [10.0]

-- An acceptance of another party than the one the block named.
testAnAcceptanceOfAnotherPartyIsRefused : Script ()
testAnAcceptanceOfAnotherPartyIsRefused = do
  f <- fixture
  holding <- custody f
  other <- submit f.v $ createCmd WithdrawalAcceptance with
    party = f.v; chainId = 770101; operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder
  refused notRecorded f $ advance f.chain "01" [withdrawalLine withdrawalId burnerAddr "4.0" f.u] [(withdrawalLeg f holding) with acceptance = other]

-- The amount of a withdrawal may not be zero or negative: it could not be a line the EVM wrote.
testAWithdrawalOfNothingIsRefused : Script ()
testAWithdrawalOfNothingIsRefused = do
  f <- fixture
  holding <- custody f
  forA_ [0.0, -4.0] $ \amount ->
    refused "the withdrawal is of no amount" f $ advance f.chain "01" [withdrawalLine withdrawalId burnerAddr (show amount) f.u] [(withdrawalLeg f holding) with amount]

-- The gateway's custody must cover the withdrawal: the registry's own check refuses it.
testAWithdrawalMoreThanTheCustodyIsRefused : Script ()
testAWithdrawalMoreThanTheCustodyIsRefused = do
  f <- fixture
  holding <- custody f
  refused "'input amount' is less than 'transfer.amount'" f $ advance f.chain "01" [withdrawalLine withdrawalId burnerAddr "11.0" f.u] [(withdrawalLeg f holding) with amount = 11.0]

-- The same payment id twice cannot be two payments: the block records a payment once, so one set of terms settles once.
testTermsSettleOnlyOnce : Script ()
testTermsSettleOnlyOnce = do
  f <- fixture
  (c1, _) <- submit (asBuilder f) $ advance f.chain "01" [paymentLine f.dvp1] [paymentLeg f]
  submitMustFail (asBuilder f) $ advance c1 "11" [paymentLine f.dvp1] [paymentLeg f]
  holds f.v "TKB" >>= \xs -> xs === [10.0]

-- Two honest payments to one address settle in the same block: nothing ties a block to one leg per holder.
testTwoPaymentsToOneAddressSettleInOneBlock : Script ()
testTwoPaymentsToOneAddressSettleInOneBlock = do
  f <- fixture
  second <- makeTerms f.operator f.confirmer f.builder f.reg f.u f.v f.operator f.confirmer label2
  (_, _) <- submit (asBuilder f) $ advance f.chain "01" [paymentLine f.dvp1, paymentLine f.dvp2] [paymentLeg f, PaymentLeg with terms = second]
  holds f.v "TKB" >>= \xs -> xs === [10.0, 10.0]

-- Terms are tied to the two parties who signed them. A builder with a token and a second party of its own cannot sign
-- terms that carry the id V pays against, and terms of its own carry another id, so they are not the payment recorded.
testTermsOfOtherPartiesCannotStandInForAPayment : Script ()
testTermsOfOtherPartiesCannotStandInForAPayment = do
  f <- fixture
  Some old <- queryContractId f.u f.terms
  ownRulesCid <- submit f.builder $ createCmd TokenRules with admin = f.builder
  Some ownRules <- queryDisclosure f.builder ownRulesCid
  let own = Reg with registry = f.builder; rulesCid = ownRulesCid; rules = ownRules
  b2 <- allocateParty "Builder2"
  allocation <- allocate own f.builder b2 f.operator "TKB" 10.0 f.dvp1
  let forged = DvpTerms with
        u = f.builder; v = b2; operator = f.operator; confirmer = f.confirmer; builder = f.builder
        chainId = 770101; label = label1; dvpId = f.dvp1; token = tokenAddr; payee = uAddr; amount = tenTokens; allocation
  -- the id of U and V's payment cannot be put on terms of any other pair
  submitMustFail (actAs [f.builder, b2]) $ createCmd forged
  forA_ [(f.u, f.d), (f.d, f.v), (f.v, f.u)] $ \(u, v) ->
    submitMustFail (actAs [u, v]) $ createCmd (forged with u = u; v = v; allocation = old.allocation)
  -- terms of its own carry the id of its own pair, which the block did not record
  mine <- submit (actAs [f.builder, b2]) $ createCmd (forged with dvpId = paymentId f.builder b2 label1)
  refused notRecorded f $ advance f.chain "01" [paymentLine f.dvp1] [PaymentLeg with terms = mine]

-- A leg settles in a later block just as in the first: the sidecar is asked about that block's own root and number.
testALegSettlesInALaterBlock : Script ()
testALegSettlesInALaterBlock = do
  f <- fixture
  (c1, _) <- submit (asBuilder f) $ advance f.chain "01" [] []
  (_, _) <- submit (asBuilder f) $ advance c1 "11" [paymentLine f.dvp1] [paymentLeg f]
  holds f.v "TKB" >>= \xs -> xs === [10.0]
  [(_, c)] <- query @ZkChain f.operator
  (c.headNumber, c.headStateRoot) === (2, stubStateRoot2)

-- The proof checks Advance made before are all still made.
testRefusesWrongParent : Script ()
testRefusesWrongParent = refusedBlock "parent is not the chain's head" "02" "aa"

testRefusesWrongNumber : Script ()
testRefusesWrongNumber = refusedBlock "number is not the head's plus one" "03" "aa"

testRefusesOverTheGasCap : Script ()
testRefusesOverTheGasCap = refusedBlock "over the gas cap" "04" "aa"

testRefusesWrongProgramKey : Script ()
testRefusesWrongProgramKey = refusedBlock "another program" "05" "aa"

testRefusesWrongZiskRelease : Script ()
testRefusesWrongZiskRelease = refusedBlock "another ZisK release" "06" "aa"

testRefusesAFailingProof : Script ()
testRefusesAFailingProof = refusedBlock "the proof does not verify" "01" "ba"

-- The gateway's proofs are checked by the sidecar, under the proven block's state root.
testRefusesAFailingAccountProof : Script ()
testRefusesAFailingAccountProof = do
  f <- fixture
  refused "the account proof does not verify" f $ advanceWith f.chain "01" "aa" ["ba"] [] []

testRefusesAFailingStorageProof : Script ()
testRefusesAFailingStorageProof = do
  f <- fixture
  refused "the storage proof does not verify" f $ advanceWith f.chain "01" "aa" ["aa"] ["ba"] []

-- Daml checks the answer is about the root, the number and the gateway it asked about, and the number of legs it sent.
testRefusesAnAnswerForAnotherBlockOrGatewayOrCount : Script ()
testRefusesAnAnswerForAnotherBlockOrGatewayOrCount = do
  f <- fixture
  forA_ ["e1", "e2", "e3", "e4"] $ \tag ->
    refused (notRecorded <> ": ok") f $ advanceWith f.chain "01" "aa" [tag] (recordedNodes [paymentLine f.dvp1]) [paymentLeg f]

-- Advance does not check the hex of the block or of the gateway's proofs itself (the check ran one character at a time, and
-- was most of the time Advance took); the sidecar of every confirmer does, more strictly (lowercase, whole bytes), answers
-- "malformed input", and Canton refuses the transaction if the answers differ. The stub answers the same way.
-- The lists are joined with ';' before the sidecar sees them, so a list holding one empty string reads as no nodes, the
-- same as []: what commits and what is recorded are the same for both.
testAnEmptyNodeAloneReadsAsNoNodes : Script ()
testAnEmptyNodeAloneReadsAsNoNodes = do
  f <- fixture
  (_, _) <- submit (asBuilder f) $ advanceWith f.chain "01" "aa" [""] [] []
  [(_, c)] <- query @ZkChain f.operator
  (c.headNumber, c.headHash) === (1, stubHash1)      -- the values testABlockOfNoLegsCommits gets with no nodes at all
  [(_, r)] <- query @BlockRecord f.reader
  (r.number, r.blockHash, r.proofHex) === (1, stubHash1, "aa")

testRefusesProofsThatAreNotHex : Script ()
testRefusesProofsThatAreNotHex = do
  f <- fixture
  let malformedBlock = "the sidecar refused the block: no malformed input"
      malformedNodes = notRecorded <> ": no malformed input"
  -- the header, the transactions and the proof: an odd length, a capital letter, another character, a comma
  refused malformedBlock f $ advanceWith f.chain "01" "aaa" ["aa"] [] []
  refused malformedBlock f $ advanceWith f.chain "01" "AA" ["aa"] [] []
  refused malformedBlock f $ advanceWith f.chain "0g" "aa" ["aa"] [] []
  refused malformedBlock f $ advanceWith f.chain "01" "aa,aa" ["aa"] [] []
  refused malformedBlock f $ advanceWith f.chain "0" "aa" ["aa"] [] []
  refused malformedBlock f $ advanceWithTxs f.chain "01" "0" "aa" ["aa"] [] []
  refused malformedBlock f $ advanceWithTxs f.chain "01" "AB" "aa" ["aa"] [] []
  refused malformedBlock f $ advanceWithTxs f.chain "01" "nothex" "aa" ["aa"] [] []
  -- the gateway's nodes: the same, and an empty node
  refused malformedNodes f $ advanceWith f.chain "01" "aa" ["a,a"] [] []
  refused malformedNodes f $ advanceWith f.chain "01" "aa" ["aa"] ["nothex"] []
  refused malformedNodes f $ advanceWith f.chain "01" "aa" ["aa;"] [] []
  refused malformedNodes f $ advanceWith f.chain "01" "aa" ["aa;;aa"] [] []
  refused malformedNodes f $ advanceWith f.chain "01" "aa" ["AA"] [] []
  refused malformedNodes f $ advanceWith f.chain "01" "aa" ["a"] [] []
  refused malformedNodes f $ advanceWith f.chain "01" "aa" ["aa"] ["aa", "b"] []

-- Terms that name another operator, or another confirmer, than the chain's are not settled by it, even when
-- the builder (who is a controller of `Advance`) stands in the named role.
testRefusesTermsNamingAnotherOperator : Script ()
testRefusesTermsNamingAnotherOperator = refusedNaming "names another operator" BuilderAsOperator

testRefusesTermsNamingAnotherConfirmer : Script ()
testRefusesTermsNamingAnotherConfirmer = refusedNaming "names another confirmer" BuilderAsConfirmer

-- Every kind of contract that names another chain, operator, confirmer or gateway than this chain's is refused.
testRefusesContractsOfAnotherChain : Script ()
testRefusesContractsOfAnotherChain = do
  f <- fixture
  Some old <- queryContractId f.u f.terms
  other <- submit (actAs [f.u, f.v]) $ createCmd DvpTerms with
    u = f.u; v = f.v; operator = f.operator; confirmer = f.confirmer; builder = f.builder
    chainId = 2; label = label1; dvpId = f.dvp1; token = tokenAddr; payee = uAddr; amount = tenTokens; allocation = old.allocation
  refused "is for another chain" f $ advance f.chain "01" [paymentLine f.dvp1] [PaymentLeg with terms = other]
  -- a deposit request for another chain, and one that names another gateway party (the builder) than the chain's
  d2 <- makeDeposit f.operator f.confirmer f.gateway f.builder 2 f.reg f.d f.gateway f.operator "TKB" deposit1 recipientAddr
  refused "is for another chain" f $ advance f.chain "01" [depositLine deposit1] [DepositLeg with request = d2; token = f.token]
  d3 <- makeDeposit f.operator f.confirmer f.builder f.builder 770101 f.reg f.d f.builder f.operator "TKB" deposit1 recipientAddr
  refused "names another gateway" f $ advance f.chain "01" [depositLine deposit1] [DepositLeg with request = d3; token = f.token]
  -- an acceptance for another chain, and a token registered for another chain
  a2 <- submit f.u $ createCmd WithdrawalAcceptance with
    party = f.u; chainId = 2; operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder
  holding <- custody f
  refused "is for another chain" f $ advance f.chain "01" [withdrawalLine withdrawalId burnerAddr "4.0" f.u] [(withdrawalLeg f holding) with acceptance = a2]
  t2 <- makeToken f.operator f.confirmer f.gateway f.builder 2 f.reg wTkb
  refused "is for another chain" f $ advance f.chain "01" [depositLine deposit1] [DepositLeg with request = f.deposit; token = t2]

-- A deposit of another instrument than the one the token wraps.
testRefusesADepositOfAnotherInstrument : Script ()
testRefusesADepositOfAnotherInstrument = do
  f <- fixture
  other <- makeDeposit f.operator f.confirmer f.gateway f.builder 770101 f.reg f.d f.gateway f.operator "TKC" deposit1 recipientAddr
  refused "of another instrument" f $ advance f.chain "01" [depositLine deposit1] [DepositLeg with request = other; token = f.token]

-- A deposit that is not an allocation to the gateway, with the operator as executor: another receiver, another executor.
testRefusesADepositNotToTheGateway : Script ()
testRefusesADepositNotToTheGateway = do
  f <- fixture
  toV <- makeDeposit f.operator f.confirmer f.gateway f.builder 770101 f.reg f.d f.v f.operator "TKB" deposit1 recipientAddr
  refused "not from the depositor to the gateway" f $ advance f.chain "01" [depositLine deposit1] [DepositLeg with request = toV; token = f.token]
  byBuilder <- makeDeposit f.operator f.confirmer f.gateway f.builder 770101 f.reg f.d f.gateway f.builder "TKB" deposit1 recipientAddr
  refused "executor is not the operator" f $ advance f.chain "01" [depositLine deposit1] [DepositLeg with request = byBuilder; token = f.token]

-- A token whose factory belongs to another registry than the one its instrument names: the factory refuses, because the
-- withdrawal names the instrument's admin as the one it expects. With the token's own factory the same block settles.
testRefusesATokenWhoseFactoryIsAnotherAdmins : Script ()
testRefusesATokenWhoseFactoryIsAnotherAdmins = do
  f <- fixture
  holding <- custody f
  registry2 <- allocateParty "Registry2"
  rules2 <- submit registry2 $ createCmd TokenRules with admin = registry2
  Some disclosed2 <- queryDisclosure registry2 rules2
  Some t <- queryContractId f.operator f.token
  p <- submit (actAs [f.operator, f.gateway]) $ createCmd GatewayTokenProposal with
    operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; chainId = 770101
    evmToken = wTkb; instrumentId = t.instrumentId; factory = toInterfaceContractId rules2
  bad <- submit f.confirmer $ exerciseCmd p AcceptToken
  let recorded = [withdrawalLine withdrawalId burnerAddr "4.0" f.u]
  refusedAs "'expectedAdmin' is not equal" f (asBuilder f <> disclose disclosed2) $ advance f.chain "01" recorded [(withdrawalLeg f holding) with token = bad]
  (_, _) <- submit (asBuilder f <> disclose disclosed2) $ advance f.chain "01" recorded [withdrawalLeg f holding]
  holds f.u "TKB" >>= \xs -> xs === [4.0]

-- The settlement choices work only inside Advance. Lock and Receive need the operator, the confirmer and the gateway
-- together, Settle the operator and the confirmer together: no one of them alone, and not the builder, can settle.
testSettleOutsideAdvanceIsRefused : Script ()
testSettleOutsideAdvanceIsRefused = do
  f <- fixture
  holding <- custody f
  let readers = readAs [f.operator, f.confirmer, f.gateway, f.u, f.v, f.d, f.registry, f.builder] <> disclose f.rules
  forA_ [f.operator, f.confirmer, f.builder, f.u, f.v] $ \p ->
    submitMustFail (actAs p <> readers) $ exerciseCmd f.terms Settle
  forA_ [[f.operator], [f.confirmer], [f.gateway], [f.builder], [f.d], [f.operator, f.confirmer], [f.operator, f.gateway], [f.confirmer, f.gateway]] $ \ps -> do
    submitMustFail (actAs ps <> readers) $ exerciseCmd f.deposit Lock
    submitMustFail (actAs ps <> readers) $ exerciseCmd f.acceptance Receive with
      token = f.token; amount = 4.0; inputs = [holding]
  nothingMoved f
  -- Those were refused for lack of authority, not for lack of sight: the three together, who meet only inside Advance
  -- on purpose, can do each of the three.
  submit (actAs [f.operator, f.confirmer, f.gateway] <> readers) $ exerciseCmd f.deposit Lock
  submit (actAs [f.operator, f.confirmer, f.gateway] <> readers) $ exerciseCmd f.acceptance Receive with
    token = f.token; amount = 4.0; inputs = [holding]
  submit (actAs [f.operator, f.confirmer] <> readers) $ exerciseCmd f.terms Settle
  holds f.u "TKB" >>= \xs -> xs === [4.0]
  holds f.v "TKB" >>= \xs -> xs === [10.0]

-- Only the builder advances the chain.
testOnlyTheBuilderAdvances : Script ()
testOnlyTheBuilderAdvances = do
  f <- fixture
  forA_ [f.operator, f.confirmer, f.gateway, f.reader] $ \p ->
    submitMustFail (actAs p <> readAs [f.builder, f.u, f.v, f.d, f.registry] <> disclose f.rules) $
      advance f.chain "01" [paymentLine f.dvp1] [paymentLeg f]
  nothingMoved f

-- The payment id is the EVM's id itself, in one form only: 64 lowercase hex digits. The token and the payee are 20-byte
-- addresses, the amount 64 digits and not zero.
testTermsInTheWrongFormAreRefused : Script ()
testTermsInTheWrongFormAreRefused = do
  f <- fixture
  Some old <- queryContractId f.u f.terms
  let terms = DvpTerms with
        u = f.u; v = f.v; operator = f.operator; confirmer = f.confirmer; builder = f.builder
        chainId = 770101; label = label1; dvpId = f.dvp1; token = tokenAddr; payee = uAddr; amount = tenTokens; allocation = old.allocation
  _ <- submit (actAs [f.u, f.v]) $ createCmd terms
  forA_ [ terms with dvpId = "dvp-1"
        , terms with dvpId = T.asciiToUpper f.dvp1
        , terms with label = label2
        , terms with dvpId = ""
        , terms with dvpId = mconcat (replicate 31 "a1")
        , terms with token = "11"
        , terms with payee = T.asciiToUpper gatewayAddr
        , terms with payee = tokenAddr <> "00"
        , terms with amount = mconcat (replicate 64 "0")
        , terms with amount = "ff"
        , terms with amount = "" ] $ \bad ->
    submitMustFail (actAs [f.u, f.v]) $ createCmd bad

-- A deposit's id and recipient are in the EVM's form too.
testADepositRequestInTheWrongFormIsRefused : Script ()
testADepositRequestInTheWrongFormIsRefused = do
  f <- fixture
  Some old <- queryContractId f.d f.deposit
  let request = DepositRequest with
        operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; chainId = 770101
        depositor = f.d; depositId = deposit1; recipient = recipientAddr; allocation = old.allocation
  forA_ [ request with depositId = "d1"
        , request with recipient = "44"
        , request with recipient = T.asciiToUpper gatewayAddr ] $ \bad ->
    submitMustFail f.d $ createCmd bad

-- The gas cap: the operator proposes, the confirmer accepts, and the chain's other fields stay as they were.

-- The operator proposes `cap` and the confirmer accepts it on `chain`.
raiseCap : F -> ContractId ZkChain -> Int -> Script (ContractId ZkChain)
raiseCap f chain cap = do
  p <- submit f.operator $ exerciseCmd chain ProposeGasCap with newCap = cap
  submit f.confirmer $ exerciseCmd p AcceptGasCap with chain

testGasCapProposalSetsTheCap : Script ()
testGasCapProposalSetsTheCap = do
  f <- fixture
  [(_, before)] <- query @ZkChain f.operator
  chain <- raiseCap f f.chain 60000000
  [(cid, after)] <- query @ZkChain f.operator
  cid === chain
  after === before with gasCap = 60000000

testSetGasCapNeedsTheOperatorAndTheConfirmer : Script ()
testSetGasCapNeedsTheOperatorAndTheConfirmer = do
  f <- fixture
  let set = exerciseCmd f.chain SetGasCap with newCap = 60000000
  submitMustFail f.operator set
  submitMustFail f.confirmer set
  submitMustFail (actAs f.builder <> readAs [f.operator, f.confirmer]) set
  submitMustFail (actAs f.gateway) set
  submitMustFail (actAs [f.operator, f.gateway]) set
  chain <- submit (actAs [f.operator, f.confirmer]) set
  [(cid, c)] <- query @ZkChain f.operator
  (cid, c.gasCap) === (chain, 60000000)

-- Only the operator proposes, and only the confirmer accepts. A proposal is made on the chain's contract and cannot be created by itself.
testGasCapProposalAuthorizationAndChain : Script ()
testGasCapProposalAuthorizationAndChain = do
  f <- fixture
  now <- getTime
  let direct = GasCapProposal with operator = f.operator; confirmer = f.confirmer; reader = f.reader; chainId = 770101; newCap = 60000000; proposedAt = now
  forA_ [actAs f.operator, actAs f.confirmer, actAs f.builder, actAs [f.operator, f.gateway]] $ \who ->
    submitMustFail who $ createCmd direct
  submitMustFail f.confirmer $ exerciseCmd f.chain ProposeGasCap with newCap = 60000000
  submitMustFail f.builder $ exerciseCmd f.chain ProposeGasCap with newCap = 60000000
  submitMustFail f.operator $ exerciseCmd f.chain ProposeGasCap with newCap = 0
  p <- submit f.operator $ exerciseCmd f.chain ProposeGasCap with newCap = 60000000
  submitMustFail f.operator $ exerciseCmd p AcceptGasCap with chain = f.chain
  submitMustFail (actAs f.builder <> readAs [f.operator, f.confirmer]) $ exerciseCmd p AcceptGasCap with chain = f.chain
  -- the chain's contract stays: proposing does not consume it
  [(cid, _)] <- query @ZkChain f.operator
  cid === f.chain

testGasCapBounds : Script ()
testGasCapBounds = do
  f <- fixture
  let bad why cap = do
        p <- submit f.operator $ exerciseCmd f.chain ProposeGasCap with newCap = cap
        r <- trySubmit f.confirmer $ exerciseCmd p AcceptGasCap with chain = f.chain
        case r of
          Left e -> assertMsg ("refused, but not for \"" <> why <> "\": " <> show e) (why `T.isInfixOf` show e)
          Right _ -> abort ("the cap " <> show cap <> " was accepted")
  -- from 30M: the same, lower, and more than double
  bad "must be above the current one" 30000000
  bad "must be above the current one" 29999999
  bad "must be above the current one" 1
  bad "at most double" 60000001
  bad "at most double" 600000000
  -- exactly double is accepted, and then doubling again, up to the ceiling
  c1 <- raiseCap f f.chain 60000000
  c2 <- raiseCap f c1 120000000
  c3 <- raiseCap f c2 240000000
  Some c <- queryContractId f.operator c3
  c.gasCap === 240000000
  -- 2x of 240M is 480M: over the ceiling. The ceiling itself is accepted, and nothing goes past it
  let tooHigh at cap = do
        p <- submit f.operator $ exerciseCmd at ProposeGasCap with newCap = cap
        submitMustFail f.confirmer $ exerciseCmd p AcceptGasCap with chain = at
  tooHigh c3 300000001
  tooHigh c3 480000000
  c4 <- raiseCap f c3 300000000
  Some top <- queryContractId f.operator c4
  top.gasCap === 300000000
  tooHigh c4 300000000
  tooHigh c4 600000000

testGasCapRaiseNeedsTheCurrentContract : Script ()
testGasCapRaiseNeedsTheCurrentContract = do
  f <- fixture
  p <- submit f.operator $ exerciseCmd f.chain ProposeGasCap with newCap = 60000000
  _ <- raiseCap f f.chain 60000000
  -- the old contract is archived: an acceptance on it finds nothing, and no proposal can be made on it
  submitMustFail f.confirmer $ exerciseCmd p AcceptGasCap with chain = f.chain
  submitMustFail f.operator $ exerciseCmd f.chain ProposeGasCap with newCap = 60000000

-- Advance holds a block to the cap in the contract, the old one and the new one.
testAdvanceFollowsTheGasCap : Script ()
testAdvanceFollowsTheGasCap = do
  f <- fixture
  refused "over the gas cap" f $ advanceWith f.chain "07" "aa" ["aa"] [] []
  chain <- raiseCap f f.chain 60000000
  refused "over the gas cap" f $ advanceWith chain "08" "aa" ["aa"] [] []   -- a limit of 60,000,001
  refused "over the gas cap" f $ advanceWith chain "09" "aa" ["aa"] [] []   -- 60,000,001 of gas used
  (next, _) <- submit (asBuilder f) $ advanceWith chain "0a" "aa" ["aa"] [] []
  [(cid, c)] <- query @ZkChain f.operator
  (cid, c.gasCap, c.headNumber, c.headHash) === (next, 60000000, 1, stubHash1)

-- A header over the old cap commits under a raised one, and under the old one only because the cap allowed it.
testALimitOverTheOldCapCommitsAfterTheRaise : Script ()
testALimitOverTheOldCapCommitsAfterTheRaise = do
  f <- fixture
  refused "over the gas cap" f $ advanceWith f.chain "04" "aa" ["aa"] [] []   -- 31M
  chain <- raiseCap f f.chain 60000000
  (_, record) <- submit (asBuilder f) $ advanceWith chain "04" "aa" ["aa"] [] []
  Some r <- queryContractId f.reader record
  r.number === 1

-- The program: the operator proposes, the confirmer accepts, and the chain's other fields stay as they were.

-- The operator and the gateway propose the three values and the confirmer accepts them on `chain`.
switchProgram : F -> ContractId ZkChain -> Text -> Text -> Text -> Script (ContractId ZkChain)
switchProgram f chain vk root rules = do
  p <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd chain ProposeProgram with newProgramVK = vk; newRootC = root; newRulesHash = rules
  submit f.confirmer $ exerciseCmd p AcceptProgram with chain

-- Three distinct values: each lands in its own field, and nothing else changes.
testProgramProposalSetsTheKeys : Script ()
testProgramProposalSetsTheKeys = do
  f <- fixture
  [(_, before)] <- query @ZkChain f.operator
  let vk = mconcat (replicate 64 "c")
      root = mconcat (replicate 64 "d")
      rules = mconcat (replicate 64 "e")
  chain <- switchProgram f f.chain vk root rules
  [(cid, after)] <- query @ZkChain f.operator
  cid === chain
  after === before with programVK = vk; rootC = root; rulesHash = rules
  -- the same three the other way round land the other way round
  _ <- switchProgram f chain rules vk root
  [(_, after2)] <- query @ZkChain f.operator
  (after2.programVK, after2.rootC, after2.rulesHash) === (rules, vk, root)

-- The ZisK root alone decides a block: under (stubVK, stubVK) the stub's header "06" commits and "01" is another ZisK release.
testAdvanceFollowsTheRootAlone : Script ()
testAdvanceFollowsTheRootAlone = do
  f <- fixture
  switched <- switchProgram f f.chain stubVK stubVK stubRoot
  refused "another ZisK release" f $ advanceWith switched "01" "aa" ["aa"] [] []
  (_, _) <- submit (asBuilder f) $ advanceWith switched "06" "aa" ["aa"] [] []
  pure ()

testSetProgramNeedsTheOperatorTheConfirmerAndTheGateway : Script ()
testSetProgramNeedsTheOperatorTheConfirmerAndTheGateway = do
  f <- fixture
  let set = exerciseCmd f.chain SetProgram with newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = stubRoot
  submitMustFail f.operator set
  submitMustFail f.confirmer set
  submitMustFail (actAs f.builder <> readAs [f.operator, f.confirmer]) set
  submitMustFail (actAs f.gateway) set
  submitMustFail (actAs [f.operator, f.gateway]) set
  submitMustFail (actAs [f.operator, f.confirmer]) set   -- without the gateway
  submitMustFail (actAs [f.confirmer, f.gateway]) set
  chain <- submit (actAs [f.operator, f.confirmer, f.gateway]) set
  [(cid, c)] <- query @ZkChain f.operator
  (cid, c.programVK) === (chain, stubRoot)

-- The operator and the gateway propose, and only the confirmer accepts. A proposal is made on the chain's contract and cannot be created by itself.
testProgramProposalAuthorizationAndChain : Script ()
testProgramProposalAuthorizationAndChain = do
  f <- fixture
  now <- getTime
  let direct = ProgramProposal with
        operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; reader = f.reader; chainId = 770101; newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = stubRoot; proposedAt = now
      propose = exerciseCmd f.chain ProposeProgram with newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = stubRoot
      both = actAs [f.operator, f.gateway]
  forA_ [actAs f.operator, actAs f.confirmer, actAs f.gateway, actAs f.builder, both, actAs [f.operator, f.confirmer]] $ \who ->
    submitMustFail who $ createCmd direct
  submitMustFail f.confirmer propose
  submitMustFail f.builder propose
  submitMustFail f.operator propose   -- the gateway has not consented
  submitMustFail f.gateway propose   -- nor the operator
  p <- submit both propose
  submitMustFail f.operator $ exerciseCmd p AcceptProgram with chain = f.chain
  submitMustFail (actAs f.builder <> readAs [f.operator, f.confirmer]) $ exerciseCmd p AcceptProgram with chain = f.chain
  submitMustFail (actAs f.gateway <> readAs [f.operator, f.confirmer]) $ exerciseCmd p AcceptProgram with chain = f.chain
  -- a proposal is not accepted on a contract that is no longer the chain's current one
  _ <- raiseCap f f.chain 60000000
  submitMustFail f.confirmer $ exerciseCmd p AcceptProgram with chain = f.chain

-- Each of the three values must be 64 lowercase hex digits.
testProgramValuesMustBeHex : Script ()
testProgramValuesMustBeHex = do
  f <- fixture
  let all3 = actAs [f.operator, f.confirmer, f.gateway]
      both = actAs [f.operator, f.gateway]
      propose vk root rules = exerciseCmd f.chain ProposeProgram with newProgramVK = vk; newRootC = root; newRulesHash = rules
  forA_ ["", "zz", "AB", "0x" <> stubRoot, T.take 62 stubRoot, stubRoot <> "bb", mconcat (replicate 64 "B"), mconcat (replicate 64 "g")] $ \bad -> do
    submitMustFail both $ propose bad stubRoot stubRoot
    submitMustFail both $ propose stubRoot bad stubRoot
    submitMustFail both $ propose stubRoot stubRoot bad
    submitMustFail all3 $ exerciseCmd f.chain SetProgram with newProgramVK = bad; newRootC = stubRoot; newRulesHash = stubRoot
    submitMustFail all3 $ exerciseCmd f.chain SetProgram with newProgramVK = stubRoot; newRootC = bad; newRulesHash = stubRoot
    submitMustFail all3 $ exerciseCmd f.chain SetProgram with newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = bad

-- Advance holds a block to the keys in the contract: the old pair before the switch, the new pair after, and the old pair again after
-- the switch back (a program change can be undone by changing back).
testAdvanceFollowsTheProgram : Script ()
testAdvanceFollowsTheProgram = do
  f <- fixture
  refused "another program" f $ advanceWith f.chain "05" "aa" ["aa"] [] []
  switched <- switchProgram f f.chain stubRoot stubRoot stubVK
  refused "another program" f $ advanceWith switched "01" "aa" ["aa"] [] []
  refused "another program" f $ advanceWith switched "06" "aa" ["aa"] [] []
  (next, _) <- submit (asBuilder f) $ advanceWith switched "05" "aa" ["aa"] [] []
  [(cid, c)] <- query @ZkChain f.operator
  (cid, c.headNumber, c.headHash) === (next, 1, stubHash1)
  (c.programVK, c.rootC, c.rulesHash) === (stubRoot, stubRoot, stubVK)
  -- the contract before the switch is spent: the old key does not come back by a stale handle
  submitMustFail (asBuilder f) $ advanceWith f.chain "01" "aa" ["aa"] [] []

testSwitchingBackRestoresTheOldProgram : Script ()
testSwitchingBackRestoresTheOldProgram = do
  f <- fixture
  [(_, before)] <- query @ZkChain f.operator
  switched <- switchProgram f f.chain stubRoot stubRoot stubVK
  back <- switchProgram f switched before.programVK before.rootC before.rulesHash
  [(cid, after)] <- query @ZkChain f.operator
  (cid, after) === (back, before)
  refused "another program" f $ advanceWith back "05" "aa" ["aa"] [] []
  (_, _) <- submit (asBuilder f) $ advanceWith back "01" "aa" ["aa"] [] []
  pure ()

-- A switch after blocks were committed keeps the head, and the next block continues from it.
testProgramSwitchKeepsTheHead : Script ()
testProgramSwitchKeepsTheHead = do
  f <- fixture
  (c1, _) <- submit (asBuilder f) $ advanceWith f.chain "01" "aa" ["aa"] [] []
  c2 <- switchProgram f c1 stubRoot stubRoot stubVK
  [(_, c)] <- query @ZkChain f.operator
  (c.headNumber, c.headHash, c.programVK) === (1, stubHash1, stubRoot)
  r <- trySubmit (asBuilder f) $ advanceWith c2 "11" "aa" ["aa"] [] []
  case r of
    Left e -> assertMsg ("refused, but not for the program: " <> show e) ("another program" `T.isInfixOf` show e)
    Right _ -> abort "the chain committed a block proven under the old program"

-- The line verify2 takes, and the stand-in for the sidecar's reading of it.
testLengthField : Script ()
testLengthField = do
  lengthField "" === "0000000000"
  lengthField "ab" === "0000000002"
  lengthField (mconcat (replicate 1344 "ab")) === "0000002688"
  lengthField (mconcat (replicate 12345 "a")) === "0000012345"

withHash : Text -> Text
withHash body = T.sha256 body <> body

testVerify2LineLayout : Script ()
testVerify2LineLayout = do
  let line = verify2Line "aabb" "01" "cc"
  T.take 64 line === T.sha256 (T.drop 64 line)
  T.drop 64 line === "0000000004" <> "aabb" <> "0000000002" <> "01" <> "cc"
  -- a block with no transactions ends after the header
  T.drop 64 (verify2Line "aa" "01" "") === "0000000002aa000000000201"

-- One fixed line, the same literal as in sidecar/tests/verify.rs and tests/test_demo_sidecar.py: the three sides build it alike.
testVerify2FixedVector : Script ()
testVerify2FixedVector =
  verify2Line "aa" "01" "cc" === "63bf501ac3036ecbde797c99ac847bfe8a41194cbe46468d4e668ea0a21686460000000002aa000000000201cc"

testVerify2StubReadsTheLineAsTheSidecarDoes : Script ()
testVerify2StubReadsTheLineAsTheSidecarDoes = do
  let malformed = "no malformed input"
      good = verify2Line "aa" "01" "cc"
  T.take 3 (verify2Answer good) === "ok "
  -- the same bytes split another way are another block: the prefixes say where each field ends
  verify2Answer (verify2Line "aa01" "" "cc") === "no unknown block"
  verify2Answer (verify2Line "aa" "" "01cc") === "no unknown block"
  -- an odd prefix cuts a byte in half; one past the end, a prefix that is not digits, and a line too short for its hash
  verify2Answer (withHash ("0000000003" <> "aa" <> "000000000201" <> "cc")) === malformed
  verify2Answer (withHash ("0000000099" <> "aa" <> "000000000201" <> "cc")) === malformed
  verify2Answer (withHash ("00000000aa" <> "aa" <> "000000000201" <> "cc")) === malformed
  verify2Answer (withHash ("0000000002" <> "aa" <> "0000000099" <> "01")) === malformed
  verify2Answer (withHash "000000") === malformed
  verify2Answer (withHash "") === malformed
  verify2Answer (T.take 63 good) === malformed
  -- a hash that is not the hash of the rest
  verify2Answer ((if T.take 1 good == "0" then "1" else "0") <> T.drop 1 good) === malformed
  verify2Answer (T.take 63 good <> "g" <> T.drop 64 good) === malformed
  -- a field that is not whole lowercase bytes, or has a comma, is refused as it is under `verify`
  verify2Answer (verify2Line "a" "01" "cc") === malformed
  verify2Answer (verify2Line "aa" "01" "c") === malformed
  verify2Answer (verify2Line "aa" "0g" "cc") === malformed
  verify2Answer (verify2Line "aa" "01" "c,") === malformed

-- A capital letter in a field is lowercased on the way to the sidecar, so the hash Daml made no longer matches: the line is refused.
-- Without the hash, "AA" would arrive as "aa" and pass.
testVerify2RefusesACapitalLetterTheRuntimeLowercases : Script ()
testVerify2RefusesACapitalLetterTheRuntimeLowercases = do
  let malformed = "no malformed input"
  verify2Answer (T.asciiToLower (verify2Line "AA" "01" "cc")) === malformed
  verify2Answer (T.asciiToLower (verify2Line "aa" "0A" "cc")) === malformed
  verify2Answer (T.asciiToLower (verify2Line "aa" "01" "CC")) === malformed
  -- the same text with the capital letters written as small ones is a different, valid line
  T.take 3 (verify2Answer (T.asciiToLower (verify2Line "aa" "01" "cc"))) === "ok "
  -- and through Advance, the stub lowercases as the runtime does
  f <- fixture
  refused "the sidecar refused the block: no malformed input" f $ advanceWith f.chain "01" "AA" ["aa"] [] []
  refused "the sidecar refused the block: no malformed input" f $ advanceWith f.chain "0A" "aa" ["aa"] [] []
  refused "the sidecar refused the block: no malformed input" f $ advanceWithTxs f.chain "01" "CC" "aa" ["aa"] [] []

-- The announced delay. A change of the gas cap, of the program or of the delay itself is accepted only once the chain's delay has passed
-- since it was proposed. `None` is no delay.

-- The confirmer's acceptance is refused, and says when it may be accepted.
mustWait : Party -> Commands a -> Script ()
mustWait confirmer cmd = do
  r <- trySubmit confirmer cmd
  case r of
    Left e -> assertMsg ("refused, but not for the wait: " <> show e) ("may be accepted from" `T.isInfixOf` show e)
    Right _ -> abort "the change was accepted before its delay had passed"

-- The operator and the gateway propose the delay and the confirmer accepts it on `chain`; the chain's current delay must have passed.
setDelay : F -> ContractId ZkChain -> Optional RelTime -> Script (ContractId ZkChain)
setDelay f chain d = do
  p <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd chain ProposeChangeDelay with newDelay = d
  submit f.confirmer $ exerciseCmd p AcceptChangeDelay with chain

testWithNoDelayAChangeIsAcceptedAtOnce : Script ()
testWithNoDelayAChangeIsAcceptedAtOnce = do
  f <- fixture
  [(_, c)] <- query @ZkChain f.operator
  c.changeDelay === None
  chain <- raiseCap f f.chain 60000000
  chain2 <- switchProgram f chain stubRoot stubRoot stubVK
  chain3 <- setDelay f chain2 (Some (seconds 100))
  Some c3 <- queryContractId f.operator chain3
  c3.changeDelay === Some (seconds 100)
  (c3.gasCap, c3.programVK) === (60000000, stubRoot)

testAGasCapWaitsOutTheDelay : Script ()
testAGasCapWaitsOutTheDelay = do
  f <- fixture
  chain <- setDelay f f.chain (Some (seconds 100))
  p <- submit f.operator $ exerciseCmd chain ProposeGasCap with newCap = 60000000
  mustWait f.confirmer $ exerciseCmd p AcceptGasCap with chain
  passTime (seconds 99)
  mustWait f.confirmer $ exerciseCmd p AcceptGasCap with chain
  passTime (seconds 1)
  next <- submit f.confirmer $ exerciseCmd p AcceptGasCap with chain
  Some c <- queryContractId f.operator next
  (c.gasCap, c.changeDelay) === (60000000, Some (seconds 100))

testAProgramWaitsOutTheDelay : Script ()
testAProgramWaitsOutTheDelay = do
  f <- fixture
  chain <- setDelay f f.chain (Some (seconds 100))
  p <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd chain ProposeProgram with newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = stubVK
  mustWait f.confirmer $ exerciseCmd p AcceptProgram with chain
  passTime (seconds 99)
  mustWait f.confirmer $ exerciseCmd p AcceptProgram with chain
  passTime (seconds 1)
  next <- submit f.confirmer $ exerciseCmd p AcceptProgram with chain
  Some c <- queryContractId f.operator next
  (c.programVK, c.rootC, c.rulesHash) === (stubRoot, stubRoot, stubVK)

-- The delay survives a block: proposals made on one contract are accepted on the next one (a block replaces the chain contract), and still wait.
testTheDelaySurvivesAnAdvance : Script ()
testTheDelaySurvivesAnAdvance = do
  f <- fixture
  c1 <- setDelay f f.chain (Some (seconds 100))
  pCap <- submit f.operator $ exerciseCmd c1 ProposeGasCap with newCap = 60000000
  pProg <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd c1 ProposeProgram with newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = stubVK
  (c2, _) <- submit (asBuilder f) $ advance c1 "01" [] []
  Some chain2 <- queryContractId f.operator c2
  chain2.changeDelay === Some (seconds 100)
  mustWait f.confirmer $ exerciseCmd pCap AcceptGasCap with chain = c2
  mustWait f.confirmer $ exerciseCmd pProg AcceptProgram with chain = c2
  passTime (seconds 99)
  mustWait f.confirmer $ exerciseCmd pCap AcceptGasCap with chain = c2
  passTime (seconds 1)
  c3 <- submit f.confirmer $ exerciseCmd pCap AcceptGasCap with chain = c2
  Some chain3 <- queryContractId f.operator c3
  (chain3.gasCap, chain3.changeDelay) === (60000000, Some (seconds 100))
  -- the program proposal, made on the first contract, is accepted on the third
  c4 <- submit f.confirmer $ exerciseCmd pProg AcceptProgram with chain = c3
  Some chain4 <- queryContractId f.operator c4
  (chain4.programVK, chain4.changeDelay) === (stubRoot, Some (seconds 100))

-- The delay cannot be cut short: a proposal to lower it waits out the delay that is in force.
testTheDelayWaitsOutItself : Script ()
testTheDelayWaitsOutItself = do
  f <- fixture
  chain <- setDelay f f.chain (Some (seconds 100))
  p <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd chain ProposeChangeDelay with newDelay = Some (seconds 10)
  passTime (seconds 99)
  mustWait f.confirmer $ exerciseCmd p AcceptChangeDelay with chain
  passTime (seconds 1)
  chain2 <- submit f.confirmer $ exerciseCmd p AcceptChangeDelay with chain
  Some c <- queryContractId f.operator chain2
  c.changeDelay === Some (seconds 10)
  -- and the lower delay is the one that applies from then on
  q <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd chain2 ProposeChangeDelay with newDelay = None
  mustWait f.confirmer $ exerciseCmd q AcceptChangeDelay with chain = chain2
  passTime (seconds 10)
  chain3 <- submit f.confirmer $ exerciseCmd q AcceptChangeDelay with chain = chain2
  Some c3 <- queryContractId f.operator chain3
  c3.changeDelay === None
  _ <- raiseCap f chain3 60000000
  pure ()

-- A proposal carries the ledger time it was made at; it cannot be created by the proposer with another time.
testAProposalCannotBeBackdated : Script ()
testAProposalCannotBeBackdated = do
  f <- fixture
  chain <- setDelay f f.chain (Some (seconds 100))
  passTime (seconds 1000)
  now <- getTime
  p <- submit f.operator $ exerciseCmd chain ProposeGasCap with newCap = 60000000
  Some proposal <- queryContractId f.operator p
  proposal.proposedAt === now
  let earlier = addRelTime now (seconds (-1000))
  forA_ [actAs f.operator, actAs [f.operator, f.gateway], actAs [f.operator, f.gateway, f.builder]] $ \who -> do
    submitMustFail who $ createCmd GasCapProposal with operator = f.operator; confirmer = f.confirmer; reader = f.reader; chainId = 770101; newCap = 60000000; proposedAt = earlier
    submitMustFail who $ createCmd ProgramProposal with
      operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; reader = f.reader; chainId = 770101; newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = stubRoot; proposedAt = earlier
    submitMustFail who $ createCmd ChangeDelayProposal with operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; reader = f.reader; chainId = 770101; newDelay = None; proposedAt = earlier
  mustWait f.confirmer $ exerciseCmd p AcceptGasCap with chain

-- The delay is between zero and thirty days; only the operator and the gateway propose it, and only the confirmer accepts.
testTheDelayIsBounded : Script ()
testTheDelayIsBounded = do
  f <- fixture
  let both = actAs [f.operator, f.gateway]
  submitMustFail both $ exerciseCmd f.chain ProposeChangeDelay with newDelay = Some (seconds (-1))
  submitMustFail both $ exerciseCmd f.chain ProposeChangeDelay with newDelay = Some ((days 30 `plusRel` seconds 1))
  submitMustFail f.operator $ exerciseCmd f.chain ProposeChangeDelay with newDelay = Some (seconds 5)
  submitMustFail f.confirmer $ exerciseCmd f.chain ProposeChangeDelay with newDelay = Some (seconds 5)
  p <- submit both $ exerciseCmd f.chain ProposeChangeDelay with newDelay = Some (days 30)
  submitMustFail f.operator $ exerciseCmd p AcceptChangeDelay with chain = f.chain
  submitMustFail both $ exerciseCmd p AcceptChangeDelay with chain = f.chain
  chain <- submit f.confirmer $ exerciseCmd p AcceptChangeDelay with chain = f.chain
  Some c <- queryContractId f.operator chain
  c.changeDelay === Some (days 30)
  -- SetChangeDelay needs all three parties, and refuses a delay out of bounds
  submitMustFail (actAs [f.operator, f.confirmer]) $ exerciseCmd chain SetChangeDelay with newDelay = None
  submitMustFail (actAs [f.operator, f.confirmer, f.gateway]) $ exerciseCmd chain SetChangeDelay with newDelay = Some (seconds (-5))

-- The proposals of a chain with a delay are for the chain's current contract, as before.
testADelayedProposalNeedsTheCurrentContract : Script ()
testADelayedProposalNeedsTheCurrentContract = do
  f <- fixture
  chain <- setDelay f f.chain (Some (seconds 10))
  p <- submit f.operator $ exerciseCmd chain ProposeGasCap with newCap = 60000000
  passTime (seconds 10)
  _ <- submit f.confirmer $ exerciseCmd p AcceptGasCap with chain
  submitMustFail f.confirmer $ exerciseCmd p AcceptGasCap with chain

-- A second chain run by the same parties, with another chain id.
secondChain : F -> Script (ContractId ZkChain)
secondChain f = do
  proposal <- submit (actAs [f.operator, f.gateway]) $ createCmd ChainProposal with
    operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; reader = f.reader
    chainId = 770102; genesisHash = stubHash0; genesisStateRoot = stubStateRoot0; programVK = stubVK; rootC = stubRoot
    rulesHash = stubRoot; gasCap = 30000000; gatewayAddress = gatewayAddr
  submit f.confirmer $ exerciseCmd proposal Accept

-- A proposal made on another chain, by the same parties, is not accepted on this one, however old it is.
testAProposalForAnotherChainIsRefused : Script ()
testAProposalForAnotherChainIsRefused = do
  f <- fixture
  other <- secondChain f
  let both = actAs [f.operator, f.gateway]
      refusedAsOtherChain cmd = do
        r <- trySubmit f.confirmer cmd
        case r of
          Left e -> assertMsg ("refused, but not as another chain's: " <> show e) ("is for another chain" `T.isInfixOf` show e)
          Right _ -> abort "a proposal for another chain was accepted"
  g <- submit f.operator $ exerciseCmd other ProposeGasCap with newCap = 60000000
  q <- submit both $ exerciseCmd other ProposeProgram with newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = stubRoot
  d <- submit both $ exerciseCmd other ProposeChangeDelay with newDelay = None
  k <- submit both $ exerciseCmd other ProposeContract with entry = gatewayEntry
  passTime (seconds 100)
  refusedAsOtherChain $ exerciseCmd g AcceptGasCap with chain = f.chain
  refusedAsOtherChain $ exerciseCmd q AcceptProgram with chain = f.chain
  refusedAsOtherChain $ exerciseCmd d AcceptChangeDelay with chain = f.chain
  refusedAsOtherChain $ exerciseCmd k AcceptContract with chain = f.chain
  -- and each is accepted on its own chain
  _ <- submit f.confirmer $ exerciseCmd g AcceptGasCap with chain = other
  pure ()

-- The operator alone takes a proposal back, the confirmer alone turns it down, and nobody else can do either; the reader sees them.
testAPendingProposalCanBeWithdrawnOrRejected : Script ()
testAPendingProposalCanBeWithdrawnOrRejected = do
  f <- fixture
  chain <- setDelay f f.chain (Some (days 1))
  let both = actAs [f.operator, f.gateway]
      proposeAll = do
        g <- submit f.operator $ exerciseCmd chain ProposeGasCap with newCap = 60000000
        q <- submit both $ exerciseCmd chain ProposeProgram with newProgramVK = stubRoot; newRootC = stubRoot; newRulesHash = stubRoot
        d <- submit both $ exerciseCmd chain ProposeChangeDelay with newDelay = None
        pure (g, q, d)
  (g, q, d) <- proposeAll
  [_] <- query @GasCapProposal f.reader
  [_] <- query @ProgramProposal f.reader
  [_] <- query @ChangeDelayProposal f.reader
  forA_ [f.builder, f.reader, f.gateway] $ \who -> do
    submitMustFail who $ exerciseCmd g WithdrawGasCap
    submitMustFail who $ exerciseCmd g RejectGasCap
  submitMustFail f.confirmer $ exerciseCmd g WithdrawGasCap
  submitMustFail f.operator $ exerciseCmd g RejectGasCap
  forA_ [f.builder, f.reader, f.confirmer] $ \who -> do
    submitMustFail who $ exerciseCmd q WithdrawProgram
    submitMustFail who $ exerciseCmd d WithdrawChangeDelay
  forA_ [f.builder, f.reader, f.operator] $ \who -> do
    submitMustFail who $ exerciseCmd q RejectProgram
    submitMustFail who $ exerciseCmd d RejectChangeDelay
  -- the operator withdraws the gas cap and the confirmer rejects the program and the delay
  submit f.operator $ exerciseCmd g WithdrawGasCap
  submit f.confirmer $ exerciseCmd q RejectProgram
  submit f.confirmer $ exerciseCmd d RejectChangeDelay
  [] <- query @GasCapProposal f.operator
  [] <- query @ProgramProposal f.operator
  [] <- query @ChangeDelayProposal f.operator
  submitMustFail f.confirmer $ exerciseCmd g AcceptGasCap with chain
  -- the operator can withdraw the other two as well, and the confirmer reject the gas cap
  (g2, q2, d2) <- proposeAll
  submit f.confirmer $ exerciseCmd g2 RejectGasCap
  submit f.operator $ exerciseCmd q2 WithdrawProgram
  submit f.operator $ exerciseCmd d2 WithdrawChangeDelay
  [] <- query @GasCapProposal f.operator
  pure ()

plusRel : RelTime -> RelTime -> RelTime
plusRel a b = convertMicrosecondsToRelTime (convertRelTimeToMicroseconds a + convertRelTimeToMicroseconds b)

-- The limits on the legs: the pause, and the withdrawal quota.

-- An Advance that must be refused for a reason that contains `why`, in a chain that has moved on already.
mustRefuse : Text -> F -> Commands a -> Script ()
mustRefuse why f cmds = do
  r <- trySubmit (asBuilder f) cmds
  case r of
    Left e -> assertMsg ("refused, but not for \"" <> why <> "\": " <> show e) (why `T.isInfixOf` show e)
    Right _ -> abort ("the chain committed a block that it should have refused (" <> why <> ")")

paused : Text
paused = "the legs are paused until"

-- The operator proposes new limits and the confirmer accepts them on `chain`; the chain's delay must have passed.
setLimits : F -> ContractId ZkChain -> Optional Decimal -> Optional RelTime -> Optional RelTime -> Script (ContractId ZkChain)
setLimits f chain q w m = do
  p <- submit f.operator $ exerciseCmd chain ProposeLegLimits with newQuota = q; newWindow = w; newPauseMax = m
  submit f.confirmer $ exerciseCmd p AcceptLegLimits with chain

-- The operator proposes to pause for `d` and the confirmer accepts.
renew : F -> ContractId ZkChain -> RelTime -> Script (ContractId ZkChain)
renew f chain d = do
  p <- submit f.operator $ exerciseCmd chain ProposeRenewPause with forHowLong = d
  submit f.confirmer $ exerciseCmd p AcceptRenewPause with chain

secs : Int -> RelTime
secs = seconds

testAPausedChainRefusesEveryLegButCarriesOn : Script ()
testAPausedChainRefusesEveryLegButCarriesOn = do
  f <- fixture
  holding <- custody f
  now <- getTime
  chain <- submit f.confirmer $ exerciseCmd f.chain PauseLegs
  Some c <- queryContractId f.operator chain
  c.pausedUntil === Some (addRelTime now (days 3))
  refused paused f $ advance chain "01" [depositLine deposit1] [depositLeg f]
  refused paused f $ advance chain "01" [paymentLine f.dvp1] [paymentLeg f]
  refused paused f $ advance chain "01" [withdrawalLine withdrawalId burnerAddr "4.0" f.u] [withdrawalLeg f holding]
  -- a block of no legs is still committed
  (c1, _) <- submit (asBuilder f) $ advance chain "01" [] []
  Some c1' <- queryContractId f.operator c1
  (c1'.headNumber, c1'.pausedUntil) === (1, c.pausedUntil)
  mustRefuse paused f $ advance c1 "11" [depositLine deposit1] [depositLeg f]

testAPauseEndsOnItsOwn : Script ()
testAPauseEndsOnItsOwn = do
  f <- fixture
  -- (a pause of the 3 days default would outlast the deposit's allocation, which settles within 2 days)
  short <- setLimits f f.chain None None (Some (secs 1000))
  chain <- submit f.confirmer $ exerciseCmd short PauseLegs
  passTime (secs 999)
  refused paused f $ advance chain "01" [depositLine deposit1] [depositLeg f]
  passTime (secs 1)
  (_, _) <- submit (asBuilder f) $ advance chain "01" [depositLine deposit1] [depositLeg f]
  holds f.gateway "TKB" >>= \xs -> xs === [10.0]

testAPauseCanBeLiftedEarlyByTheConfirmer : Script ()
testAPauseCanBeLiftedEarlyByTheConfirmer = do
  f <- fixture
  chain <- submit f.confirmer $ exerciseCmd f.chain PauseLegs
  submitMustFail f.operator $ exerciseCmd chain UnpauseLegs
  submitMustFail f.builder $ exerciseCmd chain UnpauseLegs
  open <- submit f.confirmer $ exerciseCmd chain UnpauseLegs
  Some c <- queryContractId f.operator open
  c.pausedUntil === None
  -- nothing to lift when nothing is paused
  submitMustFail f.confirmer $ exerciseCmd open UnpauseLegs
  (_, _) <- submit (asBuilder f) $ advance open "01" [depositLine deposit1] [depositLeg f]
  holds f.gateway "TKB" >>= \xs -> xs === [10.0]

testOnlyTheConfirmerPausesAlone : Script ()
testOnlyTheConfirmerPausesAlone = do
  f <- fixture
  submitMustFail f.operator $ exerciseCmd f.chain PauseLegs
  submitMustFail f.builder $ exerciseCmd f.chain PauseLegs
  submitMustFail f.gateway $ exerciseCmd f.chain PauseLegs
  submitMustFail f.operator $ exerciseCmd f.chain RenewPause with forHowLong = days 1
  submitMustFail f.confirmer $ exerciseCmd f.chain RenewPause with forHowLong = days 1
  -- the two together may, from the chain's contract directly
  _ <- submit (actAs [f.operator, f.confirmer]) $ exerciseCmd f.chain RenewPause with forHowLong = days 1
  pure ()

testALoneConfirmerCannotKeepTheLegsPaused : Script ()
testALoneConfirmerCannotKeepTheLegsPaused = do
  f <- fixture
  chain <- submit f.confirmer $ exerciseCmd f.chain PauseLegs
  -- not again while it runs
  submitMustFail f.confirmer $ exerciseCmd chain PauseLegs
  passTime (secs (3 * 24 * 3600))
  -- the pause has ended, and the confirmer alone must wait one more pause length
  trySubmit f.confirmer (exerciseCmd chain PauseLegs) >>= \r -> case r of
    Left e -> assertMsg ("refused, but not for the cooldown: " <> show e) ("may start a new pause from" `T.isInfixOf` show e)
    Right _ -> abort "the confirmer paused again at once"
  passTime (secs (3 * 24 * 3600 - 1))
  submitMustFail f.confirmer $ exerciseCmd chain PauseLegs
  passTime (secs 1)
  again <- submit f.confirmer $ exerciseCmd chain PauseLegs
  Some c <- queryContractId f.operator again
  isSome c.pausedUntil === True

-- A pause lifted early leaves a cooldown as long as it ran, so a false alarm does not lock the brake out for days.
testALiftedPauseCoolsDownForAsLongAsItRan : Script ()
testALiftedPauseCoolsDownForAsLongAsItRan = do
  f <- fixture
  chain <- submit f.confirmer $ exerciseCmd f.chain PauseLegs
  passTime (secs 300)
  open <- submit f.confirmer $ exerciseCmd chain UnpauseLegs
  submitMustFail f.confirmer $ exerciseCmd open PauseLegs
  passTime (secs 299)
  submitMustFail f.confirmer $ exerciseCmd open PauseLegs
  passTime (secs 1)
  _ <- submit f.confirmer $ exerciseCmd open PauseLegs
  pure ()

-- A renewal keeps the pause's start, so the cooldown is as long as the whole pause ran.
testARenewedPauseCoolsDownForTheWholePause : Script ()
testARenewedPauseCoolsDownForTheWholePause = do
  f <- fixture
  chain <- submit f.confirmer $ exerciseCmd f.chain PauseLegs
  passTime (secs 1000)
  renewed <- renew f chain (secs 500)
  -- it ran 1000 s, will have run 1500 s at the expiry, and is lifted at once: 1000 s of cooldown from now
  open <- submit f.confirmer $ exerciseCmd renewed UnpauseLegs
  passTime (secs 999)
  submitMustFail f.confirmer $ exerciseCmd open PauseLegs
  passTime (secs 1)
  _ <- submit f.confirmer $ exerciseCmd open PauseLegs
  pure ()

-- A proposal that waited too long no longer lets the confirmer alone pause the legs.
testAStaleRenewalProposalIsRefused : Script ()
testAStaleRenewalProposalIsRefused = do
  f <- fixture
  p <- submit f.operator $ exerciseCmd f.chain ProposeRenewPause with forHowLong = days 1
  passTime (secs 3601)
  submitMustFail f.confirmer $ exerciseCmd p AcceptRenewPause with chain = f.chain
  q <- submit f.operator $ exerciseCmd f.chain ProposeRenewPause with forHowLong = days 1
  passTime (secs 3600)
  _ <- submit f.confirmer $ exerciseCmd q AcceptRenewPause with chain = f.chain
  pure ()

testRenewingAPauseNeedsBothAndNeverMoreThanTheMaximum : Script ()
testRenewingAPauseNeedsBothAndNeverMoreThanTheMaximum = do
  f <- fixture
  short <- setLimits f f.chain None None (Some (secs 1000))
  chain <- submit f.confirmer $ exerciseCmd short PauseLegs
  passTime (secs 500)
  -- 500 s left; the renewal makes it 1000 s from now
  renewed <- renew f chain (secs 1000)
  passTime (secs 600)
  -- the first pause would have ended 100 s ago
  refused paused f $ advance renewed "01" [depositLine deposit1] [depositLeg f]
  passTime (secs 400)
  (_, _) <- submit (asBuilder f) $ advance renewed "01" [depositLine deposit1] [depositLeg f]
  pure ()

testARenewalOverTheMaximumIsRefused : Script ()
testARenewalOverTheMaximumIsRefused = do
  f <- fixture
  chain <- submit f.confirmer $ exerciseCmd f.chain PauseLegs
  p <- submit f.operator $ exerciseCmd chain ProposeRenewPause with forHowLong = days 3 `plusRel` secs 1
  submitMustFail f.confirmer $ exerciseCmd p AcceptRenewPause with chain
  -- a pause of no length is no pause
  submitMustFail f.operator $ exerciseCmd chain ProposeRenewPause with forHowLong = secs 0
  submitMustFail f.operator $ exerciseCmd chain ProposeRenewPause with forHowLong = secs (-5)
  -- only the operator proposes and only the confirmer accepts
  submitMustFail f.confirmer $ exerciseCmd chain ProposeRenewPause with forHowLong = days 1
  q <- submit f.operator $ exerciseCmd chain ProposeRenewPause with forHowLong = days 1
  submitMustFail f.operator $ exerciseCmd q AcceptRenewPause with chain
  submitMustFail f.operator $ exerciseCmd q RejectRenewPause
  submitMustFail f.confirmer $ exerciseCmd q WithdrawRenewPause
  submit f.confirmer $ exerciseCmd q RejectRenewPause
  r <- submit f.operator $ exerciseCmd chain ProposeRenewPause with forHowLong = days 1
  submit f.operator $ exerciseCmd r WithdrawRenewPause

testTheTwoMayPauseAChainThatIsNotPaused : Script ()
testTheTwoMayPauseAChainThatIsNotPaused = do
  f <- fixture
  now <- getTime
  chain <- renew f f.chain (days 1)
  Some c <- queryContractId f.operator chain
  c.pausedUntil === Some (addRelTime now (days 1))
  refused paused f $ advance chain "01" [depositLine deposit1] [depositLeg f]

testAPauseRenewalNeedsTheCurrentContract : Script ()
testAPauseRenewalNeedsTheCurrentContract = do
  f <- fixture
  p <- submit f.operator $ exerciseCmd f.chain ProposeRenewPause with forHowLong = days 1
  _ <- submit f.confirmer $ exerciseCmd f.chain PauseLegs
  submitMustFail f.confirmer $ exerciseCmd p AcceptRenewPause with chain = f.chain

testThePauseMaximumIsAChainSetting : Script ()
testThePauseMaximumIsAChainSetting = do
  f <- fixture
  chain <- setLimits f f.chain None None (Some (secs 100))
  Some c <- queryContractId f.operator chain
  c.pauseMax === Some (secs 100)
  paused1 <- submit f.confirmer $ exerciseCmd chain PauseLegs
  passTime (secs 99)
  refused paused f $ advance paused1 "01" [depositLine deposit1] [depositLeg f]
  passTime (secs 1)
  (next, _) <- submit (asBuilder f) $ advance paused1 "01" [depositLine deposit1] [depositLeg f]
  -- and a renewal over the setting is refused
  p <- submit f.operator $ exerciseCmd next ProposeRenewPause with forHowLong = secs 101
  submitMustFail f.confirmer $ exerciseCmd p AcceptRenewPause with chain = next

-- The quota.

-- A withdrawal of `a` of the token at `tok`, funded from `h`.
withdrawalOf : F -> ContractId GatewayToken -> ContractId H.Holding -> Decimal -> Leg
withdrawalOf f tok h a = WithdrawalLeg with
  id = withdrawalId; token = tok; from = burnerAddr; amount = a; acceptance = f.acceptance; inputs = [h]

wLine : Text -> Decimal -> Party -> Text
wLine evmToken a p = line "withdrawal" withdrawalId evmToken burnerAddr (show a) (toHex (partyToText p))

quota5 : F -> Script (ContractId ZkChain)
quota5 f = setLimits f f.chain (Some 5.0) (Some (secs 100)) None

testABlockOverTheQuotaIsRefused : Script ()
testABlockOverTheQuotaIsRefused = do
  f <- fixture
  h <- custody f
  chain <- quota5 f
  Some c <- queryContractId f.operator chain
  (c.withdrawalQuota, c.quotaWindow) === (Some 5.0, Some (secs 100))
  refused "over the withdrawal quota" f $ advance chain "01" [wLine wTkb 6.0 f.u] [withdrawalOf f f.token h 6.0]
  holds f.u "TKB" >>= \xs -> xs === []

testABlockAtTheQuotaIsAccepted : Script ()
testABlockAtTheQuotaIsAccepted = do
  f <- fixture
  h <- custody f
  chain <- quota5 f
  (c1, _) <- submit (asBuilder f) $ advance chain "01" [wLine wTkb 5.0 f.u] [withdrawalOf f f.token h 5.0]
  holds f.u "TKB" >>= \xs -> xs === [5.0]
  Some c <- queryContractId f.operator c1
  Some [t] <- pure c.withdrawn
  (t.tallyToken, t.tallyAmount) === (partyToText f.registry <> "/TKB", 5.0)

testTheWithdrawalsOfOneBlockAreAddedUp : Script ()
testTheWithdrawalsOfOneBlockAreAddedUp = do
  f <- fixture
  h1 <- custody f
  h2 <- custody f
  chain <- quota5 f
  refused "over the withdrawal quota" f $ advance chain "01" [wLine wTkb 3.0 f.u, wLine wTkb 3.0 f.u] [withdrawalOf f f.token h1 3.0, withdrawalOf f f.token h2 3.0]
  (_, _) <- submit (asBuilder f) $ advance chain "01" [wLine wTkb 3.0 f.u, wLine wTkb 2.0 f.u] [withdrawalOf f f.token h1 3.0, withdrawalOf f f.token h2 2.0]
  holds f.u "TKB" >>= \xs -> sum xs === 5.0

testTheQuotaRollsWithTheWindow : Script ()
testTheQuotaRollsWithTheWindow = do
  f <- fixture
  h1 <- custody f
  h2 <- custody f
  chain <- quota5 f
  (c1, _) <- submit (asBuilder f) $ advance chain "01" [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h1 3.0]
  -- 3 more would make 6 in the window
  mustRefuse "over the withdrawal quota" f $ advance c1 "11" [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h2 3.0]
  passTime (secs 99)
  mustRefuse "over the withdrawal quota" f $ advance c1 "11" [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h2 3.0]
  -- a window and a bucket (a 24th of the window) after the first withdrawal, it no longer counts
  passTime (secs 6)
  (c2, _) <- submit (asBuilder f) $ advance c1 "11" [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h2 3.0]
  Some c <- queryContractId f.operator c2
  Some [t] <- pure c.withdrawn
  t.tallyAmount === 3.0

testTwoBlocksOfOneBucketAreOneTally : Script ()
testTwoBlocksOfOneBucketAreOneTally = do
  f <- fixture
  h1 <- custody f
  h2 <- custody f
  chain <- quota5 f
  (c1, _) <- submit (asBuilder f) $ advance chain "01" [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h1 3.0]
  (c2, _) <- submit (asBuilder f) $ advance c1 "11" [wLine wTkb 2.0 f.u] [withdrawalOf f f.token h2 2.0]
  Some c <- queryContractId f.operator c2
  Some [t] <- pure c.withdrawn
  t.tallyAmount === 5.0

testTheQuotaIsPerInstrument : Script ()
testTheQuotaIsPerInstrument = do
  f <- fixture
  h1 <- custody f
  h2 <- custodyOf f "OTH"
  other <- makeTokenOf "OTH" f.operator f.confirmer f.gateway f.builder 770101 f.reg tokenAddr
  chain <- quota5 f
  (c1, _) <- submit (asBuilder f) $ advance chain "01" [wLine wTkb 5.0 f.u, wLine tokenAddr 5.0 f.u] [withdrawalOf f f.token h1 5.0, withdrawalOf f other h2 5.0]
  Some c <- queryContractId f.operator c1
  Some ts <- pure c.withdrawn
  length ts === 2

-- Two wrapped tokens of one instrument draw on one custody, so they share one quota: a forged proof gets Q out of it, not k times Q.
testTwoTokensOfOneInstrumentShareTheQuota : Script ()
testTwoTokensOfOneInstrumentShareTheQuota = do
  f <- fixture
  h1 <- custody f
  h2 <- custody f
  h3 <- custody f
  other <- makeToken f.operator f.confirmer f.gateway f.builder 770101 f.reg tokenAddr
  chain <- quota5 f
  refused "over the withdrawal quota" f $ advance chain "01" [wLine wTkb 5.0 f.u, wLine tokenAddr 5.0 f.u] [withdrawalOf f f.token h1 5.0, withdrawalOf f other h2 5.0]
  -- and a second block counts against what the first took, whichever token it went through
  (c1, _) <- submit (asBuilder f) $ advance chain "01" [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h1 3.0]
  mustRefuse "over the withdrawal quota" f $ advance c1 "11" [wLine tokenAddr 3.0 f.u] [withdrawalOf f other h3 3.0]

testWithNoQuotaNothingIsCounted : Script ()
testWithNoQuotaNothingIsCounted = do
  f <- fixture
  h <- custody f
  (c1, _) <- submit (asBuilder f) $ advance f.chain "01" [wLine wTkb 9.0 f.u] [withdrawalOf f f.token h 9.0]
  Some c <- queryContractId f.operator c1
  c.withdrawn === None

testAQuotaOfNoneIsLiftedAgain : Script ()
testAQuotaOfNoneIsLiftedAgain = do
  f <- fixture
  h <- custody f
  chain <- quota5 f
  open <- setLimits f chain None None None
  (_, _) <- submit (asBuilder f) $ advance open "01" [wLine wTkb 9.0 f.u] [withdrawalOf f f.token h 9.0]
  holds f.u "TKB" >>= \xs -> xs === [9.0]

testAQuotaWaitsOutTheChangeDelay : Script ()
testAQuotaWaitsOutTheChangeDelay = do
  f <- fixture
  chain <- setDelay f f.chain (Some (secs 100))
  p <- submit f.operator $ exerciseCmd chain ProposeLegLimits with newQuota = Some 5.0; newWindow = Some (secs 100); newPauseMax = Some (days 1)
  mustWait f.confirmer $ exerciseCmd p AcceptLegLimits with chain
  passTime (secs 99)
  mustWait f.confirmer $ exerciseCmd p AcceptLegLimits with chain
  passTime (secs 1)
  next <- submit f.confirmer $ exerciseCmd p AcceptLegLimits with chain
  Some c <- queryContractId f.operator next
  (c.withdrawalQuota, c.quotaWindow, c.pauseMax, c.changeDelay) === (Some 5.0, Some (secs 100), Some (days 1), Some (secs 100))
  -- the same wait lifts it again
  q <- submit f.operator $ exerciseCmd next ProposeLegLimits with newQuota = None; newWindow = None; newPauseMax = None
  mustWait f.confirmer $ exerciseCmd q AcceptLegLimits with chain = next
  passTime (secs 100)
  open <- submit f.confirmer $ exerciseCmd q AcceptLegLimits with chain = next
  Some c2 <- queryContractId f.operator open
  (c2.withdrawalQuota, c2.quotaWindow, c2.pauseMax) === (None, None, None)

testTheLimitsAreBoundedAndHaveTheirParties : Script ()
testTheLimitsAreBoundedAndHaveTheirParties = do
  f <- fixture
  let propose q w m = submitMustFail f.operator $ exerciseCmd f.chain ProposeLegLimits with newQuota = q; newWindow = w; newPauseMax = m
  propose (Some 0.0) (Some (secs 100)) None
  propose (Some (-1.0)) (Some (secs 100)) None
  propose (Some 5.0) None None
  propose None (Some (secs 100)) None
  propose (Some 5.0) (Some (secs 0)) None
  propose (Some 5.0) (Some (days 30 `plusRel` secs 1)) None
  propose None None (Some (secs 0))
  propose None None (Some (days 14 `plusRel` secs 1))
  submitMustFail f.confirmer $ exerciseCmd f.chain ProposeLegLimits with newQuota = None; newWindow = None; newPauseMax = None
  submitMustFail f.builder $ exerciseCmd f.chain ProposeLegLimits with newQuota = None; newWindow = None; newPauseMax = None
  -- the limits' own choice needs the operator and the confirmer, and the same bounds
  submitMustFail f.operator $ exerciseCmd f.chain SetLegLimits with newQuota = None; newWindow = None; newPauseMax = None
  submitMustFail (actAs [f.operator, f.confirmer]) $ exerciseCmd f.chain SetLegLimits with newQuota = Some 5.0; newWindow = None; newPauseMax = None
  submitMustFail (actAs [f.operator, f.confirmer]) $ exerciseCmd f.chain SetLegLimits with newQuota = None; newWindow = None; newPauseMax = Some (days 15)
  chain2 <- submit (actAs [f.operator, f.confirmer]) $ exerciseCmd f.chain SetLegLimits with newQuota = Some 5.0; newWindow = Some (days 30); newPauseMax = Some (days 14)
  p <- submit f.operator $ exerciseCmd chain2 ProposeLegLimits with newQuota = None; newWindow = None; newPauseMax = None
  submitMustFail f.operator $ exerciseCmd p AcceptLegLimits with chain = chain2
  submitMustFail f.operator $ exerciseCmd p RejectLegLimits
  submitMustFail f.confirmer $ exerciseCmd p WithdrawLegLimits
  submit f.operator $ exerciseCmd p WithdrawLegLimits
  q <- submit f.operator $ exerciseCmd chain2 ProposeLegLimits with newQuota = None; newWindow = None; newPauseMax = None
  submit f.confirmer $ exerciseCmd q RejectLegLimits

testALimitsProposalNeedsTheCurrentContractAndItsChain : Script ()
testALimitsProposalNeedsTheCurrentContractAndItsChain = do
  f <- fixture
  p <- submit f.operator $ exerciseCmd f.chain ProposeLegLimits with newQuota = Some 5.0; newWindow = Some (secs 100); newPauseMax = None
  other <- secondChain f
  submitMustFail f.confirmer $ exerciseCmd p AcceptLegLimits with chain = other
  _ <- submit f.confirmer $ exerciseCmd p AcceptLegLimits with chain = f.chain
  submitMustFail f.confirmer $ exerciseCmd p AcceptLegLimits with chain = f.chain

-- ---------------------------------------------------------------------------------------------------------------------
-- From package 0.4.0: a venue's trade, settled by a proven EVM payment, and the funded claim it leaves for the EVM buyer.

tradeLabel : Text
tradeLabel = "trade-1"

-- A party that is a venue: it signs trades and is the executor of the allocations they name.
makeVenue : Script Party
makeVenue = allocateParty "Venue"

-- The builder's submission when a venue's contracts are in the block.
asBuilderV : F -> Party -> SubmitOptions
asBuilderV f venue = asBuilder f <> readAs [venue]

-- U allocates 10 of `inst` to `receiver` (executor `exec`). The venue's trade names that allocation, and `modify` changes what the trade says.
makeTradeOf : F -> Party -> Party -> Party -> Text -> (VenueTrade -> VenueTrade) -> Script (ContractId VenueTrade)
makeTradeOf f venue exec receiver inst modify = do
  let pid = venueTradeId venue tradeLabel
  allocation <- allocate f.reg f.u receiver exec inst 10.0 pid
  submit (actAs [venue, f.u, f.v]) $ createCmd (modify VenueTrade with
    venue; sender = f.u; operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; chainId = 770101
    label = tradeLabel; payId = pid; token = tokenAddr; payee = uAddr; amount = tenTokens
    allocation; allocationDisclosed = None; gatewayToken = f.token; claimId = venueClaimId pid; recipient = recipientAddr)

-- The honest trade: U's 10 TKB go to the gateway, with the venue as executor.
makeTrade : F -> Party -> Script (ContractId VenueTrade)
makeTrade f venue = makeTradeOf f venue venue f.gateway "TKB" identity

tradeLeg : ContractId VenueTrade -> Leg
tradeLeg c = TradeLeg with tradeCid = c

claimLegOf : F -> ContractId FundedClaim -> Leg
claimLegOf f c = ClaimLeg with claimCid = c; tokenCid = f.token

tradeLine : Text -> Text
tradeLine pid = line "payment" pid tokenAddr uAddr tenTokens ""

claimLine : Text -> Text
claimLine cid = line "deposit" cid wTkb recipientAddr "10.0" ""

-- A funded claim made directly by its signatories (and the parties a test names in their place), for the tests of the claim leg.
makeClaim : F -> (FundedClaim -> FundedClaim) -> Script (ContractId FundedClaim)
makeClaim f modify = submit (actAs [f.operator, f.confirmer, f.gateway, f.builder, f.v]) $ createCmd (modify FundedClaim with
  operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; chainId = 770101
  claimId = venueClaimId (venueTradeId f.u tradeLabel); recipient = recipientAddr; gatewayToken = f.token; amount = 10.0)

-- A trade block the chain must refuse: the chain is at its genesis, the trade stands, and the gateway holds nothing.
refusedTrade : Text -> F -> Party -> ContractId VenueTrade -> Script ()
refusedTrade why f venue trade = do
  refusedAs why f (asBuilderV f venue) $ advance f.chain "01" [tradeLine (venueTradeId venue tradeLabel)] [tradeLeg trade]
  Some _ <- queryContractId venue trade
  holds f.gateway "TKB" >>= \xs -> xs === []
  query @FundedClaim f.gateway >>= \cs -> length cs === 0

-- A trade: the allocation to the gateway is executed, so the gateway holds U's 10 TKB, and a funded claim of that amount stands.
testATradeSettlesAndFundsAClaim : Script ()
testATradeSettlesAndFundsAClaim = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTrade f venue
  let pid = venueTradeId venue tradeLabel
  (_, _) <- submit (asBuilderV f venue) $ advance f.chain "01" [tradeLine pid] [tradeLeg trade]
  holds f.gateway "TKB" >>= \xs -> xs === [10.0]
  holds f.u "TKB" >>= \xs -> xs === []
  None <- queryContractId venue trade             -- the trade is used up
  [(_, c)] <- query @FundedClaim f.gateway
  (c.claimId, c.recipient, c.amount, c.gatewayToken) === (venueClaimId pid, recipientAddr, 10.0, f.token)
  [(_, z)] <- query @ZkChain f.operator
  z.headNumber === 1

-- The whole trip: block 1 settles the trade, block 2 redeems the claim it made. Both blocks go through `Advance` with the stub.
testATradeThenItsClaimSettleInTwoBlocks : Script ()
testATradeThenItsClaimSettleInTwoBlocks = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTrade f venue
  let pid = venueTradeId venue tradeLabel
  (c1, _) <- submit (asBuilderV f venue) $ advance f.chain "01" [tradeLine pid] [tradeLeg trade]
  [(claim, _)] <- query @FundedClaim f.gateway
  (_, _) <- submit (asBuilderV f venue) $ advance c1 "11" [claimLine (venueClaimId pid)] [claimLegOf f claim]
  None <- queryContractId f.gateway claim         -- redeemed: nothing is left to redeem twice
  holds f.gateway "TKB" >>= \xs -> xs === [10.0]  -- the Canton token stays in the gateway's custody
  [(_, z)] <- query @ZkChain f.operator
  (z.headNumber, z.headHash) === (2, stubHash2)

testATradeLegWithTheWrongExecutorIsRefused : Script ()
testATradeLegWithTheWrongExecutorIsRefused = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTradeOf f venue f.operator f.gateway "TKB" identity
  refusedTrade "the allocation's executor is not the venue" f venue trade

testATradeLegWhoseAllocationIsAnotherSendersIsRefused : Script ()
testATradeLegWhoseAllocationIsAnotherSendersIsRefused = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTradeOf f venue venue f.gateway "TKB" (\t -> t with sender = f.v)
  refusedTrade "the allocation's sender is not the trade's" f venue trade

testATradeLegWhoseReceiverIsNotTheGatewayIsRefused : Script ()
testATradeLegWhoseReceiverIsNotTheGatewayIsRefused = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTradeOf f venue venue f.v "TKB" identity
  refusedTrade "the allocation's receiver is not the gateway" f venue trade

testATradeLegOfAnotherInstrumentThanTheTokensIsRefused : Script ()
testATradeLegOfAnotherInstrumentThanTheTokensIsRefused = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTradeOf f venue venue f.gateway "TKA" identity
  refusedTrade "the allocation is of another instrument than the token's" f venue trade

testATradeOfAnotherChainOperatorConfirmerOrGatewayIsRefused : Script ()
testATradeOfAnotherChainOperatorConfirmerOrGatewayIsRefused = do
  f <- fixture
  venue <- makeVenue
  t1 <- makeTradeOf f venue venue f.gateway "TKB" (\t -> t with chainId = 770102)
  refusedTrade "the venue trade is for another chain" f venue t1
  t2 <- makeTradeOf f venue venue f.gateway "TKB" (\t -> t with operator = f.builder)
  refusedTrade "the venue trade names another operator than the chain's" f venue t2
  t3 <- makeTradeOf f venue venue f.gateway "TKB" (\t -> t with confirmer = f.builder)
  refusedTrade "the venue trade names another confirmer than the chain's" f venue t3
  t4 <- makeTradeOf f venue venue f.gateway "TKB" (\t -> t with gateway = f.v)
  refusedTrade "the venue trade names another gateway than the chain's" f venue t4

-- The trade's own `ensure`: the ids are derived from the venue and the label, and the rest is well formed.
testATradeNeedsItsIdsFromTheVenueAndTheLabel : Script ()
testATradeNeedsItsIdsFromTheVenueAndTheLabel = do
  f <- fixture
  venue <- makeVenue
  let pid = venueTradeId venue tradeLabel
  allocation <- allocate f.reg f.u venue venue "TKB" 10.0 pid
  let mk modify = submitMustFail (actAs [venue, f.u]) $ createCmd (modify VenueTrade with
        venue; sender = f.u; operator = f.operator; confirmer = f.confirmer; gateway = f.gateway; builder = f.builder; chainId = 770101
        label = tradeLabel; payId = pid; token = tokenAddr; payee = uAddr; amount = tenTokens
        allocation; allocationDisclosed = None; gatewayToken = f.token; claimId = venueClaimId pid; recipient = recipientAddr)
  mk (\t -> t with payId = idOf "99")                                   -- not derived from venue and label
  mk (\t -> t with label = "trade-2")                                   -- the label is not the one the id was made from
  mk (\t -> t with payId = paymentId venue f.v tradeLabel)              -- the id of terms between two parties
  mk (\t -> t with payId = T.sha256 (T.intercalate "," [partyToText venue, tradeLabel]))   -- without the domain tag
  mk (\t -> t with claimId = idOf "99")                                 -- not derived from the payId
  mk (\t -> t with claimId = pid)
  mk (\t -> t with token = "11")
  mk (\t -> t with payee = mconcat (replicate 20 "AB"))                       -- hex, but not lowercase
  mk (\t -> t with recipient = idOf "44")                               -- 64 digits, not 40
  mk (\t -> t with amount = "10")
  mk (\t -> t with amount = mconcat (replicate 64 "0"))
  mk (\t -> t with chainId = 0)
  pure ()

-- A claim block the chain must refuse. The claim is still there afterwards, and the chain is at its genesis.
refusedClaim : Text -> F -> Text -> [Leg] -> ContractId FundedClaim -> Script ()
refusedClaim why f recorded legs claim = do
  refusedAs why f (asBuilder f) $ advance f.chain "01" [recorded] legs
  Some _ <- queryContractId f.builder claim
  pure ()

testAClaimLegSettlesAndNamesTheDepositLine : Script ()
testAClaimLegSettlesAndNamesTheDepositLine = do
  f <- fixture
  claim <- makeClaim f identity
  let cid = venueClaimId (venueTradeId f.u tradeLabel)
  (_, _) <- submit (asBuilder f) $ advance f.chain "01" [claimLine cid] [claimLegOf f claim]
  None <- queryContractId f.gateway claim
  -- it is exactly the line of a deposit of the same id, token, recipient and amount
  claimLine cid === depositLine cid

testAClaimLegOfAnotherChainOperatorConfirmerGatewayOrTokenIsRefused : Script ()
testAClaimLegOfAnotherChainOperatorConfirmerGatewayOrTokenIsRefused = do
  f <- fixture
  let cid = venueClaimId (venueTradeId f.u tradeLabel)
  c1 <- makeClaim f (\c -> c with chainId = 770102)
  refusedClaim "the funded claim is for another chain" f (claimLine cid) [claimLegOf f c1] c1
  c2 <- makeClaim f (\c -> c with operator = f.builder)
  refusedClaim "the funded claim names another operator than the chain's" f (claimLine cid) [claimLegOf f c2] c2
  c3 <- makeClaim f (\c -> c with confirmer = f.builder)
  refusedClaim "the funded claim names another confirmer than the chain's" f (claimLine cid) [claimLegOf f c3] c3
  c4 <- makeClaim f (\c -> c with gateway = f.v)
  refusedClaim "the funded claim names another gateway than the chain's" f (claimLine cid) [claimLegOf f c4] c4
  -- a claim of one token cannot be redeemed with another registered token of the chain
  other <- makeTokenOf "TKA" f.operator f.confirmer f.gateway f.builder 770101 f.reg (mconcat (replicate 20 "66"))
  c5 <- makeClaim f identity
  refusedClaim "the funded claim is for another token than the leg's" f (claimLine cid) [ClaimLeg with claimCid = c5; tokenCid = other] c5

-- What the claim leg writes is the claim's own: a block that recorded another recipient, amount or id is not this one.
testAClaimLegIsHeldToWhatTheBlockRecorded : Script ()
testAClaimLegIsHeldToWhatTheBlockRecorded = do
  f <- fixture
  claim <- makeClaim f identity
  let cid = venueClaimId (venueTradeId f.u tradeLabel)
  refusedClaim notRecorded f (line "deposit" cid wTkb recipientAddr "9.0" "") [claimLegOf f claim] claim
  refusedClaim notRecorded f (line "deposit" cid wTkb uAddr "10.0" "") [claimLegOf f claim] claim
  refusedClaim notRecorded f (line "deposit" (idOf "99") wTkb recipientAddr "10.0" "") [claimLegOf f claim] claim
  refusedClaim notRecorded f (line "payment" cid wTkb recipientAddr "10.0" "") [claimLegOf f claim] claim

-- The same for the trade's payment line.
testATradeLegIsHeldToWhatTheBlockRecorded : Script ()
testATradeLegIsHeldToWhatTheBlockRecorded = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTrade f venue
  let pid = venueTradeId venue tradeLabel
  refusedAs notRecorded f (asBuilderV f venue) $ advance f.chain "01" [line "payment" pid tokenAddr uAddr fiveTokens ""] [tradeLeg trade]
  refusedAs notRecorded f (asBuilderV f venue) $ advance f.chain "01" [line "payment" (idOf "99") tokenAddr uAddr tenTokens ""] [tradeLeg trade]
  refusedAs notRecorded f (asBuilderV f venue) $ advance f.chain "01" [] [tradeLeg trade]
  Some _ <- queryContractId venue trade
  pure ()

-- A claim is redeemed once, and only with the authority that `Advance` brings.
testAClaimIsRedeemedOnce : Script ()
testAClaimIsRedeemedOnce = do
  f <- fixture
  claim <- makeClaim f identity
  submitMustFail f.builder $ exerciseCmd claim Redeem
  submitMustFail (actAs [f.operator, f.confirmer]) $ exerciseCmd claim Redeem
  submit (actAs [f.operator, f.confirmer, f.gateway]) $ exerciseCmd claim Redeem
  submitMustFail (actAs [f.operator, f.confirmer, f.gateway]) $ exerciseCmd claim Redeem
  pure ()

-- A trade is settled once, and needs the operator, the confirmer and the gateway together, whom `Advance` brings. By design those three
-- can settle it with no EVM payment: they are the chain's root of trust, as for `Lock` and `Settle`.
testATradeIsSettledOnceAndNeedsAllThree : Script ()
testATradeIsSettledOnceAndNeedsAllThree = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTrade f venue
  submitMustFail (actAs f.builder <> readAs [venue, f.u, f.registry] <> disclose f.rules) $ exerciseCmd trade SettleTrade
  submitMustFail (actAs [f.operator, f.confirmer]) $ exerciseCmd trade SettleTrade
  _ <- submit (actAs [f.operator, f.confirmer, f.gateway] <> readAs [venue, f.u, f.registry] <> disclose f.rules) $ exerciseCmd trade SettleTrade
  submitMustFail (actAs [f.operator, f.confirmer, f.gateway] <> readAs [venue, f.u, f.registry] <> disclose f.rules) $ exerciseCmd trade SettleTrade
  holds f.gateway "TKB" >>= \xs -> xs === [10.0]

-- While the legs are paused a trade leg and a claim leg are refused like any other.
testAPausedChainRefusesTradeAndClaimLegs : Script ()
testAPausedChainRefusesTradeAndClaimLegs = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTrade f venue
  claim <- makeClaim f identity
  chain <- submit f.confirmer $ exerciseCmd f.chain PauseLegs
  let pid = venueTradeId venue tradeLabel
  refusedAs paused f (asBuilderV f venue) $ advance chain "01" [tradeLine pid] [tradeLeg trade]
  refusedAs paused f (asBuilderV f venue) $ advance chain "01" [claimLine (venueClaimId (venueTradeId f.u tradeLabel))] [claimLegOf f claim]
  holds f.gateway "TKB" >>= \xs -> xs === []

-- Neither is a withdrawal: a chain whose quota is smaller than the trade does not count it.
testTradeAndClaimLegsAreNotCountedAgainstTheWithdrawalQuota : Script ()
testTradeAndClaimLegsAreNotCountedAgainstTheWithdrawalQuota = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTrade f venue
  chain <- setLimits f f.chain (Some 1.0) (Some (seconds 100)) None
  let pid = venueTradeId venue tradeLabel
  (c1, _) <- submit (asBuilderV f venue) $ advance chain "01" [tradeLine pid] [tradeLeg trade]
  [(claim, _)] <- query @FundedClaim f.gateway
  (c2, _) <- submit (asBuilderV f venue) $ advance c1 "11" [claimLine (venueClaimId pid)] [claimLegOf f claim]
  Some z <- queryContractId f.operator c2
  z.withdrawn === Some []

-- A trade that names another chain's token (here a token registered for chain 2) is refused before anything is settled: the claim it
-- would make could never be redeemed, as the claim leg needs a token of this chain.
testATradeNamingAnotherChainsTokenIsRefused : Script ()
testATradeNamingAnotherChainsTokenIsRefused = do
  f <- fixture
  venue <- makeVenue
  t2 <- makeToken f.operator f.confirmer f.gateway f.builder 2 f.reg wTkb
  t1 <- makeTradeOf f venue venue f.gateway "TKB" (\t -> t with gatewayToken = t2)
  refusedTrade "the token is for another chain" f venue t1
  t3 <- makeTokenOf "TKB" f.operator f.confirmer f.v f.builder 770101 f.reg wTkb
  t4 <- makeTradeOf f venue venue f.gateway "TKB" (\t -> t with gatewayToken = t3)
  refusedTrade "the token names another gateway than the chain's" f venue t4

-- The seller's allocation belongs to the seller and the registry, and the venue is its executor: the builder, reading only as the chain's
-- parties, sees it only because the submission discloses it (`allocationDisclosed` is how the venue hands it over).
testATradeSettlesWhenItsAllocationReachesTheBuilderOnlyByDisclosure : Script ()
testATradeSettlesWhenItsAllocationReachesTheBuilderOnlyByDisclosure = do
  f <- fixture
  venue <- makeVenue
  trade <- makeTrade f venue
  Some t <- queryContractId venue trade
  Some d <- queryDisclosure venue (fromInterfaceContractId @TokenAllocation t.allocation)
  let pid = venueTradeId venue tradeLabel
  let chainParties = actAs f.builder <> readAs [f.operator, f.confirmer, f.gateway]
  submitMustFail chainParties $ advance f.chain "01" [tradeLine pid] [tradeLeg trade]
  holds f.gateway "TKB" >>= \xs -> xs === []
  (_, _) <- submit (chainParties <> disclose d) $ advance f.chain "01" [tradeLine pid] [tradeLeg trade]
  holds f.gateway "TKB" >>= \xs -> xs === [10.0]
  [(_, c)] <- query @FundedClaim f.gateway
  (c.claimId, c.recipient, c.amount) === (venueClaimId pid, recipientAddr, 10.0)

-- The registry of EVM contracts (daml 0.5.0): `ZkChain.contracts`, `ProposeContract` / `AcceptContract`, and `Advance`'s `extraGateways`.

gw2Addr, gw3Addr, vaultAddr, codeHash2, codeHash3 : Text
gw2Addr = mconcat (replicate 20 "b8")
gw3Addr = mconcat (replicate 20 "b9")
vaultAddr = mconcat (replicate 20 "c9")
codeHash2 = mconcat (replicate 32 "d4")
codeHash3 = mconcat (replicate 32 "e5")

gatewayEntry, gateway3Entry, vaultEntry : RegisteredContract
gatewayEntry = RegisteredContract with contractAddress = gw2Addr; contractCodeHash = codeHash2; contractKind = Gateway
gateway3Entry = RegisteredContract with contractAddress = gw3Addr; contractCodeHash = codeHash3; contractKind = Gateway
vaultEntry = RegisteredContract with contractAddress = vaultAddr; contractCodeHash = codeHash3; contractKind = Vault

-- The operator and the gateway propose the entry and the confirmer accepts it on `chain`.
register : F -> ContractId ZkChain -> RegisteredContract -> Script (ContractId ZkChain)
register f chain entry = do
  p <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd chain ProposeContract with entry
  submit f.confirmer $ exerciseCmd p AcceptContract with chain

-- What the builder gives for a registered gateway. The stub takes the account proof as a tag (whole bytes) and the storage proof as the lines the
-- block recorded; the account proof's last node ends in the code hash, as the leaf of an account does.
gwBlock : Text -> Text -> [Text] -> [Leg] -> GatewayBlock
gwBlock addr hash recorded legs = GatewayBlock with
  address = addr; accountNodes = ["aabb", "ccdd" <> hash]; storageNodes = recordedNodes recorded; legs

-- A block of the first gateway's `recorded` and `legs`, with these entries for the registered gateways.
advanceX : ContractId ZkChain -> Text -> [Text] -> [Leg] -> [GatewayBlock] -> Commands (ContractId ZkChain, ContractId BlockRecord)
advanceX chain header recorded legs extras = exerciseCmd chain Advance with
  headerHex = header; txsHex = ""; proofHex = "aa"; gatewayAccountNodes = ["aa"]; gatewayStorageNodes = recordedNodes recorded
  legs; extraGateways = Some extras

registryOf : F -> ContractId ZkChain -> Script (Optional [RegisteredContract])
registryOf f chain = do
  Some c <- queryContractId f.operator chain
  pure c.contracts

-- A new chain has no registry, and a block with no extra gateway commits on it, as under 0.4.0.
testANewChainHasNoRegistry : Script ()
testANewChainHasNoRegistry = do
  f <- fixture
  registryOf f f.chain >>= \r -> r === None
  (next, _) <- submit (asBuilder f) $ advance f.chain "01" [] []
  registryOf f next >>= \r -> r === None
  (_, _) <- submit (asBuilder f) $ advanceX next "11" [] [] []
  pure ()

-- The entries are kept in the order they were accepted, and a block keeps them.
testAContractIsRegisteredByProposalAndAcceptance : Script ()
testAContractIsRegisteredByProposalAndAcceptance = do
  f <- fixture
  c1 <- register f f.chain gatewayEntry
  c2 <- register f c1 vaultEntry
  registryOf f c2 >>= \r -> r === Some [gatewayEntry, vaultEntry]
  (c3, _) <- submit (asBuilder f) $ advanceX c2 "01" [] [] [gwBlock gw2Addr codeHash2 [] []]
  registryOf f c3 >>= \r -> r === Some [gatewayEntry, vaultEntry]

-- Only the operator and the gateway propose, only the confirmer accepts, and it waits out the chain's change delay.
testAContractWaitsOutTheDelayAndTheRightParties : Script ()
testAContractWaitsOutTheDelayAndTheRightParties = do
  f <- fixture
  chain <- setDelay f f.chain (Some (seconds 100))
  submitMustFail f.operator $ exerciseCmd chain ProposeContract with entry = gatewayEntry
  submitMustFail f.confirmer $ exerciseCmd chain ProposeContract with entry = gatewayEntry
  submitMustFail f.gateway $ exerciseCmd chain ProposeContract with entry = gatewayEntry
  p <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd chain ProposeContract with entry = gatewayEntry
  submitMustFail f.operator $ exerciseCmd p AcceptContract with chain
  mustWait f.confirmer $ exerciseCmd p AcceptContract with chain
  passTime (seconds 99)
  mustWait f.confirmer $ exerciseCmd p AcceptContract with chain
  passTime (seconds 1)
  next <- submit f.confirmer $ exerciseCmd p AcceptContract with chain
  registryOf f next >>= \r -> r === Some [gatewayEntry]

-- A proposal can be taken back by the operator or turned down by the confirmer, and then cannot be accepted.
testAContractProposalIsWithdrawnOrRejected : Script ()
testAContractProposalIsWithdrawnOrRejected = do
  f <- fixture
  let propose = submit (actAs [f.operator, f.gateway]) $ exerciseCmd f.chain ProposeContract with entry = gatewayEntry
  p1 <- propose
  submit f.operator $ exerciseCmd p1 WithdrawContract
  submitMustFail f.confirmer $ exerciseCmd p1 AcceptContract with chain = f.chain
  p2 <- propose
  submitMustFail f.operator $ exerciseCmd p2 RejectContract
  submit f.confirmer $ exerciseCmd p2 RejectContract
  submitMustFail f.confirmer $ exerciseCmd p2 AcceptContract with chain = f.chain
  registryOf f f.chain >>= \r -> r === None

-- An entry has a 40-digit address and a 64-digit code hash, in lowercase hex; none is registered twice, and none is the first gateway.
testAContractEntryIsChecked : Script ()
testAContractEntryIsChecked = do
  f <- fixture
  let propose e = submitMustFail (actAs [f.operator, f.gateway]) $ exerciseCmd f.chain ProposeContract with entry = e
  propose (gatewayEntry with contractAddress = "b8")
  propose (gatewayEntry with contractAddress = mconcat (replicate 20 "B8"))
  propose (gatewayEntry with contractCodeHash = "d4")
  propose (gatewayEntry with contractCodeHash = mconcat (replicate 32 "D4"))
  -- The first gateway's address passes the proposal's own check, and the chain refuses it on acceptance.
  p <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd f.chain ProposeContract with entry = (gatewayEntry with contractAddress = gatewayAddr)
  r <- trySubmit f.confirmer $ exerciseCmd p AcceptContract with chain = f.chain
  case r of
    Left e -> assertMsg ("refused, but not as the first gateway: " <> show e) ("first gateway" `T.isInfixOf` show e)
    Right _ -> abort "the first gateway was registered"
  c1 <- register f f.chain gatewayEntry
  p2 <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd c1 ProposeContract with entry = (vaultEntry with contractAddress = gw2Addr)
  r2 <- trySubmit f.confirmer $ exerciseCmd p2 AcceptContract with chain = c1
  case r2 of
    Left e -> assertMsg ("refused, but not as a second entry: " <> show e) ("registered already" `T.isInfixOf` show e)
    Right _ -> abort "an address was registered twice"

-- Advance takes one entry for each registered gateway: its legs are read from its own proofs, and settled.
testAnExtraGatewaysLegsAreSettled : Script ()
testAnExtraGatewaysLegsAreSettled = do
  f <- fixture
  c1 <- register f f.chain gatewayEntry
  (_, record) <- submit (asBuilder f) $ advanceX c1 "01" [] [] [gwBlock gw2Addr codeHash2 [paymentLine f.dvp1] [paymentLeg f]]
  Some r <- queryContractId f.reader record
  r.number === 1
  -- The payment was settled: V holds the 10 TKB and the terms are consumed.
  holds f.v "TKB" >>= \xs -> xs === [10.0]
  None <- queryContractId f.u f.terms
  pure ()

-- The legs of the first and of a registered gateway are read apart: each is the one its own gateway recorded.
testTheLegsOfEachGatewayAreItsOwn : Script ()
testTheLegsOfEachGatewayAreItsOwn = do
  f <- fixture
  c1 <- register f f.chain gatewayEntry
  let why = "are not the ones the block recorded"
  -- The payment is attached to the registered gateway but only the first recorded it.
  refused notRecorded f $ advanceX c1 "01" [paymentLine f.dvp1] [] [gwBlock gw2Addr codeHash2 [] [paymentLeg f]]
  -- ... and the other way round.
  refused why f $ advanceX c1 "01" [] [] [gwBlock gw2Addr codeHash2 [paymentLine f.dvp1] []]
  refused why f $ advanceX c1 "01" [] [] [gwBlock gw2Addr codeHash2 [] [paymentLeg f]]

-- A block with no entry for a registered gateway is refused, and so is one with an entry that is not registered, a vault's, or a second one.
testEveryRegisteredGatewayIsInEveryBlock : Script ()
testEveryRegisteredGatewayIsInEveryBlock = do
  f <- fixture
  c1 <- register f f.chain gatewayEntry
  c2 <- register f c1 gateway3Entry
  c3 <- register f c2 vaultEntry
  let noEntry = "the block carries no entry for the registered gateway"
  refusedAs noEntry f (asBuilder f) $ advance c3 "01" [] []
  refused noEntry f $ advanceX c3 "01" [] [] []
  refused noEntry f $ advanceX c3 "01" [] [] [gwBlock gw2Addr codeHash2 [] []]
  refused noEntry f $ advanceX c3 "01" [] [] [gwBlock gw3Addr codeHash3 [] []]
  refused "is not in the chain's registry" f $ advanceX c3 "01" [] [] [gwBlock gw2Addr codeHash2 [] [], gwBlock gw3Addr codeHash3 [] [], gwBlock vaultAddr codeHash3 [] []]
  refused "is not in the chain's registry" f $ advanceX c3 "01" [] [] [gwBlock gw2Addr codeHash2 [] [], gwBlock gw3Addr codeHash3 [] [], gwBlock gatewayAddr codeHash3 [] []]
  refused "more than one entry" f $ advanceX c3 "01" [] [] [gwBlock gw2Addr codeHash2 [] [], gwBlock gw3Addr codeHash3 [] [], gwBlock gw2Addr codeHash2 [] []]
  -- Both, in either order; the vault needs no entry.
  (_, _) <- submit (asBuilder f) $ advanceX c3 "01" [] [] [gwBlock gw3Addr codeHash3 [] [], gwBlock gw2Addr codeHash2 [] []]
  pure ()

-- A chain whose registry holds a vault only needs no extra entry.
testAVaultNeedsNoEntry : Script ()
testAVaultNeedsNoEntry = do
  f <- fixture
  c1 <- register f f.chain vaultEntry
  (_, _) <- submit (asBuilder f) $ advance c1 "01" [] []
  pure ()

-- The account proof of a registered gateway must end in the registered code hash.
testTheAccountMustHaveTheRegisteredCode : Script ()
testTheAccountMustHaveTheRegisteredCode = do
  f <- fixture
  c1 <- register f f.chain gatewayEntry
  let why = "does not end in an account of the registered code hash"
  refused why f $ advanceX c1 "01" [] [] [gwBlock gw2Addr codeHash3 [] []]
  refused why f $ advanceX c1 "01" [] [] [(gwBlock gw2Addr codeHash2 [] []) with accountNodes = []]
  -- The code hash must close the last node, not sit in an earlier one.
  refused why f $ advanceX c1 "01" [] [] [(gwBlock gw2Addr codeHash2 [] []) with accountNodes = ["ccdd" <> codeHash2, "aabb"]]
  refused why f $ advanceX c1 "01" [] [] [(gwBlock gw2Addr codeHash2 [] []) with accountNodes = ["ccdd" <> codeHash2 <> "00"]]
  (_, _) <- submit (asBuilder f) $ advanceX c1 "01" [] [] [(gwBlock gw2Addr codeHash2 [] []) with accountNodes = ["ccdd" <> codeHash2]]
  pure ()

-- The sidecar's refusal of a registered gateway's proofs refuses the block.
testARegisteredGatewaysProofsAreChecked : Script ()
testARegisteredGatewaysProofsAreChecked = do
  f <- fixture
  c1 <- register f f.chain gatewayEntry
  refused "the account proof does not verify" f $ advanceX c1 "01" [] [] [(gwBlock gw2Addr codeHash2 [] []) with accountNodes = ["ba", "ccdd" <> codeHash2]]
  refused "the storage proof does not verify" f $ advanceX c1 "01" [] [] [(gwBlock gw2Addr codeHash2 [] []) with storageNodes = ["ba"]]

-- The pause holds the legs of a registered gateway too, and the others' blocks with none still go on.
testThePauseHoldsAnExtraGatewaysLegs : Script ()
testThePauseHoldsAnExtraGatewaysLegs = do
  f <- fixture
  c1 <- register f f.chain gatewayEntry
  paused <- submit f.confirmer $ exerciseCmd c1 PauseLegs
  refused "a block that carries a leg is refused" f $ advanceX paused "01" [] [] [gwBlock gw2Addr codeHash2 [paymentLine f.dvp1] [paymentLeg f]]
  (_, _) <- submit (asBuilder f) $ advanceX paused "01" [] [] [gwBlock gw2Addr codeHash2 [] []]
  pure ()

-- The withdrawals of a registered gateway count against the chain's withdrawal quota, with the first gateway's.
testTheQuotaCountsAnExtraGatewaysWithdrawals : Script ()
testTheQuotaCountsAnExtraGatewaysWithdrawals = do
  f <- fixture
  h1 <- custody f
  h2 <- custody f
  chain <- quota5 f
  c1 <- register f chain gatewayEntry
  -- 6.0 by the registered gateway alone is over the quota of 5.0
  refused "over the withdrawal quota" f $ advanceX c1 "01" [] [] [gwBlock gw2Addr codeHash2 [wLine wTkb 6.0 f.u] [withdrawalOf f f.token h1 6.0]]
  -- 3.0 by the first gateway and 3.0 by the registered one are added up
  refused "over the withdrawal quota" f $ advanceX c1 "01" [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h1 3.0] [gwBlock gw2Addr codeHash2 [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h2 3.0]]
  -- 3.0 and 2.0 commit, and the tally is 5.0
  (c2, _) <- submit (asBuilder f) $ advanceX c1 "01" [wLine wTkb 3.0 f.u] [withdrawalOf f f.token h1 3.0] [gwBlock gw2Addr codeHash2 [wLine wTkb 2.0 f.u] [withdrawalOf f f.token h2 2.0]]
  Some c <- queryContractId f.operator c2
  Some [t] <- pure c.withdrawn
  t.tallyAmount === 5.0

-- The registry holds 16 entries and refuses a 17th.
testTheRegistryHoldsSixteenEntries : Script ()
testTheRegistryHoldsSixteenEntries = do
  f <- fixture
  let entry d = RegisteredContract with contractAddress = mconcat (replicate 20 ("f" <> d)); contractCodeHash = codeHash3; contractKind = Vault
  let go c [] = pure c
      go c (d :: ds) = register f c (entry d) >>= \c' -> go c' ds
  c16 <- go f.chain (T.explode "0123456789abcdef")
  Some r <- registryOf f c16
  length r === 16
  p <- submit (actAs [f.operator, f.gateway]) $ exerciseCmd c16 ProposeContract with entry = gatewayEntry
  r17 <- trySubmit f.confirmer $ exerciseCmd p AcceptContract with chain = c16
  case r17 of
    Left e -> assertMsg ("refused, but not as the 17th: " <> show e) ("at most 16" `T.isInfixOf` show e)
    Right _ -> abort "a 17th entry was registered"

-- A registered gateway's answer must repeat the block's root and number, its own address and the count of its legs.
testARegisteredGatewaysAnswerIsChecked : Script ()
testARegisteredGatewaysAnswerIsChecked = do
  f <- fixture
  c1 <- register f f.chain gatewayEntry
  forA_ ["e1", "e2", "e3", "e4"] $ \tag ->
    refused "are not the ones the block recorded: ok" f $ advanceX c1 "01" [] [] [(gwBlock gw2Addr codeHash2 [] []) with accountNodes = [tag, "ccdd" <> codeHash2]]
