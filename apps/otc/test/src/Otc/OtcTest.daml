-- Daml Script tests for the OTC app. The token is the Splice reference token, driven through the standard's own factory, as a
-- CIP-0056 wallet drives it.
module Otc.OtcTest where

import DA.Assert ((===))
import qualified DA.TextMap as TM
import DA.Time (addRelTime, days, hours)
import Daml.Script

import Splice.Api.Token.MetadataV1
import qualified Splice.Api.Token.HoldingV1 as H
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1
import Splice.Api.Token.AllocationRequestV1
import Splice.Testing.Tokens.TestTokenV1 (Token(..), TokenRules(..))

import Otc.Otc

tokenAddr, sellerAddr, buyerAddr : Text
tokenAddr = mconcat (replicate 20 "11")
sellerAddr = mconcat (replicate 20 "22")
buyerAddr = mconcat (replicate 20 "44")

-- 100 tokens of 6 decimals, as 64 hex digits.
hundred : Text
hundred = mconcat (replicate 28 "00") <> "05f5e100"

noExtraArgs : ExtraArgs
noExtraArgs = ExtraArgs (ChoiceContext mempty) emptyMetadata

data F = F with
  seller, venue, gateway, buyer, registry : Party
  instrument : H.InstrumentId
  rulesCid : ContractId TokenRules
  rules : Disclosure

setup : Script F
setup = do
  [seller, venue, gateway, buyer, registry] <- mapA allocateParty ["Seller", "Venue", "Gateway", "Buyer", "Registry"]
  rulesCid <- submit registry $ createCmd TokenRules with admin = registry
  Some rules <- queryDisclosure registry rulesCid
  let instrument = H.InstrumentId with admin = registry; id = "TKB"
  pure F with ..

offerOf : F -> TradeOffer
offerOf f = TradeOffer with
  seller = f.seller; venue = f.venue; gateway = f.gateway; instrument = f.instrument; amount = 10.0
  token = tokenAddr; amountBase = hundred; payee = sellerAddr; recipient = buyerAddr; label = "otc-1"
  allocateWithin = hours 2; settleWithin = days 1

-- The seller offers, the venue accepts.
accepted : F -> Script (ContractId Trade)
accepted f = do
  offer <- submit f.seller $ createCmd (offerOf f)
  submit f.venue $ exerciseCmd offer Accept

-- The seller allocates the trade's amount, through the token's own factory, with the spec the request names.
allocateFor : F -> ContractId Trade -> Script (ContractId Allocation)
allocateFor f trade = do
  Some v <- queryInterfaceContractId @AllocationRequest f.seller (toInterfaceContractId trade)
  let Some leg = TM.lookup legId v.transferLegs
  now <- getTime
  holding <- submit (actAs [f.seller, f.registry]) $ createCmd Token with
    holding = H.HoldingView with owner = f.seller; instrumentId = f.instrument; amount = leg.amount; lock = None; meta = emptyMetadata
  let spec = AllocationSpecification with settlement = v.settlement; transferLegId = legId; transferLeg = leg
  r <- submit (actAs f.seller <> disclose f.rules) $ exerciseCmd (toInterfaceContractId @AllocationFactory f.rulesCid) AllocationFactory_Allocate with
    expectedAdmin = f.registry; allocation = spec; requestedAt = now
    inputHoldingCids = [toInterfaceContractId @H.Holding holding]; extraArgs = noExtraArgs
  case r.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "the reference token completes an allocation at once"

-- The venue accepting an offer makes a trade with the offer's terms, signed by the venue and the seller, and the offer is gone.
testAccept : Script ()
testAccept = do
  f <- setup
  offer <- submit f.seller $ createCmd (offerOf f)
  Some o <- queryContractId f.venue offer
  o.label === "otc-1"
  trade <- submit f.venue $ exerciseCmd offer Accept
  gone <- queryContractId f.venue offer
  gone === None
  Some t <- queryContractId f.seller trade
  t.seller === f.seller
  t.venue === f.venue
  t.gateway === f.gateway
  t.amount === 10.0
  t.amountBase === hundred
  t.payee === sellerAddr
  t.recipient === buyerAddr
  t.label === "otc-1"
  t.allocateBefore === addRelTime t.requestedAt (hours 2)
  t.settleBefore === addRelTime t.requestedAt (days 1)
  -- the buyer's party is no stakeholder: it sees neither the offer nor the trade
  b <- queryContractId f.buyer trade
  b === None

-- An offer with a malformed EVM side, no amount, no label or a settlement window shorter than the allocation window is refused.
testOfferRefused : Script ()
testOfferRefused = do
  f <- setup
  let o = offerOf f
  let refused x = submitMustFail f.seller $ createCmd x
  refused o with token = "11"
  refused o with payee = mconcat (replicate 20 "2G")
  refused o with recipient = mconcat (replicate 20 "AA")
  refused o with amountBase = mconcat (replicate 32 "00")
  refused o with amountBase = "05f5e100"
  refused o with amount = 0.0
  refused o with label = ""
  refused o with allocateWithin = days 2
  _ <- submit f.seller $ createCmd o
  pure ()

-- Only the venue accepts an offer; the seller can take it back and the venue can decline it.
testOfferChoices : Script ()
testOfferChoices = do
  f <- setup
  offer <- submit f.seller $ createCmd (offerOf f)
  submitMustFail f.seller $ exerciseCmd offer Accept
  submit f.seller $ exerciseCmd offer Withdraw
  offer2 <- submit f.seller $ createCmd (offerOf f)
  submit f.venue $ exerciseCmd offer2 Decline
  gone <- queryContractId f.seller offer2
  gone === None

-- A CIP-0056 wallet sees the trade as an allocation request: the venue executes, the label is the settlement's reference,
-- and the one leg is the seller's amount to the chain's gateway.
testAllocationRequestView : Script ()
testAllocationRequestView = do
  f <- setup
  trade <- accepted f
  Some v <- queryInterfaceContractId @AllocationRequest f.seller (toInterfaceContractId trade)
  v.settlement.executor === f.venue
  v.settlement.settlementRef === Reference with id = "otc-1"; cid = None
  TM.toList v.transferLegs === [(legId, TransferLeg with sender = f.seller; receiver = f.gateway; amount = 10.0; instrumentId = f.instrument; meta = emptyMetadata)]
  -- the venue sees the same view
  Some w <- queryInterfaceContractId @AllocationRequest f.venue (toInterfaceContractId trade)
  w === v

-- The seller allocates through the token's own factory with the trade's spec; the allocation is the seller's amount to the
-- gateway with the venue as executor and the label as reference, and the venue, the seller and the gateway can execute it.
testSellerAllocates : Script ()
testSellerAllocates = do
  f <- setup
  trade <- accepted f
  allocation <- allocateFor f trade
  Some a <- queryInterfaceContractId @Allocation f.seller allocation
  a.allocation.settlement.executor === f.venue
  a.allocation.settlement.settlementRef.id === "otc-1"
  a.allocation.transferLegId === legId
  a.allocation.transferLeg.sender === f.seller
  a.allocation.transferLeg.receiver === f.gateway
  a.allocation.transferLeg.amount === 10.0
  a.allocation.transferLeg.instrumentId === f.instrument
  -- the executor, the sender and the receiver together execute it, as a chain's settlement does
  _ <- submit (actAs [f.venue, f.seller, f.gateway] <> disclose f.rules) $ exerciseCmd allocation Allocation_ExecuteTransfer with extraArgs = noExtraArgs
  pure ()

-- The venue archives a trade; the seller cannot.
testVenueCloses : Script ()
testVenueCloses = do
  f <- setup
  trade <- accepted f
  submitMustFail f.seller $ exerciseCmd trade Close
  submit f.venue $ exerciseCmd trade Close
  gone <- queryContractId f.venue trade
  gone === None

-- The seller or the venue rejects the request and the trade ends; a bystander cannot; the venue (its executor) withdraws it.
testRejectAndWithdraw : Script ()
testRejectAndWithdraw = do
  f <- setup
  let req t = toInterfaceContractId @AllocationRequest t
  t1 <- accepted f
  _ <- submit f.seller $ exerciseCmd (req t1) AllocationRequest_Reject with actor = f.seller; extraArgs = noExtraArgs
  g1 <- queryContractId f.venue t1
  g1 === None
  t2 <- accepted f
  submitMustFail f.buyer $ exerciseCmd (req t2) AllocationRequest_Reject with actor = f.buyer; extraArgs = noExtraArgs
  _ <- submit f.venue $ exerciseCmd (req t2) AllocationRequest_Withdraw with extraArgs = noExtraArgs
  g2 <- queryContractId f.venue t2
  g2 === None
