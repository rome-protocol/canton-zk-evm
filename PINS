# Canton with the external call, and the Daml compiler that can call it. Both are released: open-source Canton 3.6.2
# (GitHub release digital-asset/canton v3.6.2, 2026-10-15) and the Daml SDK 3.6.0 (2026-10-08), whose compiler is damlc 3.6.2,
# from Digital Asset's public registry. DPM_REGISTRY is where the SDK and the compiler are; dpm 1.0.22 is the released one.
# network/canton/fetch.sh checks every SHA-256 below. The Canton jar comes from the release tarball (one file for every
# platform) and is checked by the tarball's SHA-256 and by its own. The SDK manifest lists the exact version of each
# component; its own Canton (3.6.1) is not the one that runs: the network runs the 3.6.2 jar.
DPM_REGISTRY=europe-docker.pkg.dev/da-images/public
DPM_VERSION=1.0.22
DPM_LINUX_AMD64_SHA256=116c47306d504e7f18bd0b7c7908b6e30c1c6b88ffde9f380507136a58400714
DAML_SDK_TAG=3.6.0
DAML_SDK_VERSION=3.6.0
DAML_SDK_MANIFEST_SHA256=2965eefccc955dca6c52f86c87e7c5606a2a33952c290b01e50193924144e264
DAMLC_VERSION=3.6.2
# SHA-256 of the registry's manifest for that damlc (Linux x86-64): it lists every file of the compiler by digest, so a
# tag that was pushed again with other contents is refused (network/canton/check-damlc.sh).
DAMLC_LINUX_AMD64_MANIFEST_SHA256=87bfc536992de2a79a229cbf432e0de688964f4dfe3170e406b5cd6f39edcedb
CANTON_VERSION=3.6.2
